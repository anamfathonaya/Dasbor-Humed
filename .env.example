# ==============================================================================
# DASBOR MEDIA - ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# File ini digunakan oleh Next.js BFF (Backend-For-Frontend) di sisi server Node.js.
# JANGAN PERNAH mengekspos token rahasia ini ke sisi client (browser).
# ==============================================================================

# 1. META (GRAPH API & ADS INSIGHTS)
# Dapatkan di: https://developers.facebook.com/apps/
# Izin yang dibutuhkan: ads_read, read_insights, pages_show_list, pages_read_engagement
META_PAGE_ID=pedulinegeri_id
META_AD_ACCOUNT_ID=act_1234567890
META_ACCESS_TOKEN=your_long_lived_system_user_access_token_here

# 2. X API v2 (TWITTER)
# Dapatkan di: https://developer.x.com/en/portal/dashboard
# Izin: Read-only (User & Tweet public metrics)
X_USERNAME=pedulinegeri
X_BEARER_TOKEN=your_x_api_v2_bearer_token_here

# 3. TIKTOK API (DISPLAY / RESEARCH API)
# Dapatkan di: https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=your_tiktok_client_key_here
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret_here
TIKTOK_ACCESS_TOKEN=your_tiktok_user_access_token_here

# 4. GOOGLE SSO (OAUTH 2.0) & GOOGLE AI PRO (GEMINI PRO)
# Gunakan Google SSO untuk Akun Google Pribadi/Pro (Langganan Google AI Pro - Tanpa Lisensi Enterprise):
# Dapatkan OAuth Client di Google Cloud Console -> Credentials -> OAuth 2.0 Client IDs (Web application)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
# API Key Gemini Pro dari Google AI Studio (terhubung ke paket Google AI Pro):
GEMINI_API_KEY=your_gemini_pro_api_key_here
GOOGLE_ACCOUNT_EMAIL=humas.pedulinegeri@gmail.com

# 5. WHATSAPP BUSINESS CLOUD API
# Dapatkan di: Meta Business Manager -> WhatsApp Accounts -> API Setup
# Endpoint: https://graph.facebook.com/v19.0/{PHONE_NUMBER_ID}/messages
WHATSAPP_PHONE_NUMBER_ID=109283746592837
WHATSAPP_ACCESS_TOKEN=your_whatsapp_cloud_api_token_here

# 6. TELEGRAM BOT API & CHANNEL MONITORING
# Dapatkan token bot via: @BotFather di Telegram
# Dapatkan channel handle publik atau ID grup/kanal
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRstuVWXyz123456789
TELEGRAM_CHANNEL_HANDLE=siagabencana_humas

# 7. DIGITAL ASSET MANAGEMENT (DAM) SYNOLOGY NAS SERVER LOKAL
DAM_NAS_HOST=192.168.1.200
DAM_NAS_SHARE_PATH=smb://192.168.1.200/dam-humas/arsip-media
DAM_NAS_USER=dam-agent-srv
DAM_NAS_PASSWORD=your_nas_service_account_password_here

# 8. SISTEM APLIKASI
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# 9. SUPABASE (POSTGRESQL, AUTH, STORAGE)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres
