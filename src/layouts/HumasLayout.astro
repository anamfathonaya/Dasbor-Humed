---
import '../styles/humas-theme.css';
import { getUserRole, type UserRole } from '../lib/auth';
import { db, initDatabase } from '../lib/db';

interface Props {
  title?: string;
  pageTitle?: string;
  pageSubtitle?: string;
  currentPath?: string;
  pageContentId?: string;
  activeRole?: UserRole;
}

const {
  title = 'Dasbor Humas Media — Yayasan Peduli Negeri',
  pageTitle = 'Dasbor & Metrik',
  pageSubtitle = 'Ringkasan operasional humas, akuisisi, dan analitik performa kanal',
  currentPath = Astro.url.pathname,
  pageContentId = 'dasbor-utama',
  activeRole: propRole,
} = Astro.props;

initDatabase();
const currentRole = propRole || (Astro.locals as any)?.userRole || getUserRole(Astro.request, Astro.url);

const roleNames: Record<UserRole, string> = {
  head: 'Kepala Humas',
  admin: 'Admin Teknis',
  staff: 'Staf Konten'
};

const defaultUsers: Record<UserRole, { name: string; initials: string }> = {
  head: { name: 'Rani Maulida', initials: 'RM' },
  admin: { name: 'Budi Santoso', initials: 'BS' },
  staff: { name: 'Dewi Lestari', initials: 'DL' }
};

// Ambil profil langsung dari SQLite
let dbUser: { name: string; avatar_url?: string | null } | undefined;
try {
  dbUser = db.prepare(`
    SELECT u.name, u.avatar_url
    FROM users u
    JOIN roles r ON u.role_id = r.id
    WHERE r.name = ?
    LIMIT 1
  `).get(currentRole) as { name: string; avatar_url?: string | null } | undefined;
} catch {}

const defaultUser = defaultUsers[currentRole] || { name: 'Rani Salsabila', initials: 'RS' };
const userName = dbUser?.name || defaultUser.name;
const initials = userName
  .split(' ')
  .filter(Boolean)
  .slice(0, 2)
  .map(w => w[0].toUpperCase())
  .join('') || defaultUser.initials;

const currentUser = {
  name: userName,
  initials: initials,
  avatarUrl: dbUser?.avatar_url || null
};

const isPathActive = (target: string) => {
  if (target === '/dasbor') {
    return currentPath === '/' || currentPath === '/dasbor' || currentPath.startsWith('/dasbor-metrik');
  }
  if (target === '/laporan') {
    return currentPath.startsWith('/laporan') || currentPath.startsWith('/daftar-rab-lra') || currentPath.startsWith('/bagikan-cetak');
  }
  if (target === '/akun') {
    return currentPath.startsWith('/akun') || currentPath.startsWith('/manajemen-akun') || currentPath.startsWith('/profil-akun');
  }
  return currentPath.startsWith(target);
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" />
    <script crossorigin="anonymous" data-iconify-runtime defer integrity="sha384-Hj2pe/JEGitdWiVWNPuXWhAdYtdM+ZO+s0KuZHaAk1oAbeAtNas7R6hKlmbInTM4" src="https://code.iconify.design/iconify-icon/3.0.0/iconify-icon.min.js"></script>
  </head>
  <body>
    <div data-layout-system="humas-shell">
      <div class="l-humas" data-layout="humas-shell" data-theme="light" data-nav="closed" id="humas-shell-root">
        <a class="l-humas__skip" href="#humas-main">Lewati ke konten utama</a>

        <div class="l-humas__frame">
          <!-- Sidebar Navigasi Utama -->
          <aside class="l-humas__sidebar" id="humas-sidebar" aria-label="Navigasi utama">
            <div class="l-humas__brand">
              <span class="l-humas__brand-mark" aria-hidden="true">HM</span>
              <div class="l-humas__brand-text">
                <p class="l-humas__brand-title">Humas Internal</p>
                <p class="l-humas__brand-sub">Ruang kerja komunikasi</p>
              </div>
            </div>

            <nav class="l-humas__nav" aria-label="Modul humas">
              <div class="l-humas__group">
                <p class="l-humas__group-title l-humas__group-title-inline">Ringkasan Harian</p>
                <a class="l-humas__link" href="/dasbor" aria-current={isPathActive('/dasbor') ? 'page' : undefined}>
                  <iconify-icon icon="lucide:layout-dashboard" aria-hidden="true"></iconify-icon>
                  <span>Dasbor & Metrik</span>
                </a>
                <a class="l-humas__link" href="/pemantauan-kanal" aria-current={isPathActive('/pemantauan-kanal') ? 'page' : undefined}>
                  <iconify-icon icon="lucide:radio" aria-hidden="true"></iconify-icon>
                  <span>Pemantauan Kanal</span>
                </a>
              </div>

              <div class="l-humas__group">
                <p class="l-humas__group-title l-humas__group-title-inline">Produksi Konten</p>
                <p class="l-humas__group-hint">Dari permintaan bidang sampai siap terbit.</p>
                <a class="l-humas__link" href="/papan-proyek" aria-current={isPathActive('/papan-proyek') ? 'page' : undefined}>
                  <iconify-icon icon="lucide:kanban-square" aria-hidden="true"></iconify-icon>
                  <span>Papan Proyek</span>
                  <span class="l-humas__link-count">12</span>
                </a>
                <a class="l-humas__link" href="/kalender-konten" aria-current={isPathActive('/kalender-konten') ? 'page' : undefined}>
                  <iconify-icon icon="lucide:calendar-days" aria-hidden="true"></iconify-icon>
                  <span>Kalender Konten</span>
                </a>
                <a class="l-humas__link" href="/insight-konten" aria-current={isPathActive('/insight-konten') ? 'page' : undefined}>
                  <iconify-icon icon="lucide:trending-up" aria-hidden="true"></iconify-icon>
                  <span>Insight Konten</span>
                </a>
              </div>

              <div class="l-humas__group">
                <p class="l-humas__group-title l-humas__group-title-inline">Pemantauan & Laporan</p>
                <a class="l-humas__link" href="/pantauan-berita" aria-current={isPathActive('/pantauan-berita') ? 'page' : undefined}>
                  <iconify-icon icon="lucide:rss" aria-hidden="true"></iconify-icon>
                  <span>Pantauan Berita</span>
                  <span class="l-humas__link-count">5</span>
                </a>
                <a class="l-humas__link" href="/laporan" aria-current={isPathActive('/laporan') ? 'page' : undefined}>
                  <iconify-icon icon="lucide:file-text" aria-hidden="true"></iconify-icon>
                  <span>Laporan</span>
                </a>
              </div>

              <div class="l-humas__group">
                <p class="l-humas__group-title l-humas__group-title-inline">Rujukan Kerja</p>
                <a class="l-humas__link" href="/basis-pengetahuan" aria-current={isPathActive('/basis-pengetahuan') ? 'page' : undefined}>
                  <iconify-icon icon="lucide:library" aria-hidden="true"></iconify-icon>
                  <span>Basis Pengetahuan</span>
                </a>
                <a class="l-humas__link" href="/sop" aria-current={isPathActive('/sop') ? 'page' : undefined}>
                  <iconify-icon icon="lucide:workflow" aria-hidden="true"></iconify-icon>
                  <span>SOP</span>
                </a>
              </div>

              <div class="l-humas__group">
                <p class="l-humas__group-title l-humas__group-title-inline">Pengaturan</p>
                <a class="l-humas__link" href="/pengaturan" aria-current={isPathActive('/pengaturan') ? 'page' : undefined}>
                  <iconify-icon icon="lucide:plug-zap" aria-hidden="true"></iconify-icon>
                  <span>Pengaturan & Integrasi</span>
                </a>
                <a class="l-humas__link" href="/akun" aria-current={isPathActive('/akun') ? 'page' : undefined}>
                  <iconify-icon icon="lucide:users" aria-hidden="true"></iconify-icon>
                  <span>Akun & Audit</span>
                </a>
              </div>
            </nav>

            <div class="l-humas__sidebar-foot">
              <div class="l-humas__target">
                <p class="l-humas__target-title">Target konten bulan ini</p>
                <div class="l-humas__target-bar" role="img" aria-label="Realisasi target konten 68 persen">
                  <span style="width: 68%;"></span>
                </div>
                <p class="l-humas__target-meta">68 dari 100 konten terbit</p>
              </div>
              <p class="l-humas__sync">
                <iconify-icon icon="lucide:refresh-cw" aria-hidden="true"></iconify-icon>
                <span>Sinkron terakhir <b data-shell-synced>Hari ini WIB</b></span>
              </p>
              <div class="l-humas__user">
                {currentUser.avatarUrl ? (
                  <img
                    src={currentUser.avatarUrl}
                    alt={currentUser.name}
                    class="l-humas__avatar"
                    style="object-fit:cover;border:1px solid rgba(255,255,255,0.2);"
                  />
                ) : (
                  <span class="l-humas__avatar" aria-hidden="true">{currentUser.initials}</span>
                )}
                <span class="l-humas__user-meta">
                  <span class="l-humas__user-name">{currentUser.name}</span>
                  <span class="l-humas__user-role" data-shell-role-label>Peran: {roleNames[currentRole]}</span>
                </span>
                <a href="/profil-akun" title="Pengaturan profil akun" style="margin-left:auto;color:#8496a6;text-decoration:none;display:grid;place-items:center;padding:4px;">
                  <iconify-icon icon="lucide:settings" aria-hidden="true"></iconify-icon>
                </a>
              </div>
            </div>
          </aside>

          <!-- Scrim Penutup Mobile Nav -->
          <button class="l-humas__scrim" type="button" data-shell-action="close-nav" aria-label="Tutup navigasi"></button>

          <!-- Kolom Utama -->
          <div class="l-humas__main">
            <!-- Header Atas -->
            <header class="l-humas__header">
              <div class="l-humas__header-inner" data-layout-container>
                <button class="l-humas__menu-btn" type="button" data-shell-action="toggle-nav" aria-label="Buka navigasi" aria-expanded="false" aria-controls="humas-sidebar">
                  <iconify-icon icon="lucide:menu" aria-hidden="true"></iconify-icon>
                </button>

                <div class="l-humas__heading">
                  <h1 class="l-humas__title">{pageTitle}</h1>
                  <p class="l-humas__subtitle">{pageSubtitle}</p>
                </div>

                <div class="l-humas__tools">
                  <label class="l-humas__search">
                    <iconify-icon icon="lucide:search" aria-hidden="true"></iconify-icon>
                    <span style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">Cari modul, dokumen, atau jadwal</span>
                    <input type="search" placeholder="Cari modul, dokumen, jadwal..." data-shell-search />
                  </label>

                  <span class="l-humas__role">
                    <span class="l-humas__role-label">Peran</span>
                    <select data-shell-role aria-label="Pilih peran pengguna">
                      <option value="head" selected={currentRole === 'head'}>Kepala Humas</option>
                      <option value="admin" selected={currentRole === 'admin'}>Admin Teknis</option>
                      <option value="staff" selected={currentRole === 'staff'}>Staf Konten</option>
                    </select>
                  </span>

                  <button class="l-humas__icon-btn" type="button" data-shell-action="toggle-theme" aria-label="Ubah mode tema" aria-pressed="false" title="Mode Terang / Gelap">
                    <iconify-icon icon="lucide:moon" aria-hidden="true" data-shell-theme-icon></iconify-icon>
                  </button>

                  <button class="l-humas__icon-btn" type="button" data-shell-action="notifications" aria-label="Peringatan aktif" title="3 Peringatan Aktif">
                    <span style="position:relative;display:grid;place-items:center">
                      <iconify-icon icon="lucide:bell" aria-hidden="true"></iconify-icon>
                      <span class="l-humas__badge" style="position:absolute;top:-6px;right:-8px">3</span>
                    </span>
                  </button>

                  <div data-page-content={pageContentId} data-page-slot="header-actions" style="display:contents">
                    <slot name="header-actions" />
                  </div>
                </div>
              </div>
            </header>

            <!-- Konten Halaman -->
            <main class="l-humas__content" id="humas-main">
              <div class="l-humas__content-inner">
                <div data-layout-container data-layout-content>
                  <div data-page-content={pageContentId} data-page-slot="content" style="display:contents">
                    <slot />
                  </div>
                </div>
              </div>
            </main>
          </div>
        </div>
      </div>
    </div>

    <!-- Script Interaktif Humas Shell (Navigasi Drawer, Tema, Peran, Sinkronisasi) -->
    <script is:inline>
      (() => {
        const shell = document.getElementById('humas-shell-root');
        if (!shell) return;

        // 1. Tema Terang / Gelap (Light / Dark)
        const themeBtn = shell.querySelector('[data-shell-action="toggle-theme"]');
        const themeIcon = shell.querySelector('[data-shell-theme-icon]');

        const applyTheme = (theme) => {
          shell.dataset.theme = theme;
          if (themeBtn) {
            themeBtn.setAttribute('aria-pressed', String(theme === 'dark'));
            themeBtn.setAttribute('aria-label', theme === 'dark' ? 'Ubah mode terang' : 'Ubah mode gelap');
          }
          if (themeIcon) {
            themeIcon.setAttribute('icon', theme === 'dark' ? 'lucide:sun' : 'lucide:moon');
          }
          try { localStorage.setItem('humas-theme', theme); } catch (e) {}
        };

        const savedTheme = localStorage.getItem('humas-theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        applyTheme(savedTheme);

        // 2. Mobile Drawer Navigation Toggle
        const toggleBtn = shell.querySelector('[data-shell-action="toggle-nav"]');
        const setNav = (open) => {
          shell.dataset.nav = open ? 'open' : 'closed';
          if (toggleBtn) toggleBtn.setAttribute('aria-expanded', String(open));
          document.body.style.overflow = open ? 'hidden' : '';
        };

        shell.addEventListener('click', (event) => {
          const target = event.target instanceof Element ? event.target.closest('[data-shell-action]') : null;
          if (!target || !shell.contains(target)) return;
          const action = target.dataset.shellAction;
          if (action === 'toggle-nav') setNav(shell.dataset.nav !== 'open');
          if (action === 'close-nav') setNav(false);
          if (action === 'toggle-theme') {
            const isDark = shell.dataset.theme === 'dark';
            applyTheme(isDark ? 'light' : 'dark');
          }
          if (action === 'notifications') {
            alert('Peringatan Aktif Humas:\n1. Sinkronisasi Google Sheets terputus (perlu re-auth)\n2. 4 jadwal konten menunggu persetujuan (IG besok)\n3. Refresh token Meta Ads diperlukan');
          }
        });

        shell.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && shell.dataset.nav === 'open') {
            setNav(false);
            if (toggleBtn) toggleBtn.focus();
          }
        });

        // 3. Peran Switcher (Role Switcher dengan cookie & reload)
        const roleSelect = shell.querySelector('[data-shell-role]');
        if (roleSelect) {
          roleSelect.addEventListener('change', () => {
            const newRole = roleSelect.value;
            document.cookie = 'user_role=' + newRole + '; path=/; max-age=2592000; SameSite=Lax';
            const url = new URL(window.location.href);
            url.searchParams.set('role', newRole);
            window.location.href = url.toString();
          });
        }

        // 4. Pencarian Cepat
        const searchInput = shell.querySelector('[data-shell-search]');
        if (searchInput) {
          searchInput.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
              const q = searchInput.value.trim().toLowerCase();
              if (!q) return;
              if (q.includes('berita') || q.includes('rss') || q.includes('telegram')) {
                window.location.href = '/pantauan-berita?q=' + encodeURIComponent(q);
              } else if (q.includes('kalender') || q.includes('jadwal') || q.includes('konten')) {
                window.location.href = '/kalender-konten';
              } else if (q.includes('sop') || q.includes('krisis') || q.includes('alur')) {
                window.location.href = '/sop';
              } else if (q.includes('dokumen') || q.includes('pedoman')) {
                window.location.href = '/basis-pengetahuan?q=' + encodeURIComponent(q);
              } else if (q.includes('laporan') || q.includes('anggaran') || q.includes('rab')) {
                window.location.href = '/laporan';
              } else if (q.includes('pengaturan') || q.includes('integrasi') || q.includes('dam')) {
                window.location.href = '/pengaturan';
              } else if (q.includes('akun') || q.includes('audit')) {
                window.location.href = '/akun';
              } else {
                window.location.href = '/pantauan-berita?q=' + encodeURIComponent(q);
              }
            }
          });
        }

        // 5. Update timestamp sinkronisasi
        const syncLabel = shell.querySelector('[data-shell-synced]');
        if (syncLabel) {
          const now = new Date();
          const jam = new Intl.DateTimeFormat('id-ID', { hour: '2-digit', minute: '2-digit' }).format(now);
          syncLabel.textContent = 'Hari ini ' + jam + ' WIB';
        }
      })();
    </script>
  </body>
</html>
