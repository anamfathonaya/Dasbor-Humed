---
import HumasLayout from '../layouts/HumasLayout.astro';
---

<HumasLayout
  title="Papan Proyek — Humas Internal Peduli Negeri"
  pageTitle="Papan Proyek"
  pageSubtitle="Produksi konten multi-bidang, alur peliputan, dan penugasan tim kreatif"
  currentPath="/papan-proyek"
  pageContentId="papan-proyek"
>
  <main class="papan" data-node-id="papan.main">
    <!-- Baris Statistik & Filter Papan -->
    <div class="papan__bar" data-node-id="papan.bar">
      <div class="papan__stat"><b data-part="stat-total" id="stat-total">12</b><span>Kartu aktif</span></div>
      <div class="papan__stat"><b data-part="stat-late" id="stat-late">3</b><span>Mendekati tenggat</span></div>
      <div class="papan__stat"><b data-part="stat-done" id="stat-done">8</b><span>Selesai bulan ini</span></div>
      <div class="papan__filter">
        <label style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">Saring bidang</label>
        <select class="papan__select" id="filter-bidang" data-action="filter-bidang" aria-label="Saring bidang">
          <option value="all">Semua bidang</option>
          <option value="operasional">Operasional</option>
          <option value="keuangan">Keuangan</option>
          <option value="fundraising">Fundraising</option>
          <option value="penyaluran">Penyaluran-Edukasi</option>
          <option value="bph">BPH</option>
          <option value="wilayah">Wilayah</option>
        </select>
        <select class="papan__select" id="filter-platform" data-action="filter-platform" aria-label="Saring platform">
          <option value="all">Semua platform</option>
          <option value="instagram">Instagram</option>
          <option value="whatsapp">WhatsApp</option>
          <option value="facebook">Facebook</option>
          <option value="youtube">YouTube</option>
          <option value="internal">Kebutuhan internal</option>
        </select>
        <button class="papan__btn papan__btn--primary" type="button" id="btn-tambah-kartu" data-action="tambah-kartu">
          <iconify-icon icon="lucide:plus" aria-hidden="true"></iconify-icon> Tugas baru
        </button>
      </div>
    </div>

    <!-- Papan Kanban & Panel Samping -->
    <div class="papan__layout">
      <div class="papan__board" data-part="board" id="kanban-board">
        <!-- Kolom 1: Permintaan Masuk -->
        <section class="papan__col" data-col="masuk" aria-labelledby="col-masuk">
          <div class="papan__col-head">
            <h2 class="papan__col-title" id="col-masuk">Permintaan Masuk</h2>
            <span class="papan__count" data-part="count-masuk" id="count-masuk">3</span>
          </div>
          <div class="papan__cards" data-cards="masuk" id="cards-masuk">
            <article class="papan__card" data-card data-stage="masuk" data-platform="internal" data-bidang="fundraising">
              <span class="papan__tag papan__tag--internal">Kebutuhan internal</span>
              <h3 class="papan__card-title">Desain proposal program beasiswa anak</h3>
              <div class="papan__meta">
                <span><iconify-icon icon="lucide:building-2" aria-hidden="true"></iconify-icon>Fundraising</span>
                <span><iconify-icon icon="lucide:calendar" aria-hidden="true"></iconify-icon>15 Jun</span>
                <span class="papan__pri papan__pri--high">Prioritas tinggi</span>
              </div>
              <div class="papan__move">
                <button type="button" data-action="mundur" disabled>Kembali</button>
                <button type="button" data-action="maju">Kerjakan</button>
              </div>
            </article>

            <article class="papan__card" data-card data-stage="masuk" data-platform="instagram" data-bidang="penyaluran">
              <span class="papan__tag papan__tag--ig">Instagram · Reels</span>
              <h3 class="papan__card-title">Reels penyaluran air bersih Sumba</h3>
              <div class="papan__meta">
                <span><iconify-icon icon="lucide:building-2" aria-hidden="true"></iconify-icon>Penyaluran-Edukasi</span>
                <span><iconify-icon icon="lucide:calendar" aria-hidden="true"></iconify-icon>18 Jun</span>
                <span class="papan__pri papan__pri--mid">Prioritas sedang</span>
              </div>
              <div class="papan__move">
                <button type="button" data-action="mundur" disabled>Kembali</button>
                <button type="button" data-action="maju">Kerjakan</button>
              </div>
            </article>

            <article class="papan__card" data-card data-stage="masuk" data-platform="facebook" data-bidang="operasional">
              <span class="papan__tag papan__tag--fb">Facebook · Carousel</span>
              <h3 class="papan__card-title">Carousel rangkuman kunjungan donatur yayasan</h3>
              <div class="papan__meta">
                <span><iconify-icon icon="lucide:building-2" aria-hidden="true"></iconify-icon>Operasional</span>
                <span><iconify-icon icon="lucide:calendar" aria-hidden="true"></iconify-icon>20 Jun</span>
                <span class="papan__pri papan__pri--low">Prioritas rendah</span>
              </div>
              <div class="papan__move">
                <button type="button" data-action="mundur" disabled>Kembali</button>
                <button type="button" data-action="maju">Kerjakan</button>
              </div>
            </article>
          </div>
          <p class="papan__empty" data-empty="masuk" hidden>Tidak ada kartu pada tahap ini.</p>
        </section>

        <!-- Kolom 2: Dikerjakan -->
        <section class="papan__col" data-col="kerja" aria-labelledby="col-kerja">
          <div class="papan__col-head">
            <h2 class="papan__col-title" id="col-kerja">Sedang Dikerjakan</h2>
            <span class="papan__count" data-part="count-kerja" id="count-kerja">3</span>
          </div>
          <div class="papan__cards" data-cards="kerja" id="cards-kerja">
            <article class="papan__card" data-card data-stage="kerja" data-platform="youtube" data-bidang="penyaluran">
              <span class="papan__tag papan__tag--yt">YouTube · Video panjang</span>
              <h3 class="papan__card-title">Dokumenter penyaluran logistik bencana</h3>
              <div class="papan__meta">
                <span><iconify-icon icon="lucide:building-2" aria-hidden="true"></iconify-icon>Penyaluran-Edukasi</span>
                <span><iconify-icon icon="lucide:calendar" aria-hidden="true"></iconify-icon>21 Jun</span>
                <span class="papan__pri papan__pri--high">Prioritas tinggi</span>
              </div>
              <div class="papan__move">
                <button type="button" data-action="mundur">Kembali</button>
                <button type="button" data-action="maju">Tinjau</button>
              </div>
            </article>

            <article class="papan__card" data-card data-stage="kerja" data-platform="whatsapp" data-bidang="fundraising">
              <span class="papan__tag papan__tag--wa">WhatsApp · Pesan CRM</span>
              <h3 class="papan__card-title">Broadcast kampanye peduli gizi balita</h3>
              <div class="papan__meta">
                <span><iconify-icon icon="lucide:building-2" aria-hidden="true"></iconify-icon>Fundraising</span>
                <span><iconify-icon icon="lucide:calendar" aria-hidden="true"></iconify-icon>16 Jun</span>
                <span class="papan__pri papan__pri--high">Prioritas tinggi</span>
              </div>
              <div class="papan__move">
                <button type="button" data-action="mundur">Kembali</button>
                <button type="button" data-action="maju">Tinjau</button>
              </div>
            </article>

            <article class="papan__card" data-card data-stage="kerja" data-platform="internal" data-bidang="keuangan">
              <span class="papan__tag papan__tag--internal">Kebutuhan internal</span>
              <h3 class="papan__card-title">Desain laporan akuntabilitas triwulan II</h3>
              <div class="papan__meta">
                <span><iconify-icon icon="lucide:building-2" aria-hidden="true"></iconify-icon>Keuangan</span>
                <span><iconify-icon icon="lucide:calendar" aria-hidden="true"></iconify-icon>24 Jun</span>
                <span class="papan__pri papan__pri--mid">Prioritas sedang</span>
              </div>
              <div class="papan__move">
                <button type="button" data-action="mundur">Kembali</button>
                <button type="button" data-action="maju">Tinjau</button>
              </div>
            </article>
          </div>
          <p class="papan__empty" data-empty="kerja" hidden>Tidak ada kartu pada tahap ini.</p>
        </section>

        <!-- Kolom 3: Menunggu Persetujuan -->
        <section class="papan__col" data-col="tinjau" aria-labelledby="col-tinjau">
          <div class="papan__col-head">
            <h2 class="papan__col-title" id="col-tinjau">Menunggu Persetujuan</h2>
            <span class="papan__count" data-part="count-tinjau" id="count-tinjau">3</span>
          </div>
          <div class="papan__cards" data-cards="tinjau" id="cards-tinjau">
            <article class="papan__card" data-card data-stage="tinjau" data-platform="instagram" data-bidang="bph">
              <span class="papan__tag papan__tag--ig">Instagram · Story</span>
              <h3 class="papan__card-title">Story sambutan pimpinan yayasan</h3>
              <div class="papan__meta">
                <span><iconify-icon icon="lucide:building-2" aria-hidden="true"></iconify-icon>BPH</span>
                <span><iconify-icon icon="lucide:calendar" aria-hidden="true"></iconify-icon>14 Jun</span>
                <span class="papan__pri papan__pri--mid">Prioritas sedang</span>
              </div>
              <div class="papan__move">
                <button type="button" data-action="mundur">Kembali</button>
                <button type="button" data-action="maju">Selesai</button>
              </div>
            </article>

            <article class="papan__card" data-card data-stage="tinjau" data-platform="youtube" data-bidang="wilayah">
              <span class="papan__tag papan__tag--yt">YouTube · Video pendek</span>
              <h3 class="papan__card-title">After movie kegiatan relawan posko Jabar</h3>
              <div class="papan__meta">
                <span><iconify-icon icon="lucide:building-2" aria-hidden="true"></iconify-icon>Wilayah</span>
                <span><iconify-icon icon="lucide:calendar" aria-hidden="true"></iconify-icon>19 Jun</span>
                <span class="papan__pri papan__pri--low">Prioritas rendah</span>
              </div>
              <div class="papan__move">
                <button type="button" data-action="mundur">Kembali</button>
                <button type="button" data-action="maju">Selesai</button>
              </div>
            </article>

            <article class="papan__card" data-card data-stage="tinjau" data-platform="facebook" data-bidang="donatur">
              <span class="papan__tag papan__tag--fb">Facebook · Video</span>
              <h3 class="papan__card-title">Kisah inspiratif relawan medis 5 tahun</h3>
              <div class="papan__meta">
                <span><iconify-icon icon="lucide:building-2" aria-hidden="true"></iconify-icon>Donatur</span>
                <span><iconify-icon icon="lucide:calendar" aria-hidden="true"></iconify-icon>22 Jun</span>
                <span class="papan__pri papan__pri--mid">Prioritas sedang</span>
              </div>
              <div class="papan__move">
                <button type="button" data-action="mundur">Kembali</button>
                <button type="button" data-action="maju">Selesai</button>
              </div>
            </article>
          </div>
          <p class="papan__empty" data-empty="tinjau" hidden>Tidak ada kartu pada tahap ini.</p>
        </section>

        <!-- Kolom 4: Selesai -->
        <section class="papan__col" data-col="selesai" aria-labelledby="col-selesai">
          <div class="papan__col-head">
            <h2 class="papan__col-title" id="col-selesai">Selesai</h2>
            <span class="papan__count" data-part="count-selesai" id="count-selesai">3</span>
          </div>
          <div class="papan__cards" data-cards="selesai" id="cards-selesai">
            <article class="papan__card" data-card data-stage="selesai" data-platform="instagram" data-bidang="operasional">
              <span class="papan__tag papan__tag--ig">Instagram · Single post</span>
              <h3 class="papan__card-title">Posting ucapan Hari Lingkungan Hidup</h3>
              <div class="papan__meta">
                <span><iconify-icon icon="lucide:building-2" aria-hidden="true"></iconify-icon>Operasional</span>
                <span><iconify-icon icon="lucide:calendar" aria-hidden="true"></iconify-icon>12 Jun</span>
              </div>
              <div class="papan__move">
                <button type="button" data-action="mundur">Kembali</button>
                <button type="button" data-action="maju" disabled>Selesai</button>
              </div>
            </article>

            <article class="papan__card" data-card data-stage="selesai" data-platform="internal" data-bidang="keuangan">
              <span class="papan__tag papan__tag--internal">Kebutuhan internal</span>
              <h3 class="papan__card-title">Set desain program bantuan pendidikan</h3>
              <div class="papan__meta">
                <span><iconify-icon icon="lucide:building-2" aria-hidden="true"></iconify-icon>Keuangan</span>
                <span><iconify-icon icon="lucide:calendar" aria-hidden="true"></iconify-icon>10 Jun</span>
              </div>
              <div class="papan__move">
                <button type="button" data-action="mundur">Kembali</button>
                <button type="button" data-action="maju" disabled>Selesai</button>
              </div>
            </article>

            <article class="papan__card" data-card data-stage="selesai" data-platform="whatsapp" data-bidang="fundraising">
              <span class="papan__tag papan__tag--wa">WhatsApp · Status</span>
              <h3 class="papan__card-title">Status update penyaluran pekan kedua</h3>
              <div class="papan__meta">
                <span><iconify-icon icon="lucide:building-2" aria-hidden="true"></iconify-icon>Fundraising</span>
                <span><iconify-icon icon="lucide:calendar" aria-hidden="true"></iconify-icon>11 Jun</span>
              </div>
              <div class="papan__move">
                <button type="button" data-action="mundur">Kembali</button>
                <button type="button" data-action="maju" disabled>Selesai</button>
              </div>
            </article>
          </div>
          <p class="papan__empty" data-empty="selesai" hidden>Tidak ada kartu pada tahap ini.</p>
        </section>
      </div>

      <!-- Panel Samping: Beban Kerja & Log Aktivitas -->
      <div class="papan__side">
        <section class="papan__panel" aria-labelledby="beban-title">
          <h2 id="beban-title">Beban Kerja Tim Humas</h2>
          <div class="papan__load">
            <div class="papan__load-row"><span>Rani Maulida</span><b>5 tugas</b><div class="papan__meter"><span style="width:83%"></span></div></div>
            <div class="papan__load-row"><span>Budi Santoso</span><b>4 tugas</b><div class="papan__meter"><span style="width:66%"></span></div></div>
            <div class="papan__load-row"><span>Dewi Lestari</span><b>3 tugas</b><div class="papan__meter"><span style="width:50%"></span></div></div>
            <div class="papan__load-row"><span>Ahmad Fauzi</span><b>1 tugas</b><div class="papan__meter"><span style="width:17%"></span></div></div>
          </div>
        </section>

        <section class="papan__panel" aria-labelledby="aktivitas-title">
          <h2 id="aktivitas-title">Aktivitas Terkini</h2>
          <div class="papan__log">
            <p class="papan__log-item"><b>Budi</b> memindahkan <b>Dokumenter logistik bencana</b> ke Sedang Dikerjakan · 09:40</p>
            <p class="papan__log-item"><b>Rani</b> mengajukan review <b>Story sambutan pimpinan</b> · 08:55</p>
            <p class="papan__log-item"><b>Dewi</b> menandai <b>Set desain bantuan pendidikan</b> selesai · Kemarin 16:20</p>
          </div>
        </section>
      </div>
    </div>

    <!-- Modal Form Tambah Tugas Baru -->
    <div class="papan__modal" id="papan-modal" data-part="modal" hidden>
      <div class="papan__dialog" role="dialog" aria-modal="true" aria-labelledby="papan-modal-title">
        <h2 id="papan-modal-title">Tugas Produksi Baru</h2>
        <form id="form-tugas" data-action="form-tugas">
          <label class="papan__field">Judul tugas produksi
            <input name="judul" id="task-judul" required placeholder="mis. Reels liputan distribusi sembako" />
          </label>
          <label class="papan__field">Platform publikasi
            <select name="platform" id="task-platform">
              <option value="instagram">Instagram</option>
              <option value="whatsapp">WhatsApp</option>
              <option value="facebook">Facebook</option>
              <option value="youtube">YouTube</option>
              <option value="internal">Kebutuhan internal</option>
            </select>
          </label>
          <label class="papan__field">Bidang pemohon
            <select name="bidang" id="task-bidang">
              <option value="operasional">Operasional</option>
              <option value="keuangan">Keuangan</option>
              <option value="fundraising">Fundraising</option>
              <option value="penyaluran">Penyaluran-Edukasi</option>
              <option value="bph">BPH</option>
              <option value="donatur">Donatur</option>
              <option value="wilayah">Wilayah</option>
            </select>
          </label>
          <label class="papan__field">Tenggat waktu
            <input name="tenggat" id="task-tenggat" type="date" value="2026-06-25" />
          </label>
          <div class="papan__actions">
            <button class="papan__btn" type="button" id="btn-tutup-modal" data-action="tutup-modal">Batal</button>
            <button class="papan__btn papan__btn--primary" type="submit">Simpan Tugas</button>
          </div>
        </form>
      </div>
    </div>
  </main>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const board = document.getElementById('kanban-board');
      const modal = document.getElementById('papan-modal');
      const form = document.getElementById('form-tugas');
      const filterBidang = document.getElementById('filter-bidang');
      const filterPlatform = document.getElementById('filter-platform');

      const STAGES = ['masuk', 'kerja', 'tinjau', 'selesai'];
      const STAGE_LABELS = {
        masuk: { next: 'Kerjakan', prev: 'Kembali' },
        kerja: { next: 'Tinjau', prev: 'Kembali' },
        tinjau: { next: 'Selesai', prev: 'Kembali' },
        selesai: { next: 'Selesai', prev: 'Kembali' }
      };

      function updateCounts() {
        STAGES.forEach((st) => {
          const col = document.querySelector(`[data-col="${st}"]`);
          if (!col) return;
          const visibleCards = col.querySelectorAll(`.papan__card:not([hidden])`).length;
          const countBadge = col.querySelector(`.papan__count`);
          if (countBadge) countBadge.textContent = String(visibleCards);
          const empty = col.querySelector(`[data-empty="${st}"]`);
          if (empty) empty.hidden = visibleCards !== 0;
        });

        const totalActive = document.querySelectorAll('.papan__card:not([data-stage="selesai"]):not([hidden])').length;
        const totalDone = document.querySelectorAll('.papan__card[data-stage="selesai"]:not([hidden])').length;
        const statTot = document.getElementById('stat-total');
        const statDone = document.getElementById('stat-done');
        if (statTot) statTot.textContent = String(totalActive);
        if (statDone) statDone.textContent = String(totalDone);
      }

      function applyFilter() {
        const bidang = filterBidang.value;
        const platform = filterPlatform.value;

        document.querySelectorAll('.papan__card').forEach((card) => {
          const matchBidang = bidang === 'all' || card.getAttribute('data-bidang') === bidang;
          const matchPlat = platform === 'all' || card.getAttribute('data-platform') === platform;
          card.hidden = !(matchBidang && matchPlat);
        });

        updateCounts();
      }

      filterBidang?.addEventListener('change', applyFilter);
      filterPlatform?.addEventListener('change', applyFilter);

      // Card movement (Maju / Mundur)
      board?.addEventListener('click', (e) => {
        const btnMaju = e.target.closest('[data-action="maju"]');
        const btnMundur = e.target.closest('[data-action="mundur"]');
        const card = e.target.closest('.papan__card');
        if (!card) return;

        let currentStage = card.getAttribute('data-stage') || 'masuk';
        let idx = STAGES.indexOf(currentStage);

        if (btnMaju && idx < STAGES.length - 1) {
          const nextStage = STAGES[idx + 1];
          card.setAttribute('data-stage', nextStage);
          const targetCol = document.getElementById(`cards-${nextStage}`);
          if (targetCol) targetCol.appendChild(card);
          updateButtons(card, nextStage);
          updateCounts();
        }

        if (btnMundur && idx > 0) {
          const prevStage = STAGES[idx - 1];
          card.setAttribute('data-stage', prevStage);
          const targetCol = document.getElementById(`cards-${prevStage}`);
          if (targetCol) targetCol.appendChild(card);
          updateButtons(card, prevStage);
          updateCounts();
        }
      });

      function updateButtons(card, stage) {
        const mundurBtn = card.querySelector('[data-action="mundur"]');
        const majuBtn = card.querySelector('[data-action="maju"]');
        if (mundurBtn) mundurBtn.disabled = stage === 'masuk';
        if (majuBtn) {
          majuBtn.disabled = stage === 'selesai';
          majuBtn.textContent = STAGE_LABELS[stage]?.next || 'Maju';
        }
      }

      // Modal
      document.getElementById('btn-tambah-kartu')?.addEventListener('click', () => {
        modal.hidden = false;
        document.getElementById('task-judul')?.focus();
      });

      document.getElementById('btn-tutup-modal')?.addEventListener('click', () => {
        modal.hidden = true;
      });

      form?.addEventListener('submit', (e) => {
        e.preventDefault();
        const judul = document.getElementById('task-judul').value.trim();
        const platform = document.getElementById('task-platform').value;
        const bidang = document.getElementById('task-bidang').value;
        const tenggat = document.getElementById('task-tenggat').value || '25 Jun';

        if (!judul) return;

        const tagMap = {
          instagram: { cls: 'papan__tag--ig', label: 'Instagram · Post' },
          whatsapp: { cls: 'papan__tag--wa', label: 'WhatsApp · CRM' },
          facebook: { cls: 'papan__tag--fb', label: 'Facebook' },
          youtube: { cls: 'papan__tag--yt', label: 'YouTube' },
          internal: { cls: 'papan__tag--internal', label: 'Kebutuhan internal' }
        };
        const tagInfo = tagMap[platform] || tagMap.internal;

        const article = document.createElement('article');
        article.className = 'papan__card';
        article.setAttribute('data-card', '');
        article.setAttribute('data-stage', 'masuk');
        article.setAttribute('data-platform', platform);
        article.setAttribute('data-bidang', bidang);
        article.innerHTML = `
          <span class="papan__tag ${tagInfo.cls}">${tagInfo.label}</span>
          <h3 class="papan__card-title">${judul}</h3>
          <div class="papan__meta">
            <span><iconify-icon icon="lucide:building-2" aria-hidden="true"></iconify-icon>${bidang.toUpperCase()}</span>
            <span><iconify-icon icon="lucide:calendar" aria-hidden="true"></iconify-icon>${tenggat}</span>
            <span class="papan__pri papan__pri--high">Baru masuk</span>
          </div>
          <div class="papan__move">
            <button type="button" data-action="mundur" disabled>Kembali</button>
            <button type="button" data-action="maju">Kerjakan</button>
          </div>
        `;

        document.getElementById('cards-masuk')?.prepend(article);
        form.reset();
        modal.hidden = true;
        updateCounts();
      });

      updateCounts();
    });
  </script>
</HumasLayout>
