---
import HumasLayout from '../layouts/HumasLayout.astro';
import {
  mockPerformance,
  reportChannels,
  reportPeriods,
} from '../lib/clientDataFetcher';
---

<HumasLayout
  title="Laporan Kinerja Kanal — Humas Internal Peduli Negeri"
  pageTitle="Laporan Kinerja Kanal"
  pageSubtitle="Ringkasan performa per kanal publikasi, konversi kampanye, dan pencatatan temuan berkala"
  currentPath="/laporan-kinerja"
  pageContentId="laporan"
>
  <main class="lap" data-node-id="laporan.kinerja">
    <!-- Sub-Navigasi Modul Laporan Detail -->
    <div style="display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap;">
      <a href="/laporan" class="lap__mini" style="padding:6px 14px;border-radius:8px;text-decoration:none;border:1px solid var(--color-border,#dbe1e8);background:var(--color-surface,#fff);color:var(--color-text,#16202b);">
        Ringkasan Semua Laporan
      </a>
      <a href="/laporan-kinerja" class="lap__mini" style="background:var(--color-primary,#1d5c94);color:#fff;font-weight:600;padding:6px 14px;border-radius:8px;text-decoration:none;">
        Laporan Kinerja Kanal
      </a>
      <a href="/laporan-anggaran" class="lap__mini" style="padding:6px 14px;border-radius:8px;text-decoration:none;border:1px solid var(--color-border,#dbe1e8);background:var(--color-surface,#fff);color:var(--color-text,#16202b);">
        Laporan Anggaran
      </a>
      <a href="/daftar-rab-lra" class="lap__mini" style="padding:6px 14px;border-radius:8px;text-decoration:none;border:1px solid var(--color-border,#dbe1e8);background:var(--color-surface,#fff);color:var(--color-text,#16202b);">
        Daftar RAB & LRA
      </a>
      <a href="/laporan-tahunan" class="lap__mini" style="padding:6px 14px;border-radius:8px;text-decoration:none;border:1px solid var(--color-border,#dbe1e8);background:var(--color-surface,#fff);color:var(--color-text,#16202b);">
        Laporan Tahunan
      </a>
      <a href="/bagikan-cetak" class="lap__mini" style="padding:6px 14px;border-radius:8px;text-decoration:none;border:1px solid var(--color-border,#dbe1e8);background:var(--color-surface,#fff);color:var(--color-text,#16202b);">
        Bagikan & Cetak
      </a>
    </div>

    <!-- Filter & Toolbar -->
    <div class="lap__card" style="margin-bottom:16px;padding:16px;">
      <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;">
        <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;">
          <label style="font-size:12px;font-weight:600;">Periode:</label>
          <select id="period" class="lap__select">
            {reportPeriods.map((p) => <option value={p.value} selected={p.value === '30d'}>{p.label}</option>)}
          </select>
          <label style="font-size:12px;font-weight:600;margin-left:8px;">Kanal:</label>
          <select id="channel" class="lap__select">
            {reportChannels.map((c) => <option value={c}>{c}</option>)}
          </select>
        </div>
        <button type="button" id="save-note-btn" class="lap__btn lap__btn--primary">
          <iconify-icon icon="lucide:file-plus" aria-hidden="true"></iconify-icon> Simpan sebagai Catatan
        </button>
      </div>
    </div>

    <!-- Statistik Kinerja Cards -->
    <div id="stats" style="display:grid;grid-template-columns:repeat(auto-fit, minmax(200px, 1fr));gap:16px;margin-bottom:16px;"></div>

    <!-- Tabel Rincian per Kanal -->
    <section class="lap__card" style="margin-bottom:20px;">
      <div class="lap__toolbar">
        <div>
          <div class="lap__count-label">Performa Publikasi</div>
          <h2 style="font-size:15px;margin:2px 0 0;">Rincian Metrik per Kanal</h2>
        </div>
      </div>
      <div class="lap__table-wrap">
        <table class="lap__table">
          <thead>
            <tr>
              <th>Kanal</th>
              <th style="text-align:right">Jangkauan</th>
              <th style="text-align:right">Interaksi</th>
              <th style="text-align:right">Konversi</th>
              <th style="text-align:right">Perubahan</th>
            </tr>
          </thead>
          <tbody id="rows"></tbody>
        </table>
      </div>
      <p id="empty" style="text-align:center;padding:20px;color:var(--color-muted,#5a6875);display:none;">Tidak ada data untuk filter ini.</p>
    </section>

    <!-- Catatan Tersimpan -->
    <section class="lap__card">
      <div class="lap__toolbar">
        <div>
          <h2 style="font-size:15px;margin:0;">Catatan Analisis Tersimpan</h2>
          <p style="font-size:12px;color:var(--color-muted,#5a6875);margin:2px 0 0;">Pencatatan temuan penting untuk evaluasi redaksi bulanan</p>
        </div>
      </div>
      <div id="notes-container" style="display:flex;flex-direction:column;gap:10px;margin-top:12px;"></div>
    </section>

    <!-- Dialog Simpan Catatan -->
    <dialog id="note-dialog" class="kb__modal" style="border:none;background:transparent;padding:0;">
      <div class="kb__dialog" style="max-width:480px;background:#fff;border-radius:12px;padding:20px;box-shadow:0 10px 25px rgba(0,0,0,0.2);">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
          <h3 style="margin:0;font-size:16px;">Simpan Catatan Temuan</h3>
          <button type="button" id="note-cancel-x" style="background:none;border:none;cursor:pointer;font-size:16px;">✕</button>
        </div>
        <form id="note-form">
          <div style="margin-bottom:12px;">
            <label style="display:block;font-size:12px;font-weight:600;margin-bottom:4px;">Judul Catatan</label>
            <input id="note-title" class="kb__select" style="width:100%;" required maxlength="120" />
          </div>
          <div style="margin-bottom:16px;">
            <label style="display:block;font-size:12px;font-weight:600;margin-bottom:4px;">Uraian Temuan / Tindak Lanjut</label>
            <textarea id="note-body" class="kb__select" style="width:100%;height:80px;padding:8px;" placeholder="Temuan atau tindak lanjut..."></textarea>
          </div>
          <div style="display:flex;justify-content:flex-end;gap:8px;">
            <button type="button" id="note-cancel" class="lap__btn">Batal</button>
            <button type="submit" class="lap__btn lap__btn--primary">Simpan Catatan</button>
          </div>
        </form>
      </div>
    </dialog>
  </main>

  <script define:vars={{ data: mockPerformance }}>
    document.addEventListener('DOMContentLoaded', () => {
      const periodEl = document.getElementById('period');
      const channelEl = document.getElementById('channel');
      const rowsEl = document.getElementById('rows');
      const statsEl = document.getElementById('stats');
      const emptyEl = document.getElementById('empty');
      const n = (v) => v.toLocaleString('id-ID');

      function render() {
        if (!periodEl || !channelEl || !statsEl || !rowsEl) return;
        const list = data.filter(
          (d) => d.period === periodEl.value && (channelEl.value === 'Semua Kanal' || d.channel === channelEl.value)
        );
        if (emptyEl) emptyEl.style.display = list.length === 0 ? 'block' : 'none';
        const sum = (k) => list.reduce((s, d) => s + d[k], 0);

        statsEl.innerHTML = [
          ['Total Jangkauan', n(sum('reach'))],
          ['Total Interaksi', n(sum('engagement'))],
          ['Total Konversi', n(sum('conversions'))],
        ].map(([l, v]) => `
          <div class="lap__card" style="padding:16px;">
            <span style="font-size:12px;color:var(--color-muted,#5a6875);display:block;margin-bottom:4px;">${l}</span>
            <strong style="font-size:20px;color:var(--color-primary,#1d5c94);">${v}</strong>
          </div>
        `).join('');

        rowsEl.innerHTML = list.map((d) => {
          const up = d.delta >= 0;
          return `
            <tr>
              <td><strong>${d.channel}</strong></td>
              <td style="text-align:right">${n(d.reach)}</td>
              <td style="text-align:right">${n(d.engagement)}</td>
              <td style="text-align:right">${n(d.conversions)}</td>
              <td style="text-align:right">
                <span class="lap__badge ${up ? 'lap__badge--final' : 'lap__badge--draf'}">
                  ${up ? '▲ +' : '▼ '}${Math.abs(d.delta)}%
                </span>
              </td>
            </tr>
          `;
        }).join('');
      }

      periodEl?.addEventListener('change', render);
      channelEl?.addEventListener('change', render);
      render();

      // Notes handling
      const dlg = document.getElementById('note-dialog');
      const titleEl = document.getElementById('note-title');
      const bodyEl = document.getElementById('note-body');
      const notesContainer = document.getElementById('notes-container');

      async function renderNotes() {
        if (!notesContainer) return;
        try {
          const res = await fetch('/api/reports/performance/notes');
          const d = await res.json();
          const notes = d.success ? d.notes : [];
          if (notes.length === 0) {
            notesContainer.innerHTML = '<p style="color:var(--color-muted,#5a6875);font-size:13px;margin:0;">Belum ada catatan tersimpan.</p>';
            return;
          }
          notesContainer.innerHTML = notes.map((x) => `
            <div style="padding:12px;border-radius:8px;border:1px solid var(--color-border,#ebecee);background:var(--color-canvas,#f8f9fa);display:flex;justify-content:space-between;align-items:flex-start;">
              <div>
                <strong style="display:block;font-size:13px;">${x.title}</strong>
                <span style="font-size:11px;color:var(--color-muted,#5a6875);">${x.meta} · ${x.date}</span>
                <p style="margin:4px 0 0;font-size:12px;">${x.body || ''}</p>
              </div>
              <button class="lap__btn btn-del-note" data-id="${x.id}" style="font-size:11px;padding:3px 8px;">Hapus</button>
            </div>
          `).join('');

          document.querySelectorAll('.btn-del-note').forEach(b => {
            b.addEventListener('click', async (e) => {
              const id = (e.currentTarget as HTMLElement).dataset.id;
              await fetch(`/api/reports/performance/notes/${id}`, { method: 'DELETE' });
              renderNotes();
            });
          });
        } catch {
          notesContainer.innerHTML = '<p style="color:var(--color-muted,#5a6875);font-size:13px;">Gagal memuat catatan.</p>';
        }
      }

      renderNotes();

      document.getElementById('save-note-btn')?.addEventListener('click', () => {
        if (titleEl && channelEl && periodEl) {
          titleEl.value = `Laporan ${channelEl.value} (${periodEl.options[periodEl.selectedIndex].text})`;
        }
        if (dlg instanceof HTMLDialogElement) dlg.showModal();
      });

      document.getElementById('note-cancel')?.addEventListener('click', () => {
        if (dlg instanceof HTMLDialogElement) dlg.close();
      });
      document.getElementById('note-cancel-x')?.addEventListener('click', () => {
        if (dlg instanceof HTMLDialogElement) dlg.close();
      });

      document.getElementById('note-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const payload = {
          title: titleEl?.value.trim(),
          body: bodyEl?.value.trim(),
          channel: channelEl?.value,
          period: periodEl?.value,
          meta: `${channelEl?.value} / ${periodEl?.value}`
        };
        await fetch('/api/reports/performance/notes', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        if (dlg instanceof HTMLDialogElement) dlg.close();
        renderNotes();
      });
    });
  </script>
</HumasLayout>
