---
import HumasLayout from '../layouts/HumasLayout.astro';
import {
  mockNewsItems,
  mockCuratedSources as curatedSources,
} from '../lib/clientDataFetcher';

const tabParam = Astro.url.searchParams.get('tab') || 'feed';
---

<HumasLayout
  title="Pantauan Berita — Humas Internal Peduli Negeri"
  pageTitle="Pantauan Berita"
  pageSubtitle="Feed Telegram & RSS, daftar sumber terhubung, dan item tersimpan"
  currentPath="/pantauan-berita"
  pageContentId="pantauan-berita"
>
  <div class="berita" data-node-id="berita.root" data-loading="false">
    <!-- Tab Navigasi Pantauan Berita -->
    <div class="berita__tabs" role="tablist" aria-label="Bagian pantauan berita" data-node-id="berita.tabs">
      <button class={`berita__tab ${tabParam === 'feed' ? 'active' : ''}`} type="button" role="tab" id="tab-feed" aria-controls="panel-feed" aria-selected={tabParam === 'feed' ? 'true' : 'false'} tabindex="0" data-tab="feed">
        Feed <span class="berita__tab-count" data-count="feed">{mockNewsItems.length}</span>
      </button>
      <button class={`berita__tab ${tabParam === 'sumber' ? 'active' : ''}`} type="button" role="tab" id="tab-sumber" aria-controls="panel-sumber" aria-selected={tabParam === 'sumber' ? 'true' : 'false'} tabindex="-1" data-tab="sumber">
        Sumber <span class="berita__tab-count" data-count="sumber">{curatedSources.length}</span>
      </button>
      <button class={`berita__tab ${tabParam === 'tersimpan' ? 'active' : ''}`} type="button" role="tab" id="tab-tersimpan" aria-controls="panel-tersimpan" aria-selected={tabParam === 'tersimpan' ? 'true' : 'false'} tabindex="-1" data-tab="tersimpan">
        Tersimpan <span class="berita__tab-count" data-count="tersimpan">2</span>
      </button>
    </div>

    <!-- Toolbar Filter & Pencarian -->
    <div class="berita__toolbar">
      <span class="berita__field">
        <label for="berita-sumber-filter">Sumber</label>
        <select id="berita-sumber-filter" data-filter-source>
          <option value="">Semua sumber</option>
          <option value="telegram">Telegram</option>
          <option value="rss">RSS</option>
        </select>
      </span>
      <span class="berita__field">
        <label for="berita-cari">Cari</label>
        <input id="berita-cari" type="search" placeholder="Judul atau kata kunci..." data-filter-query />
      </span>
      <span class="berita__toolbar-meta" data-feed-meta>Menampilkan {mockNewsItems.length} item kabar</span>
    </div>

    <!-- Panel 1: Feed Berita Terkini -->
    <section id="panel-feed" role="tabpanel" aria-labelledby="tab-feed" tabindex="0" class="berita__panel" data-panel="feed">
      <ul class="berita__feed" data-feed-list>
        {mockNewsItems.map((item, index) => {
          const isTg = item.source.toLowerCase().includes('telegram') || item.sourceType === 'telegram';
          return (
            <li class="berita__item" data-saved={item.isBookmarked ? 'true' : 'false'} data-kind={isTg ? 'telegram' : 'rss'} data-search={item.title.toLowerCase()}>
              <div class="berita__source">
                <span class="berita__source-name">
                  <iconify-icon icon={isTg ? 'lucide:send' : 'lucide:rss'} aria-hidden="true"></iconify-icon>
                  {isTg ? ' Telegram' : ' RSS'}
                </span>
                <p class="berita__source-meta">{item.source}<br />{item.publishedAt}</p>
              </div>
              <div class="berita__body">
                <h3 class="berita__title">{item.title}</h3>
                <p class="berita__summary">{item.summary}</p>
                <div class="berita__tags">
                  <span class="berita__tag">{item.category}</span>
                  {item.isImportant && <span class="berita__tag" style="background:#fee2e2;color:#991b1b;border-color:#fca5a5;">🚨 Darurat / Penting</span>}
                </div>
              </div>
              <div class="berita__actions">
                <button class="berita__btn" type="button" data-action="berita:save" aria-pressed={item.isBookmarked ? 'true' : 'false'}>
                  <iconify-icon icon={item.isBookmarked ? 'lucide:bookmark-check' : 'lucide:bookmark'} aria-hidden="true"></iconify-icon>
                  <span>{item.isBookmarked ? 'Tersimpan' : 'Simpan'}</span>
                </button>
                <button class="berita__btn" type="button" data-action="berita:adopt" data-title={item.title}>
                  Adopsi ke kalender
                </button>
              </div>
            </li>
          );
        })}
      </ul>

      <div class="berita__empty" data-feed-empty hidden>
        <h3>Tidak ada item yang cocok</h3>
        <p>Coba ubah kata kunci pencarian atau pilih sumber lain. Item yang sudah disimpan tetap ada di tab Tersimpan.</p>
      </div>
    </section>

    <!-- Panel 2: Sumber Terhubung -->
    <section id="panel-sumber" role="tabpanel" aria-labelledby="tab-sumber" tabindex="0" class="berita__panel" data-panel="sumber" hidden>
      <div class="berita__table-wrap">
        <table>
          <caption>Sumber feed RSS dan saluran Telegram yang terhubung ke sistem.</caption>
          <thead>
            <tr>
              <th scope="col">Nama Sumber</th>
              <th scope="col">Jenis</th>
              <th scope="col">Kategori</th>
              <th scope="col">Status</th>
              <th scope="col">Interval</th>
            </tr>
          </thead>
          <tbody>
            {curatedSources.map((src) => (
              <tr>
                <td><strong>{src.name}</strong></td>
                <td>{src.type.toUpperCase()}</td>
                <td>{src.category}</td>
                <td>
                  <span class="berita__badge" data-tone={src.status === 'active' ? 'ok' : 'warn'}>
                    {src.status === 'active' ? 'Aktif Normal' : 'Tertunda'}
                  </span>
                </td>
                <td>15 menit</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Panel 3: Item Tersimpan -->
    <section id="panel-tersimpan" role="tabpanel" aria-labelledby="tab-tersimpan" tabindex="0" class="berita__panel" data-panel="tersimpan" hidden>
      <div class="berita__table-wrap">
        <table>
          <caption>Item yang disimpan untuk ditindaklanjuti sebagai rujukan konten lembaga.</caption>
          <thead>
            <tr>
              <th scope="col">Item Berita</th>
              <th scope="col">Sumber</th>
              <th scope="col">Status Adopsi</th>
              <th scope="col">Aksi</th>
            </tr>
          </thead>
          <tbody data-saved-body>
            <tr>
              <td class="col-title">
                <strong>Rapat koordinasi evaluasi program komunikasi publik</strong>
                <span>Kebijakan · Internal</span>
              </td>
              <td>Telegram Humas</td>
              <td><span class="berita__badge" data-tone="wait">Belum diadopsi</span></td>
              <td><button class="berita__btn" type="button" data-action="berita:adopt" data-title="Rapat koordinasi evaluasi program komunikasi publik">Adopsi ke kalender</button></td>
            </tr>
            <tr>
              <td class="col-title">
                <strong>Pemerintah daerah memperkuat mitigasi bencana</strong>
                <span>Siaran Pers · Sosial</span>
              </td>
              <td>Antara News RSS</td>
              <td><span class="berita__badge" data-tone="wait">Belum diadopsi</span></td>
              <td><button class="berita__btn" type="button" data-action="berita:adopt" data-title="Pemerintah daerah memperkuat mitigasi bencana">Adopsi ke kalender</button></td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>

  <!-- Dialog Adopsi ke Kalender Konten -->
  <dialog class="berita__dialog" id="adopt-dialog" data-node-id="berita.dialog" aria-labelledby="berita-dialog-title">
    <div class="berita__dialog-head">
      <div>
        <h2 id="berita-dialog-title">Adopsi ke kalender konten</h2>
        <p data-dialog-source id="dialog-source-text">Pilih jadwal rencana publikasi untuk item terpilih.</p>
      </div>
      <button class="berita__close" type="button" id="btn-close-dialog" aria-label="Tutup dialog">
        <iconify-icon icon="lucide:x" aria-hidden="true"></iconify-icon>
      </button>
    </div>
    <form method="dialog" id="adopt-form">
      <div class="berita__dialog-body">
        <div>
          <label class="berita__label" for="berita-dialog-date">Tanggal rencana tayang</label>
          <input class="berita__input" id="berita-dialog-date" type="date" value="2026-06-18" required />
        </div>
        <div>
          <label class="berita__label" for="berita-dialog-channel">Kanal publikasi</label>
          <select class="berita__select" id="berita-dialog-channel">
            <option>Instagram</option>
            <option>Situs web</option>
            <option>Facebook</option>
            <option>WhatsApp Siaran</option>
            <option>YouTube</option>
          </select>
        </div>
        <div>
          <label class="berita__label" for="berita-dialog-owner">Penanggung jawab</label>
          <select class="berita__select" id="berita-dialog-owner">
            <option>Rani Maulida</option>
            <option>Budi Santoso</option>
            <option>Dewi Lestari</option>
          </select>
        </div>
        <p class="berita__hint">Jadwal akan otomatis tercatat di Kalender Konten dan berstatus menunggu persetujuan.</p>
      </div>
      <div class="berita__dialog-foot">
        <button class="berita__btn" type="button" id="btn-cancel-dialog">Batal</button>
        <button class="berita__btn berita__btn--primary" type="submit">Simpan ke Kalender</button>
      </div>
    </form>
  </dialog>

  <p class="berita__toast" role="status" aria-live="polite" id="berita-toast" hidden></p>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const root = document.querySelector('[data-node-id="berita.root"]');
      if (!root) return;

      const tabs = root.querySelectorAll('[data-tab]');
      const panels = root.querySelectorAll('[data-panel]');
      const filterSource = root.querySelector('[data-filter-source]');
      const filterQuery = root.querySelector('[data-filter-query]');
      const feedItems = root.querySelectorAll('.berita__item');
      const feedMeta = root.querySelector('[data-feed-meta]');
      const feedEmpty = root.querySelector('[data-feed-empty]');
      const dialog = document.getElementById('adopt-dialog');
      const dialogSourceText = document.getElementById('dialog-source-text');
      const toast = document.getElementById('berita-toast');

      let currentTargetTitle = '';

      function showToast(msg) {
        if (!toast) return;
        toast.textContent = msg;
        toast.hidden = false;
        setTimeout(() => { toast.hidden = true; }, 2600);
      }

      // Tab switching
      function switchTab(targetTab) {
        tabs.forEach((t) => {
          const isSelected = t.getAttribute('data-tab') === targetTab;
          t.setAttribute('aria-selected', String(isSelected));
          t.classList.toggle('active', isSelected);
        });
        panels.forEach((p) => {
          const match = p.getAttribute('data-panel') === targetTab;
          p.hidden = !match;
        });
      }

      tabs.forEach((t) => {
        t.addEventListener('click', () => {
          switchTab(t.getAttribute('data-tab'));
        });
      });

      // Filter & Live Search
      function applyFilters() {
        const srcVal = filterSource ? filterSource.value.toLowerCase() : '';
        const qVal = filterQuery ? filterQuery.value.toLowerCase().trim() : '';
        let visible = 0;

        feedItems.forEach((item) => {
          const kind = item.getAttribute('data-kind') || '';
          const search = item.getAttribute('data-search') || '';
          const matchSrc = !srcVal || kind === srcVal;
          const matchQ = !qVal || search.includes(qVal);
          const show = matchSrc && matchQ;
          item.hidden = !show;
          if (show) visible++;
        });

        if (feedMeta) feedMeta.textContent = `Menampilkan ${visible} item dari ${feedItems.length}`;
        if (feedEmpty) feedEmpty.hidden = visible !== 0;
      }

      filterSource?.addEventListener('change', applyFilters);
      filterQuery?.addEventListener('input', applyFilters);

      // Bookmark action
      root.addEventListener('click', (e) => {
        const saveBtn = e.target.closest('[data-action="berita:save"]');
        if (saveBtn) {
          const isSaved = saveBtn.getAttribute('aria-pressed') === 'true';
          saveBtn.setAttribute('aria-pressed', String(!isSaved));
          const icon = saveBtn.querySelector('iconify-icon');
          const span = saveBtn.querySelector('span');
          if (icon) icon.setAttribute('icon', !isSaved ? 'lucide:bookmark-check' : 'lucide:bookmark');
          if (span) span.textContent = !isSaved ? 'Tersimpan' : 'Simpan';
          showToast(!isSaved ? 'Kabar disimpan ke rujukan kerja' : 'Kabar dihapus dari simpanan');
        }

        const adoptBtn = e.target.closest('[data-action="berita:adopt"]');
        if (adoptBtn) {
          currentTargetTitle = adoptBtn.getAttribute('data-title') || 'Agenda Konten';
          if (dialogSourceText) dialogSourceText.textContent = `Rencana tayang: "${currentTargetTitle}"`;
          if (dialog) dialog.showModal();
        }
      });

      document.getElementById('btn-close-dialog')?.addEventListener('click', () => {
        if (dialog) dialog.close();
      });
      document.getElementById('btn-cancel-dialog')?.addEventListener('click', () => {
        if (dialog) dialog.close();
      });

      document.getElementById('adopt-form')?.addEventListener('submit', (e) => {
        e.preventDefault();
        if (dialog) dialog.close();
        showToast(`Ide berhasil diadopsi ke Kalender Konten: "${currentTargetTitle}"`);
      });
    });
  </script>
</HumasLayout>
