---
import {
  mockContentItems as contentItems,
  mockPillars as pillars,
  mockStatusLabels as statusLabels,
  mockReminderOptions as reminderOptions,
  mockChannelPlatforms as channelPlatforms,
  mockChannelContentTypes as channelContentTypes,
  mockYoutubeSubTypes as youtubeSubTypes,
  mockInternalBidangOptions as internalBidangOptions,
} from '../lib/clientDataFetcher';
import RoleNavigation from '../components/RoleNavigation.astro';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Kalender Konten — Dasbor Humas Media</title>
  </head>
  <body>
    <RoleNavigation currentPath="/kalender-konten" />

    <main>
      <section class="toolbar">
        <div class="nav">
          <button id="prev" aria-label="Sebelumnya">‹</button>
          <button id="today-btn">Hari ini</button>
          <button id="next" aria-label="Berikutnya">›</button>
          <h2 id="title"></h2>
        </div>
        <div class="actions">
          <button id="add-btn" class="primary">+ Tambah Konten</button>
          <div class="views" role="tablist" aria-label="Tampilan kalender">
            <button data-view="day" role="tab">Harian</button>
            <button data-view="week" role="tab">Mingguan</button>
            <button data-view="month" role="tab" class="active">Bulanan</button>
          </div>
        </div>
      </section>

      <!-- Channel filter chips -->
      <section class="filter-bar" aria-label="Penyaringan Kanal Platform">
        <span class="filter-label">Filter Kanal:</span>
        <button class="channel-chip active" data-channel="all">Semua Kanal</button>
        {channelPlatforms.map((cp) => (
          <button class="channel-chip" data-channel={cp}>
            <span class="dot-channel" data-color={cp}></span>
            {cp}
          </button>
        ))}
      </section>

      <dialog id="add-dialog">
        <form id="add-form" method="dialog">
          <h3>Tambah Konten Berbasis Channeling</h3>
          <label>Judul Konten
            <input name="title" required minlength="3" placeholder="Contoh: Liputan distribusi air bersih di Posko 1" />
          </label>
          <div class="row">
            <label>Tanggal
              <input type="date" name="date" required />
            </label>
            <label>Jam Tayang
              <input type="time" name="time" required value="09:00" />
            </label>
          </div>
          <div class="row">
            <label>Platform Unggahan (Channel)
              <select name="channel" id="form-channel" required>
                {channelPlatforms.map((c) => <option value={c}>{c}</option>)}
              </select>
            </label>
            <label>Jenis Konten
              <select name="contentType" id="form-content-type" required>
                <!-- Populated dynamically based on platform -->
              </select>
            </label>
          </div>

          <!-- Dynamic conditional row for sub-tipe or bidang -->
          <div class="row" id="conditional-row" style="display: none;">
            <div id="wrapper-sub-type" style="display: none; flex: 1;">
              <label>Sub-Tipe Konten
                <select name="subType" id="form-sub-type">
                  <!-- Populated dynamically for YouTube -->
                </select>
              </label>
            </div>
            <div id="wrapper-bidang" style="display: none; flex: 1;">
              <label>Bidang Pemohon (Request Bidang)
                <select name="requestBidang" id="form-request-bidang">
                  {internalBidangOptions.map((b) => <option value={b}>{b}</option>)}
                </select>
              </label>
            </div>
          </div>

          <div class="row">
            <label>Pilar Konten
              <select name="pillarId">
                {pillars.map((p) => <option value={p.id}>{p.name}</option>)}
              </select>
            </label>
            <label>Status
              <select name="status">
                {Object.entries(statusLabels).map(([k, v]) => <option value={k}>{v}</option>)}
              </select>
            </label>
          </div>
          <div class="row">
            <label>Penanggung jawab (PIC)
              <input name="assignee" placeholder="Contoh: Budi, Dewi, Sari" />
            </label>
            <label>Pengingat Tayang
              <select name="remindBefore">
                {reminderOptions.map((o) => <option value={o.value}>{o.label}</option>)}
              </select>
            </label>
          </div>
          <div class="row end">
            <button type="button" id="cancel-btn">Batal</button>
            <button type="submit" class="primary">Simpan Jadwal</button>
          </div>
        </form>
      </dialog>

      <div class="legend">
        <span class="legend-title">Pilar:</span>
        {pillars.map((p) => (
          <span class="chip" data-pillar={p.id} title="Klik untuk menyaring pilar"><i style={`background:${p.color}`}></i>{p.name}</span>
        ))}
      </div>

      <section id="calendar" class="calendar" aria-live="polite"></section>
      <section id="channel-summary" class="summary" aria-label="Ringkasan distribusi kanal"></section>
      <section id="reminders" class="summary" aria-label="Daftar pengingat"></section>
      <section id="summary" class="summary" aria-label="Ringkasan komposisi pilar"></section>
      <section id="members" class="summary" aria-label="Daftar konten per anggota tim"></section>
    </main>

    <script
      is:inline
      define:vars={{
        items: contentItems,
        pillars,
        statusLabels,
        reminderOptions,
        channelPlatforms,
        channelContentTypes,
        youtubeSubTypes,
        internalBidangOptions
      }}
    >
      const TODAY = new Date(2026, 9, 10); // tanggal acuan data tiruan
      const dayNames = ['Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab', 'Min'];
      const monthNames = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
      const longDay = ['Minggu','Senin','Selasa','Rabu','Kamis','Jumat','Sabtu'];

      let view = 'month';
      let cursor = new Date(TODAY);
      let selectedChannel = 'all';

      const el = document.getElementById('calendar');
      const titleEl = document.getElementById('title');

      const iso = (d) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
      const addDays = (d, n) => { const x = new Date(d); x.setDate(x.getDate() + n); return x; };
      const startOfWeek = (d) => addDays(d, -((d.getDay() + 6) % 7));
      const pillar = (id) => pillars.find((p) => p.id === id) || { name: 'Umum', color: '#6b7280' };
      const hiddenPillars = new Set();

      const itemsOn = (d) => items.filter((c) => {
        if (c.date !== iso(d)) return false;
        if (hiddenPillars.has(c.pillarId)) return false;
        if (selectedChannel !== 'all' && c.channel !== selectedChannel) return false;
        return true;
      }).sort((a, b) => a.time.localeCompare(b.time));

      const esc = (s) => (s || '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

      // Format detail channeling badge
      const formatChannelBadge = (c) => {
        let text = esc(c.channel);
        if (c.contentType) {
          text += ` · ${esc(c.contentType)}`;
        }
        if (c.subType) {
          text += ` (${esc(c.subType)})`;
        }
        if (c.requestBidang) {
          text += ` [Bidang: ${esc(c.requestBidang)}]`;
        }
        return text;
      };

      const eventHtml = (c, detailed) => `
        <div class="event ${c.assignee ? '' : 'unassigned'}" draggable="true" data-id="${c.id}" style="border-left-color:${pillar(c.pillarId).color}" title="${esc(c.title)} — ${formatChannelBadge(c)}${c.assignee ? '' : ' — belum ditugaskan'}">
          <div class="event-header">
            <span class="badge" style="background:${pillar(c.pillarId).color}1a;color:${pillar(c.pillarId).color}">${esc(pillar(c.pillarId).name)}</span>
            <span class="chan-tag chan-${esc(c.channel).toLowerCase().replace(/[^a-z0-9]/g, '')}">${esc(c.channel)}</span>
          </div>
          <b>${c.time}</b> ${esc(c.title)}
          <div class="chan-meta">
            ${c.contentType ? `<span class="content-type-badge">${esc(c.contentType)}</span>` : ''}
            ${c.subType ? `<span class="sub-type-badge">${esc(c.subType)}</span>` : ''}
            ${c.requestBidang ? `<span class="bidang-badge">${esc(c.requestBidang)}</span>` : ''}
          </div>
          <small>${statusLabels[c.status] || c.status}${detailed ? ` · ${esc(pillar(c.pillarId).name)}` : ''}</small>
          <small class="who">${c.assignee ? `👤 ${esc(c.assignee)}` : '<span class="warn">⚠ Belum ditugaskan</span>'}${c.remindBefore ? ` · <span title="Pengingat">🔔 ${(reminderOptions.find((o) => o.value === c.remindBefore) || { label: '' }).label.replace(' sebelumnya', '')}</span>` : ''}</small>
        </div>`;

      function renderMonth() {
        const y = cursor.getFullYear(), m = cursor.getMonth();
        titleEl.textContent = `${monthNames[m]} ${y}`;
        const first = new Date(y, m, 1);
        const start = startOfWeek(first);
        const total = Math.ceil(((first.getDay() + 6) % 7 + new Date(y, m + 1, 0).getDate()) / 7) * 7;
        let html = dayNames.map((d) => `<div class="dow">${d}</div>`).join('');
        for (let i = 0; i < total; i++) {
          const d = addDays(start, i);
          const other = d.getMonth() !== m;
          html += `<div class="cell ${other ? 'empty' : ''} ${iso(d) === iso(TODAY) ? 'today' : ''}" data-date="${iso(d)}">
            <span class="num">${d.getDate()}</span>${itemsOn(d).map((c) => eventHtml(c, false)).join('')}</div>`;
        }
        el.className = 'calendar month';
        el.innerHTML = html;
      }

      function renderWeek() {
        const start = startOfWeek(cursor);
        const end = addDays(start, 6);
        titleEl.textContent = `${start.getDate()} ${monthNames[start.getMonth()]} – ${end.getDate()} ${monthNames[end.getMonth()]} ${end.getFullYear()}`;
        let html = '';
        for (let i = 0; i < 7; i++) {
          const d = addDays(start, i);
          html += `<div class="dow ${iso(d) === iso(TODAY) ? 'today-h' : ''}">${dayNames[i]} ${d.getDate()}</div>`;
        }
        for (let i = 0; i < 7; i++) {
          const d = addDays(start, i);
          html += `<div class="cell tall ${iso(d) === iso(TODAY) ? 'today' : ''}" data-date="${iso(d)}">${itemsOn(d).map((c) => eventHtml(c, false)).join('') || '<span class="none">—</span>'}</div>`;
        }
        el.className = 'calendar week';
        el.innerHTML = html;
      }

      function renderDay() {
        titleEl.textContent = `${longDay[cursor.getDay()]}, ${cursor.getDate()} ${monthNames[cursor.getMonth()]} ${cursor.getFullYear()}`;
        const list = itemsOn(cursor);
        el.className = 'calendar day';
        el.innerHTML = list.length
          ? `<div class="daylist">${list.map((c) => eventHtml(c, true)).join('')}</div>`
          : '<p class="none">Tidak ada konten dijadwalkan pada hari ini untuk filter yang dipilih.</p>';
      }

      function periodRange() {
        if (view === 'month') return [new Date(cursor.getFullYear(), cursor.getMonth(), 1), new Date(cursor.getFullYear(), cursor.getMonth() + 1, 0)];
        if (view === 'week') { const s = startOfWeek(cursor); return [s, addDays(s, 6)]; }
        return [cursor, cursor];
      }

      // Ringkasan per kanal & jenis konten
      function renderChannelSummary() {
        const [from, to] = periodRange();
        const inRange = items.filter((c) => c.date >= iso(from) && c.date <= iso(to));
        const total = inRange.length;
        const channelCounts = {};
        channelPlatforms.forEach((cp) => { channelCounts[cp] = 0; });
        inRange.forEach((c) => {
          if (channelCounts[c.channel] !== undefined) {
            channelCounts[c.channel]++;
          }
        });

        const cards = channelPlatforms.map((cp) => {
          const count = channelCounts[cp] || 0;
          const pct = total ? Math.round((count / total) * 100) : 0;
          // breakdowns by type in this channel
          const itemsThisChan = inRange.filter((c) => c.channel === cp);
          const typeMap = {};
          itemsThisChan.forEach((it) => {
            const key = it.contentType || 'Lainnya';
            typeMap[key] = (typeMap[key] || 0) + 1;
          });
          const typeTags = Object.entries(typeMap).map(([k, v]) => `<span>${esc(k)}: <b>${v}</b></span>`).join('');

          return `
            <div class="channel-card ${selectedChannel === cp ? 'selected' : ''}" data-channel-target="${cp}">
              <div class="card-head">
                <b>${esc(cp)}</b>
                <span class="count-pill">${count} konten (${pct}%)</span>
              </div>
              <div class="progress-line"><span style="width:${pct}%"></span></div>
              <div class="card-types">${typeTags || '<small class="none">Belum ada konten</small>'}</div>
            </div>
          `;
        }).join('');

        document.getElementById('channel-summary').innerHTML = `
          <h3>Distribusi Channeling Platform <small>· ${total} konten periode aktif</small></h3>
          <div class="channel-cards-grid">${cards}</div>
        `;
      }

      function renderSummary() {
        const [from, to] = periodRange();
        const inRange = items.filter((c) => c.date >= iso(from) && c.date <= iso(to));
        const label = { month: 'bulan ini', week: 'pekan ini', day: 'hari ini' }[view];
        const total = inRange.length;
        const rows = pillars.map((p) => {
          const n = inRange.filter((c) => c.pillarId === p.id).length;
          const pct = total ? Math.round((n / total) * 100) : 0;
          return `<div class="srow"><span class="sname"><i style="background:${p.color}"></i>${esc(p.name)}</span>
            <span class="bar"><span style="width:${pct}%;background:${p.color}"></span></span>
            <span class="sval">${n} (${pct}%)</span></div>`;
        }).join('');
        document.getElementById('summary').innerHTML = `<h3>Komposisi Pilar ${label} <small>· ${total} konten</small></h3>${rows}`;
      }

      function renderMembers() {
        const [from, to] = periodRange();
        const inRange = items
          .filter((c) => c.date >= iso(from) && c.date <= iso(to) && !hiddenPillars.has(c.pillarId))
          .sort((a, b) => (a.date + a.time).localeCompare(b.date + b.time));
        const groups = new Map();
        inRange.forEach((c) => {
          const key = c.assignee || '';
          if (!groups.has(key)) groups.set(key, []);
          groups.get(key).push(c);
        });
        const names = [...groups.keys()].sort((a, b) => (a === '' ? 1 : b === '' ? -1 : a.localeCompare(b)));
        const body = names.map((n) => `
          <div class="mgroup ${n ? '' : 'unassigned-group'}">
            <h4>${n ? `👤 ${esc(n)}` : '⚠ Belum ditugaskan'} <small>${groups.get(n).length} konten</small></h4>
            <ul>${groups.get(n).map((c) => `<li><b>${c.date.slice(8)}/${c.date.slice(5, 7)} ${c.time}</b> ${esc(c.title)}
              <small>${formatChannelBadge(c)} · ${statusLabels[c.status] || c.status}</small></li>`).join('')}</ul>
          </div>`).join('');
        document.getElementById('members').innerHTML = `<h3>Konten per Anggota Tim</h3>${body || '<p class="none">Tidak ada konten pada periode ini.</p>'}`;
      }

      const reminderAt = (c) => {
        const [y, m, d] = c.date.split('-').map(Number);
        const [hh, mm] = c.time.split(':').map(Number);
        return new Date(new Date(y, m - 1, d, hh, mm).getTime() - (c.remindBefore || 0) * 60000);
      };
      const fmtDT = (dt) => `${String(dt.getDate()).padStart(2, '0')}/${String(dt.getMonth() + 1).padStart(2, '0')} ${String(dt.getHours()).padStart(2, '0')}:${String(dt.getMinutes()).padStart(2, '0')}`;
      const NOW = new Date(2026, 9, 10, 21, 0);

      function renderReminders() {
        const list = items.filter((c) => c.remindBefore).sort((a, b) => reminderAt(a) - reminderAt(b));
        const pending = list.filter((c) => !c.reminderDone);
        const done = list.filter((c) => c.reminderDone);
        const row = (c) => {
          const at = reminderAt(c);
          const overdue = !c.reminderDone && at < NOW;
          return `<li class="rem ${c.reminderDone ? 'rem-done' : ''} ${overdue ? 'rem-overdue' : ''}">
            <span class="rem-main"><b>${esc(c.title)}</b>
              <small>🔔 ${fmtDT(at)} · tayang ${c.date.slice(8)}/${c.date.slice(5, 7)} ${c.time} · [${formatChannelBadge(c)}] · ${c.assignee ? esc(c.assignee) : 'belum ditugaskan'}${overdue ? ' · <span class="warn">terlewat</span>' : ''}</small></span>
            <button data-remind-toggle="${c.id}">${c.reminderDone ? 'Batalkan' : 'Tandai selesai'}</button>
          </li>`;
        };
        document.getElementById('reminders').innerHTML = `<h3>Pengingat Tayang <small>· ${pending.length} aktif, ${done.length} selesai</small></h3>
          ${list.length ? `<ul class="rem-list">${[...pending, ...done].map(row).join('')}</ul>` : '<p class="none">Belum ada pengingat.</p>'}`;
      }

      document.getElementById('reminders').addEventListener('click', (e) => {
        const btn = e.target.closest('[data-remind-toggle]');
        if (!btn) return;
        const item = items.find((c) => c.id === Number(btn.dataset.remindToggle));
        if (item) { item.reminderDone = !item.reminderDone; renderReminders(); }
      });

      function render() {
        document.querySelectorAll('[data-view]').forEach((b) => b.classList.toggle('active', b.dataset.view === view));
        ({ month: renderMonth, week: renderWeek, day: renderDay })[view]();
        renderChannelSummary();
        renderReminders();
        renderSummary();
        renderMembers();
      }

      function shift(dir) {
        if (view === 'month') cursor = new Date(cursor.getFullYear(), cursor.getMonth() + dir, 1);
        else cursor = addDays(cursor, dir * (view === 'week' ? 7 : 1));
        render();
      }

      document.getElementById('prev').onclick = () => shift(-1);
      document.getElementById('next').onclick = () => shift(1);
      document.getElementById('today-btn').onclick = () => { cursor = new Date(TODAY); render(); };
      document.querySelectorAll('[data-view]').forEach((b) => (b.onclick = () => { view = b.dataset.view; render(); }));

      // --- Filter Kanal ---
      document.querySelectorAll('.channel-chip').forEach((chip) => {
        chip.addEventListener('click', () => {
          document.querySelectorAll('.channel-chip').forEach((c) => c.classList.remove('active'));
          chip.classList.add('active');
          selectedChannel = chip.dataset.channel;
          render();
        });
      });

      // Klik kartu di channel-summary juga memfilter kanal langsung
      document.getElementById('channel-summary').addEventListener('click', (e) => {
        const card = e.target.closest('[data-channel-target]');
        if (!card) return;
        const target = card.dataset.channelTarget;
        selectedChannel = selectedChannel === target ? 'all' : target;
        document.querySelectorAll('.channel-chip').forEach((c) => {
          c.classList.toggle('active', c.dataset.channel === selectedChannel);
        });
        render();
      });

      // --- Dinamika Form Kanal & Jenis Konten ---
      const dialog = document.getElementById('add-dialog');
      const form = document.getElementById('add-form');
      const formChannel = document.getElementById('form-channel');
      const formContentType = document.getElementById('form-content-type');
      const formSubType = document.getElementById('form-sub-type');
      const formRequestBidang = document.getElementById('form-request-bidang');
      const condRow = document.getElementById('conditional-row');
      const wrapSubType = document.getElementById('wrapper-sub-type');
      const wrapBidang = document.getElementById('wrapper-bidang');

      function updateFormFields() {
        const selChan = formChannel.value;
        const types = channelContentTypes[selChan] || [];
        formContentType.innerHTML = types.map((t) => `<option value="${t}">${t}</option>`).join('');

        updateSubFields();
      }

      function updateSubFields() {
        const selChan = formChannel.value;
        const selType = formContentType.value;

        let hasCond = false;

        // Cek YouTube sub-types
        if (selChan === 'YouTube' && youtubeSubTypes[selType]) {
          const subs = youtubeSubTypes[selType];
          formSubType.innerHTML = subs.map((s) => `<option value="${s}">${s}</option>`).join('');
          wrapSubType.style.display = 'block';
          hasCond = true;
        } else {
          wrapSubType.style.display = 'none';
          formSubType.innerHTML = '';
        }

        // Cek Kebutuhan Internal request bidang
        if (selChan === 'Kebutuhan Internal' && selType === 'desain request bidang') {
          wrapBidang.style.display = 'block';
          hasCond = true;
        } else {
          wrapBidang.style.display = 'none';
        }

        condRow.style.display = hasCond ? 'flex' : 'none';
      }

      formChannel.addEventListener('change', updateFormFields);
      formContentType.addEventListener('change', updateSubFields);

      const openForm = (dateStr) => {
        form.reset();
        form.elements.date.value = dateStr || iso(cursor);
        updateFormFields();
        dialog.showModal();
      };

      document.getElementById('add-btn').onclick = () => openForm();
      document.getElementById('cancel-btn').onclick = () => dialog.close();

      el.addEventListener('click', (e) => {
        if (e.target.closest('.event')) return;
        const cell = e.target.closest('[data-date]');
        if (cell) openForm(cell.dataset.date);
      });

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;
        const f = new FormData(form);

        const newItem = {
          id: Date.now(),
          title: f.get('title').trim(),
          date: f.get('date'),
          time: f.get('time'),
          channel: f.get('channel'),
          contentType: f.get('contentType') || undefined,
          subType: f.get('subType') || undefined,
          requestBidang: f.get('requestBidang') || undefined,
          pillarId: Number(f.get('pillarId')),
          assignee: f.get('assignee').trim(),
          status: f.get('status'),
          remindBefore: Number(f.get('remindBefore')) || 0,
        };

        // Simpan ke API jika server aktif
        try {
          const scheduled_at = `${newItem.date} ${newItem.time}:00`;
          await fetch('/api/content', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              title: newItem.title,
              scheduled_at,
              channel: newItem.channel,
              content_type: newItem.contentType,
              sub_type: newItem.subType,
              request_bidang: newItem.requestBidang,
              pillar_id: newItem.pillarId,
              status: newItem.status,
              remind_before: newItem.remindBefore,
            }),
          });
        } catch (_) {}

        items.push(newItem);
        const [y, m, d] = f.get('date').split('-').map(Number);
        cursor = new Date(y, m - 1, d);
        dialog.close();
        render();
      });

      // --- Geser jadwal (drag and drop) ---
      let dragId = null;
      el.addEventListener('dragstart', (e) => {
        const ev = e.target.closest('.event');
        if (!ev) return;
        dragId = Number(ev.dataset.id);
        e.dataTransfer.effectAllowed = 'move';
        e.dataTransfer.setData('text/plain', String(dragId));
        ev.classList.add('dragging');
      });
      el.addEventListener('dragend', () => {
        dragId = null;
        el.querySelectorAll('.dragging, .drop-over').forEach((n) => n.classList.remove('dragging', 'drop-over'));
      });
      el.addEventListener('dragover', (e) => {
        const cell = e.target.closest('[data-date]');
        if (!cell || dragId === null) return;
        e.preventDefault();
        el.querySelectorAll('.drop-over').forEach((n) => n !== cell && n.classList.remove('drop-over'));
        cell.classList.add('drop-over');
      });
      el.addEventListener('drop', async (e) => {
        const cell = e.target.closest('[data-date]');
        if (!cell || dragId === null) return;
        e.preventDefault();
        const item = items.find((c) => c.id === dragId);
        if (item && item.date !== cell.dataset.date) {
          item.date = cell.dataset.date;
          try {
            await fetch(`/api/content/${item.id}`, {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ scheduled_at: `${item.date} ${item.time}:00` }),
            });
          } catch (_) {}
          render();
        }
        dragId = null;
      });

      // --- Saring berdasarkan pilar lewat legenda ---
      document.querySelectorAll('.chip[data-pillar]').forEach((chip) => {
        chip.onclick = () => {
          const id = Number(chip.dataset.pillar);
          if (hiddenPillars.has(id)) hiddenPillars.delete(id); else hiddenPillars.add(id);
          chip.classList.toggle('off', hiddenPillars.has(id));
          render();
        };
      });

      // Sinkronisasi dinamis dari API /api/content
      async function syncContentFromApi() {
        try {
          const res = await fetch('/api/content');
          if (!res.ok) return;
          const json = await res.json();
          if (json && json.data && Array.isArray(json.data) && json.data.length > 0) {
            const mapped = json.data.map((row) => ({
              id: row.id,
              title: row.title,
              date: (row.scheduled_at || '').slice(0, 10),
              time: (row.scheduled_at || '').slice(11, 16) || '09:00',
              channel: row.channel,
              contentType: row.content_type || undefined,
              subType: row.sub_type || undefined,
              requestBidang: row.request_bidang || undefined,
              pillarId: row.pillar_id,
              assignee: row.assignee_name || '',
              status: row.status || 'draft',
              remindBefore: row.remind_before || 0,
            }));
            items.length = 0;
            items.push(...mapped);
            render();
          }
        } catch (_) {}
      }

      render();
      syncContentFromApi();
    </script>
  </body>
</html>

