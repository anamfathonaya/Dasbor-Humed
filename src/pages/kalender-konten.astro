---
import HumasLayout from '../layouts/HumasLayout.astro';
---

<HumasLayout
  title="Kalender Konten — Humas Internal Peduli Negeri"
  pageTitle="Kalender Konten"
  pageSubtitle="Jadwal editorial publikasi multi-kanal · Sinkronisasi Gemini, Google Calendar & Sheets"
  currentPath="/kalender-konten"
  pageContentId="kalender-konten"
>
  <div class="kal" data-node-id="kal.root">
    <!-- Kontrol Toolbar Kalender -->
    <section class="kal__bar" aria-label="Kendali kalender">
      <div class="kal__nav">
        <button class="kal__btn kal__btn--icon" type="button" data-action="kal:prev" aria-label="Bulan sebelumnya">
          <iconify-icon icon="lucide:chevron-left" aria-hidden="true"></iconify-icon>
        </button>
        <h2 class="kal__month" data-month-label id="month-label">Juni 2026</h2>
        <button class="kal__btn kal__btn--icon" type="button" data-action="kal:next" aria-label="Bulan berikutnya">
          <iconify-icon icon="lucide:chevron-right" aria-hidden="true"></iconify-icon>
        </button>
        <button class="kal__btn" type="button" data-action="kal:today">Hari ini</button>
      </div>

      <span class="kal__sync" data-state="synced" data-sync-badge>
        <iconify-icon icon="lucide:refresh-cw" aria-hidden="true"></iconify-icon>
        <span data-sync-text>Tersinkron · Calendar & Sheets</span>
      </span>

      <button class="kal__btn kal__btn--primary" type="button" data-action="kal:create">
        <iconify-icon icon="lucide:plus" aria-hidden="true"></iconify-icon> Jadwal baru
      </button>

      <div class="kal__legend">
        <span><i class="kal__dot" style="background:var(--color-neutral, #5a6875)"></i>Draf</span>
        <span><i class="kal__dot" style="background:var(--color-warning, #8a5300)"></i>Review</span>
        <span><i class="kal__dot" style="background:var(--color-success, #17683f)"></i>Terbit</span>
      </div>
    </section>

    <!-- Baris Filter Platform -->
    <section class="kal__filters" aria-label="Filter platform unggahan">
      <p class="kal__filters-title" id="kal-filter-title">Platform</p>
      <div role="group" aria-labelledby="kal-filter-title" style="display:flex;align-items:center;gap:var(--space-2,8px);flex-wrap:wrap;min-width:0;">
        <button class="kal__plat" type="button" data-action="kal:filter" data-platform="all" aria-pressed="true">Semua platform <span class="kal__plat-count" data-count="all">0</span></button>
        <button class="kal__plat" type="button" data-action="kal:filter" data-platform="instagram" aria-pressed="false" style="--kal-plat:#c2417a"><i class="kal__plat-dot" aria-hidden="true"></i>Instagram <span class="kal__plat-count" data-count="instagram">0</span></button>
        <button class="kal__plat" type="button" data-action="kal:filter" data-platform="whatsapp" aria-pressed="false" style="--kal-plat:#1f8a5b"><i class="kal__plat-dot" aria-hidden="true"></i>WhatsApp <span class="kal__plat-count" data-count="whatsapp">0</span></button>
        <button class="kal__plat" type="button" data-action="kal:filter" data-platform="facebook" aria-pressed="false" style="--kal-plat:#2f6ea8"><i class="kal__plat-dot" aria-hidden="true"></i>Facebook <span class="kal__plat-count" data-count="facebook">0</span></button>
        <button class="kal__plat" type="button" data-action="kal:filter" data-platform="threads" aria-pressed="false" style="--kal-plat:#4a5560"><i class="kal__plat-dot" aria-hidden="true"></i>Threads <span class="kal__plat-count" data-count="threads">0</span></button>
        <button class="kal__plat" type="button" data-action="kal:filter" data-platform="x" aria-pressed="false" style="--kal-plat:#16202b"><i class="kal__plat-dot" aria-hidden="true"></i>X <span class="kal__plat-count" data-count="x">0</span></button>
        <button class="kal__plat" type="button" data-action="kal:filter" data-platform="youtube" aria-pressed="false" style="--kal-plat:#b3322c"><i class="kal__plat-dot" aria-hidden="true"></i>YouTube <span class="kal__plat-count" data-count="youtube">0</span></button>
        <button class="kal__plat" type="button" data-action="kal:filter" data-platform="website" aria-pressed="false" style="--kal-plat:#5a6875"><i class="kal__plat-dot" aria-hidden="true"></i>Website <span class="kal__plat-count" data-count="website">0</span></button>
        <button class="kal__plat" type="button" data-action="kal:filter" data-platform="internal" aria-pressed="false" style="--kal-plat:#6b5ca5"><i class="kal__plat-dot" aria-hidden="true"></i>Kebutuhan internal <span class="kal__plat-count" data-count="internal">0</span></button>
      </div>
      <p style="margin:0 0 0 auto;font-size:var(--text-2xs,11px);color:var(--color-text-subtle,#7a8794);white-space:nowrap;" data-filter-summary>Menampilkan seluruh jadwal bulan ini</p>
    </section>

    <!-- Grid Kalender & Panel Detail Samping -->
    <div class="kal__layout">
      <section class="kal__grid" aria-labelledby="kal-grid-title" data-node-id="kal.grid">
        <h2 id="kal-grid-title" class="text-caption" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">Grid kalender bulanan</h2>
        <div class="kal__dow" aria-hidden="true">
          <span>Sen</span><span>Sel</span><span>Rab</span><span>Kam</span><span>Jum</span><span>Sab</span><span>Min</span>
        </div>
        <div class="kal__days" data-days id="calendar-days"></div>
      </section>

      <aside class="kal__side" aria-labelledby="kal-side-title" data-node-id="kal.detail">
        <h2 id="kal-side-title">Detail Jadwal Hari Ini</h2>
        <p class="kal__side-date" data-selected-date id="selected-date-label">Pilih tanggal atau kartu jadwal pada kalender.</p>
        <div data-detail-list id="detail-list-container">
          <p class="kal__empty" data-detail-empty id="detail-empty">Belum ada jadwal pada tanggal ini. Klik tanggal untuk menambah jadwal baru.</p>
        </div>
      </aside>
    </div>
  </div>

  <!-- Dialog Form Tambah / Ubah Jadwal -->
  <dialog class="kal__dialog" id="kal-dialog" data-node-id="kal.dialog" aria-labelledby="kal-dialog-title">
    <div class="kal__dialog-head">
      <div>
        <h2 id="kal-dialog-title" data-dialog-title>Jadwal Konten Baru</h2>
        <p data-dialog-sub id="kal-dialog-sub">Lengkapi detail jadwal lalu simpan.</p>
      </div>
      <button class="kal__close" type="button" data-action="kal:close" id="btn-close-kal" aria-label="Tutup dialog">
        <iconify-icon icon="lucide:x" aria-hidden="true"></iconify-icon>
      </button>
    </div>
    <form method="dialog" id="kal-form" data-dialog-form novalidate>
      <div class="kal__dialog-body">
        <div>
          <label class="kal__label" for="kal-judul">Judul konten</label>
          <input class="kal__input" id="kal-judul" type="text" placeholder="Contoh: Liputan distribusi air bersih di Posko 1" required data-input="judul" />
          <p style="margin:6px 0 0;font-size:var(--text-2xs,11px);color:var(--color-danger,#a52a24)" id="error-judul" hidden>Judul konten wajib diisi.</p>
        </div>
        <div class="kal__grid2">
          <div>
            <label class="kal__label" for="kal-tanggal">Tanggal tayang</label>
            <input class="kal__input" id="kal-tanggal" type="date" required data-input="tanggal" />
          </div>
          <div>
            <label class="kal__label" for="kal-waktu">Waktu</label>
            <input class="kal__input" id="kal-waktu" type="time" value="09:00" data-input="waktu" />
          </div>
        </div>
        <div class="kal__grid2">
          <div>
            <label class="kal__label" for="kal-platform">Platform unggahan</label>
            <select class="kal__select" id="kal-platform" data-input="platform">
              <option value="instagram">Instagram</option>
              <option value="whatsapp">WhatsApp</option>
              <option value="facebook">Facebook</option>
              <option value="threads">Threads</option>
              <option value="x">X</option>
              <option value="youtube">YouTube</option>
              <option value="website">Website</option>
              <option value="internal">Kebutuhan internal</option>
            </select>
          </div>
          <div>
            <label class="kal__label" for="kal-status">Status</label>
            <select class="kal__select" id="kal-status" data-input="status">
              <option value="draf">Draf</option>
              <option value="review">Review</option>
              <option value="terbit">Terbit</option>
            </select>
          </div>
        </div>
        <div class="kal__subfield">
          <div>
            <label class="kal__label" for="kal-jenis">Jenis konten</label>
            <select class="kal__select" id="kal-jenis" data-input="jenis"></select>
          </div>
          <div data-subfield="subtipe" id="wrap-subtipe" hidden>
            <label class="kal__label" for="kal-subtipe">Sub-tipe <span style="font-weight:400">(opsional)</span></label>
            <select class="kal__select" id="kal-subtipe" data-input="subtipe"></select>
          </div>
          <p class="kal__hint" id="wa-hint" hidden></p>
        </div>
        <fieldset class="kal__fieldset" id="fieldset-wa" hidden>
          <legend class="kal__legend2">Penanda WhatsApp</legend>
          <label class="kal__check" for="kal-wa-ads">
            <input type="checkbox" id="kal-wa-ads" data-input="iklan" />
            Iklan berbayar (WhatsApp Ads)
          </label>
          <label class="kal__check" for="kal-wa-crm">
            <input type="checkbox" id="kal-wa-crm" data-input="crm" />
            Pesan CRM / marketing blast
          </label>
          <div class="kal__fieldrow" data-fieldrow="segment">
            <div>
              <label class="kal__label" for="kal-segmen">Segmen penerima <span style="font-weight:400">(opsional)</span></label>
              <input class="kal__input" id="kal-segmen" type="text" placeholder="Contoh: donatur aktif 12 bulan" data-input="segmen" />
            </div>
          </div>
        </fieldset>
        <div>
          <label class="kal__label" for="kal-pj">Penanggung jawab</label>
          <select class="kal__select" id="kal-pj" data-input="pj">
            <option>Rani Maulida</option>
            <option>Budi Santoso</option>
            <option>Dewi Lestari</option>
          </select>
        </div>
        <div>
          <label class="kal__label" for="kal-catatan">Catatan <span style="font-weight:400">(opsional)</span></label>
          <textarea class="kal__textarea" id="kal-catatan" placeholder="Bahan, arahan pimpinan, atau link aset DAM" data-input="catatan"></textarea>
        </div>
      </div>
      <div class="kal__dialog-foot">
        <button class="kal__btn" type="button" id="btn-delete-kal" hidden data-delete-btn>
          <iconify-icon icon="lucide:trash-2" aria-hidden="true"></iconify-icon> Hapus jadwal
        </button>
        <span style="display:flex;gap:var(--space-2,8px);margin-left:auto;flex-wrap:wrap">
          <button class="kal__btn" type="button" id="btn-cancel-kal">Batal</button>
          <button class="kal__btn kal__btn--primary" type="submit">Simpan jadwal</button>
        </span>
      </div>
    </form>
  </dialog>

  <p class="kal__toast" role="status" aria-live="polite" id="kal-toast" hidden></p>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const kal = document.querySelector('[data-node-id="kal.root"]');
      if (!kal) return;

      const MONTHS = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
      const daysWrap = document.getElementById('calendar-days');
      const monthLabel = document.getElementById('month-label');
      const sideDate = document.getElementById('selected-date-label');
      const detailList = document.getElementById('detail-list-container');
      const detailEmpty = document.getElementById('detail-empty');
      const dialog = document.getElementById('kal-dialog');
      const dialogTitle = document.getElementById('kal-dialog-title');
      const dialogForm = document.getElementById('kal-form');
      const deleteBtn = document.getElementById('btn-delete-kal');
      const toast = document.getElementById('kal-toast');
      const filterSummary = kal.querySelector('[data-filter-summary]');

      const inputJudul = document.getElementById('kal-judul');
      const inputTanggal = document.getElementById('kal-tanggal');
      const inputWaktu = document.getElementById('kal-waktu');
      const inputPlatform = document.getElementById('kal-platform');
      const inputStatus = document.getElementById('kal-status');
      const inputJenis = document.getElementById('kal-jenis');
      const inputSubtipe = document.getElementById('kal-subtipe');
      const wrapSubtipe = document.getElementById('wrap-subtipe');
      const fieldsetWa = document.getElementById('fieldset-wa');
      const inputWaAds = document.getElementById('kal-wa-ads');
      const inputWaCrm = document.getElementById('kal-wa-crm');
      const inputSegmen = document.getElementById('kal-segmen');
      const inputPj = document.getElementById('kal-pj');
      const inputCatatan = document.getElementById('kal-catatan');

      const PLATFORMS = {
        instagram: { label: 'Instagram', color: '#c2417a', types: ['Reels', 'Carousel (image)', 'Single image post', 'Story', 'Carousel (short video)'] },
        whatsapp: { label: 'WhatsApp', color: '#1f8a5b', types: ['Video', 'Foto', 'Status', 'Channel post', 'Community post'] },
        facebook: { label: 'Facebook', color: '#2f6ea8', types: ['Reels', 'Carousel (image)', 'Single image post', 'Story', 'Long video'] },
        threads: { label: 'Threads', color: '#4a5560', types: ['Artikel panjang', 'Short video', 'Carousel (image)', 'Single image post'] },
        x: { label: 'X', color: '#16202b', types: ['Artikel panjang', 'Short video', 'Single image post'] },
        youtube: { label: 'YouTube', color: '#b3322c', types: ['Video panjang', 'Video pendek', 'YouTube Shorts'] },
        website: { label: 'Website', color: '#5a6875', types: ['Siaran pers', 'Artikel', 'Tanya jawab', 'Infografis'] },
        internal: { label: 'Kebutuhan internal', color: '#6b5ca5', types: ['Set desain program', 'Brand identity', 'Video kegiatan internal', 'Desain proposal'] }
      };

      let activePlatform = 'all';
      let now = new Date();
      let view = { year: now.getFullYear(), month: now.getMonth() };
      let selectedDate = new Date().toISOString().slice(0, 10);
      let editingId = null;

      const pad = (n) => String(n).padStart(2, '0');
      const key = (y, m, d) => y + '-' + pad(m + 1) + '-' + pad(d);

      let schedules = [
        { id: 'k1', date: '2026-06-03', title: 'Siaran pers program literasi digital', platform: 'website', jenis: 'Siaran pers', status: 'terbit', pj: 'Rani Maulida', waktu: '09:00', catatan: 'Naskah final dari unit program.' },
        { id: 'k2', date: '2026-06-05', title: 'Capaian layanan triwulan', platform: 'instagram', jenis: 'Carousel (image)', status: 'terbit', pj: 'Budi Santoso', waktu: '11:30', catatan: '' },
        { id: 'k3', date: '2026-06-08', title: 'Reminder donasi akhir pekan', platform: 'whatsapp', jenis: 'Channel post', status: 'terbit', pj: 'Dewi Lestari', waktu: '07:30', catatan: 'Tautan donasi aktif.' },
        { id: 'k4', date: '2026-06-10', title: 'Mitigasi bencana ringkas', platform: 'x', jenis: 'Short video', status: 'terbit', pj: 'Dewi Lestari', waktu: '16:00', catatan: '' },
        { id: 'k5', date: '2026-06-12', title: 'Artikel penjelasan anggaran daerah', platform: 'website', jenis: 'Artikel', status: 'review', pj: 'Budi Santoso', waktu: '10:00', catatan: 'Menunggu persetujuan.' },
        { id: 'k6', date: '2026-06-12', title: 'Kunjungan kerja lapangan', platform: 'instagram', jenis: 'Reels', status: 'draf', pj: 'Dewi Lestari', waktu: '14:30', catatan: '' },
        { id: 'k7', date: '2026-06-15', title: 'Set desain kampanye Ramadhan', platform: 'internal', jenis: 'Set desain program', status: 'draf', pj: 'Rani Maulida', waktu: '10:30', catatan: '' },
        { id: 'k8', date: '2026-06-16', title: 'Ringkasan program prioritas', platform: 'threads', jenis: 'Artikel panjang', status: 'draf', pj: 'Rani Maulida', waktu: '13:00', catatan: '' },
        { id: 'k9', date: '2026-06-18', title: 'Infografis capaian layanan', platform: 'facebook', jenis: 'Single image post', status: 'review', pj: 'Budi Santoso', waktu: '09:30', catatan: '' },
        { id: 'k12', date: '2026-06-25', title: 'After movie kegiatan penyaluran air bersih', platform: 'youtube', jenis: 'Video pendek', status: 'review', pj: 'Dewi Lestari', waktu: '15:00', catatan: '' },
      ];

      function notify(msg) {
        if (!toast) return;
        toast.textContent = msg;
        toast.hidden = false;
        setTimeout(() => { toast.hidden = true; }, 3200);
      }

      function updateCounts() {
        const counts = { all: schedules.length };
        Object.keys(PLATFORMS).forEach((p) => { counts[p] = 0; });
        schedules.forEach((s) => {
          if (counts[s.platform] !== undefined) counts[s.platform]++;
        });
        kal.querySelectorAll('[data-count]').forEach((badge) => {
          const plat = badge.getAttribute('data-count');
          if (counts[plat] !== undefined) badge.textContent = String(counts[plat]);
        });
      }

      function renderSideDetail() {
        const filtered = schedules.filter((s) => s.date === selectedDate && (activePlatform === 'all' || s.platform === activePlatform));
        if (sideDate) sideDate.textContent = `Tanggal: ${selectedDate} · ${filtered.length} jadwal`;
        if (detailList) {
          detailList.replaceChildren();
          if (filtered.length === 0) {
            const p = document.createElement('p');
            p.className = 'kal__empty';
            p.textContent = 'Belum ada jadwal pada tanggal ini. Klik tombol "+ Jadwal baru" untuk menambahkan.';
            detailList.append(p);
          } else {
            filtered.forEach((item) => {
              const card = document.createElement('article');
              card.className = 'kal__detail-card';
              card.style.cssText = 'padding:12px;border:1px solid var(--color-border,#dbe1e8);border-radius:8px;margin-bottom:8px;background:var(--color-surface,#fff);cursor:pointer;';
              const pInfo = PLATFORMS[item.platform] || { label: item.platform, color: '#1d5c94' };
              card.innerHTML = `
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:4px;">
                  <span style="font-size:11px;font-weight:600;color:${pInfo.color}">${pInfo.label} · ${item.waktu || '09:00'}</span>
                  <span class="kal__dot" style="background:${item.status === 'terbit' ? '#17683f' : item.status === 'review' ? '#8a5300' : '#5a6875'}"></span>
                </div>
                <h4 style="margin:0 0 4px;font-size:13px;font-weight:600;">${item.title}</h4>
                <p style="margin:0;font-size:11px;color:#7a8794;">PJ: ${item.pj} · Status: ${item.status.toUpperCase()}</p>
              `;
              card.addEventListener('click', () => openModal(item));
              detailList.append(card);
            });
          }
        }
      }

      function renderGrid() {
        monthLabel.textContent = `${MONTHS[view.month]} ${view.year}`;
        daysWrap.replaceChildren();

        const firstDay = new Date(view.year, view.month, 1);
        const lastDay = new Date(view.year, view.month + 1, 0);
        let startDow = (firstDay.getDay() + 6) % 7; // Senin = 0

        const totalDays = lastDay.getDate();
        const prevMonthLastDay = new Date(view.year, view.month, 0).getDate();

        // Hari bulan lalu
        for (let i = startDow - 1; i >= 0; i--) {
          const btn = document.createElement('button');
          btn.className = 'kal__day kal__day--out';
          btn.type = 'button';
          btn.textContent = String(prevMonthLastDay - i);
          daysWrap.append(btn);
        }

        // Hari bulan aktif
        for (let d = 1; d <= totalDays; d++) {
          const dateStr = key(view.year, view.month, d);
          const btn = document.createElement('button');
          btn.className = 'kal__day';
          btn.type = 'button';
          btn.setAttribute('data-date', dateStr);
          if (dateStr === selectedDate) btn.classList.add('kal__day--selected');

          const num = document.createElement('span');
          num.className = 'kal__day-num';
          num.textContent = String(d);
          btn.append(num);

          const daySchedules = schedules.filter((s) => s.date === dateStr && (activePlatform === 'all' || s.platform === activePlatform));
          if (daySchedules.length > 0) {
            const list = document.createElement('div');
            list.className = 'kal__events';
            daySchedules.slice(0, 3).forEach((item) => {
              const chip = document.createElement('span');
              chip.className = 'kal__chip';
              const pInfo = PLATFORMS[item.platform] || { color: '#1d5c94' };
              chip.style.setProperty('--kal-plat', pInfo.color);
              chip.innerHTML = `<i class="kal__chip-dot"></i><span>${item.title}</span>`;
              list.append(chip);
            });
            if (daySchedules.length > 3) {
              const more = document.createElement('span');
              more.className = 'kal__more';
              more.textContent = `+${daySchedules.length - 3} lagi`;
              list.append(more);
            }
            btn.append(list);
          }

          btn.addEventListener('click', () => {
            selectedDate = dateStr;
            kal.querySelectorAll('.kal__day').forEach((el) => el.classList.remove('kal__day--selected'));
            btn.classList.add('kal__day--selected');
            renderSideDetail();
          });

          daysWrap.append(btn);
        }

        updateCounts();
        renderSideDetail();
      }

      function populateJenis(plat) {
        inputJenis.replaceChildren();
        const conf = PLATFORMS[plat] || PLATFORMS.instagram;
        conf.types.forEach((t) => {
          const opt = document.createElement('option');
          opt.value = t;
          opt.textContent = t;
          inputJenis.append(opt);
        });
        fieldsetWa.hidden = plat !== 'whatsapp';
      }

      function openModal(schedule = null) {
        editingId = schedule ? schedule.id : null;
        dialogTitle.textContent = schedule ? 'Ubah Jadwal Konten' : 'Jadwal Konten Baru';
        if (deleteBtn) deleteBtn.hidden = !schedule;

        inputJudul.value = schedule ? schedule.title : '';
        inputTanggal.value = schedule ? schedule.date : selectedDate;
        inputWaktu.value = schedule ? (schedule.waktu || '09:00') : '09:00';
        inputPlatform.value = schedule ? schedule.platform : 'instagram';
        inputStatus.value = schedule ? schedule.status : 'draf';
        populateJenis(inputPlatform.value);
        if (schedule) inputJenis.value = schedule.jenis;
        inputPj.value = schedule ? schedule.pj : 'Rani Maulida';
        inputCatatan.value = schedule ? (schedule.catatan || '') : '';

        dialog.showModal();
      }

      inputPlatform.addEventListener('change', () => {
        populateJenis(inputPlatform.value);
      });

      // Filter platform chips
      kal.querySelectorAll('[data-action="kal:filter"]').forEach((chip) => {
        chip.addEventListener('click', () => {
          kal.querySelectorAll('[data-action="kal:filter"]').forEach((c) => c.setAttribute('aria-pressed', 'false'));
          chip.setAttribute('aria-pressed', 'true');
          activePlatform = chip.getAttribute('data-platform');
          renderGrid();
          notify(`Filter kanal aktif: ${activePlatform.toUpperCase()}`);
        });
      });

      // Nav controls
      kal.querySelector('[data-action="kal:prev"]').addEventListener('click', () => {
        view.month--;
        if (view.month < 0) { view.month = 11; view.year--; }
        renderGrid();
      });
      kal.querySelector('[data-action="kal:next"]').addEventListener('click', () => {
        view.month++;
        if (view.month > 11) { view.month = 0; view.year++; }
        renderGrid();
      });
      kal.querySelector('[data-action="kal:today"]').addEventListener('click', () => {
        const today = new Date();
        view.year = today.getFullYear();
        view.month = today.getMonth();
        selectedDate = today.toISOString().slice(0, 10);
        renderGrid();
      });

      kal.querySelector('[data-action="kal:create"]').addEventListener('click', () => {
        openModal();
      });

      document.getElementById('btn-close-kal')?.addEventListener('click', () => dialog.close());
      document.getElementById('btn-cancel-kal')?.addEventListener('click', () => dialog.close());

      deleteBtn?.addEventListener('click', () => {
        if (editingId) {
          schedules = schedules.filter((s) => s.id !== editingId);
          dialog.close();
          renderGrid();
          notify('Jadwal berhasil dihapus.');
        }
      });

      dialogForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const title = inputJudul.value.trim();
        if (!title) return;

        if (editingId) {
          const item = schedules.find((s) => s.id === editingId);
          if (item) {
            item.title = title;
            item.date = inputTanggal.value;
            item.waktu = inputWaktu.value;
            item.platform = inputPlatform.value;
            item.status = inputStatus.value;
            item.jenis = inputJenis.value;
            item.pj = inputPj.value;
            item.catatan = inputCatatan.value;
          }
          notify(`Jadwal diperbarui: "${title}"`);
        } else {
          schedules.push({
            id: 'k' + Date.now(),
            title,
            date: inputTanggal.value,
            waktu: inputWaktu.value,
            platform: inputPlatform.value,
            status: inputStatus.value,
            jenis: inputJenis.value,
            pj: inputPj.value,
            catatan: inputCatatan.value
          });
          notify(`Jadwal berhasil ditambahkan: "${title}"`);
        }

        dialog.close();
        renderGrid();
      });

      renderGrid();
    });
  </script>
</HumasLayout>
