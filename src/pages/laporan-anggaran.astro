---
import HumasLayout from '../layouts/HumasLayout.astro';
import {
  mockBudgetLines,
  mockAnnualPlan,
} from '../lib/clientDataFetcher';
import PeriodComparison from '../components/PeriodComparison.astro';

const fmt = (n: number) => 'Rp ' + n.toLocaleString('id-ID');
const totalRab = mockBudgetLines.reduce((s, l) => s + l.rab, 0);
const totalLra = mockBudgetLines.reduce((s, l) => s + l.lra, 0);
const absorption = Math.round((totalLra / totalRab) * 100);
const rows = mockBudgetLines.map((l) => {
  const pct = Math.round((l.lra / l.rab) * 100);
  return { ...l, pct, over: l.lra > l.rab };
});
---

<HumasLayout
  title="Laporan & Anggaran — Humas Internal Peduli Negeri"
  pageTitle="Laporan & Anggaran Humas"
  pageSubtitle="RAB, LRA, realisasi anggaran belanja kanal, dan rencana kerja program tahunan"
  currentPath="/laporan-anggaran"
  pageContentId="laporan"
>
  <main class="lap" data-node-id="laporan.anggaran">
    <!-- Sub-Navigasi Modul Laporan Detail -->
    <div style="display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap;">
      <a href="/laporan" class="lap__mini" style="padding:6px 14px;border-radius:8px;text-decoration:none;border:1px solid var(--color-border,#dbe1e8);background:var(--color-surface,#fff);color:var(--color-text,#16202b);">
        Ringkasan Semua Laporan
      </a>
      <a href="/laporan-kinerja" class="lap__mini" style="padding:6px 14px;border-radius:8px;text-decoration:none;border:1px solid var(--color-border,#dbe1e8);background:var(--color-surface,#fff);color:var(--color-text,#16202b);">
        Laporan Kinerja Kanal
      </a>
      <a href="/laporan-anggaran" class="lap__mini" style="background:var(--color-primary,#1d5c94);color:#fff;font-weight:600;padding:6px 14px;border-radius:8px;text-decoration:none;">
        Laporan Anggaran
      </a>
      <a href="/daftar-rab-lra" class="lap__mini" style="padding:6px 14px;border-radius:8px;text-decoration:none;border:1px solid var(--color-border,#dbe1e8);background:var(--color-surface,#fff);color:var(--color-text,#16202b);">
        Daftar RAB & LRA
      </a>
      <a href="/laporan-tahunan" class="lap__mini" style="padding:6px 14px;border-radius:8px;text-decoration:none;border:1px solid var(--color-border,#dbe1e8);background:var(--color-surface,#fff);color:var(--color-text,#16202b);">
        Laporan Tahunan
      </a>
      <a href="/bagikan-cetak" class="lap__mini" style="padding:6px 14px;border-radius:8px;text-decoration:none;border:1px solid var(--color-border,#dbe1e8);background:var(--color-surface,#fff);color:var(--color-text,#16202b);">
        Bagikan & Cetak
      </a>
    </div>

    <!-- Peringatan Akses Terbatas Peran -->
    <div id="restricted-notice" class="lap__card" style="padding:16px;border-left:4px solid #ef4444;display:none;margin-bottom:16px;">
      <p style="margin:0;font-size:13px;color:#ef4444;font-weight:600;">
        🔒 Data akuntabilitas anggaran hanya dapat diakses oleh Administrator Teknis dan Ketua Bidang Humas.
      </p>
    </div>

    <div id="budget-content">
      <!-- 4 KPI Cards Anggaran -->
      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));gap:16px;margin-bottom:20px;">
        <div class="lap__card" style="padding:16px;">
          <span style="font-size:12px;color:var(--color-muted,#5a6875);display:block;margin-bottom:4px;">Total Plafon RAB</span>
          <strong style="font-size:20px;color:var(--color-text,#16202b);">{fmt(totalRab)}</strong>
        </div>
        <div class="lap__card" style="padding:16px;">
          <span style="font-size:12px;color:var(--color-muted,#5a6875);display:block;margin-bottom:4px;">Total Realisasi (LRA)</span>
          <strong style="font-size:20px;color:var(--color-primary,#1d5c94);">{fmt(totalLra)}</strong>
        </div>
        <div class="lap__card" style="padding:16px;">
          <span style="font-size:12px;color:var(--color-muted,#5a6875);display:block;margin-bottom:4px;">Sisa Saldo Anggaran</span>
          <strong style="font-size:20px;color:#10b981;">{fmt(totalRab - totalLra)}</strong>
        </div>
        <div class="lap__card" style="padding:16px;">
          <span style="font-size:12px;color:var(--color-muted,#5a6875);display:block;margin-bottom:4px;">Daya Serap Total</span>
          <strong style="font-size:20px;color:var(--color-primary,#1d5c94);">{absorption}%</strong>
        </div>
      </div>

      <!-- Tabel RAB vs LRA -->
      <section class="lap__card" style="margin-bottom:20px;">
        <div class="lap__toolbar">
          <div>
            <h2 style="font-size:15px;margin:0;">RAB vs Realisasi (LRA) per Mata Anggaran</h2>
            <p style="font-size:12px;color:var(--color-muted,#5a6875);margin:2px 0 0;">Evaluasi ketaatan anggaran operasional dan peliputan lapangan</p>
          </div>
        </div>

        <div class="lap__table-wrap">
          <table class="lap__table">
            <thead>
              <tr>
                <th>Program / Mata Anggaran</th>
                <th>Kategori</th>
                <th>Penanggung Jawab</th>
                <th style="text-align:right">RAB Disetujui</th>
                <th style="text-align:right">Realisasi (LRA)</th>
                <th>Daya Serap</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((r) => (
                <tr>
                  <td><strong>{r.program}</strong></td>
                  <td><span class="lap__badge lap__badge--draf">{r.category}</span></td>
                  <td>{r.owner}</td>
                  <td style="text-align:right">{fmt(r.rab)}</td>
                  <td style="text-align:right"><strong>{fmt(r.lra)}</strong></td>
                  <td>
                    <div style="display:flex;align-items:center;gap:8px;">
                      <div style="flex:1;height:6px;background:var(--color-border,#ebecee);border-radius:4px;overflow:hidden;">
                        <div style={`height:100%;background:${r.over ? '#ef4444' : 'var(--color-primary,#1d5c94)'};width:${Math.min(r.pct, 100)}%`}></div>
                      </div>
                      <span style={`font-size:11px;font-weight:600;color:${r.over ? '#ef4444' : 'var(--color-text,#16202b)'}`}>
                        {r.pct}%{r.over ? ' (!)' : ''}
                      </span>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Rencana Program Tahunan -->
      <section class="lap__card">
        <div class="lap__toolbar">
          <div>
            <h2 style="font-size:15px;margin:0;">Rencana Program Tahunan & Progres Triwulan</h2>
            <p style="font-size:12px;color:var(--color-muted,#5a6875);margin:2px 0 0;">Capaian output fisik dan jadwal kerja strategis</p>
          </div>
        </div>

        <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(240px, 1fr));gap:16px;margin-top:16px;">
          {mockAnnualPlan.map((p) => (
            <div style="padding:16px;border-radius:8px;border:1px solid var(--color-border,#ebecee);background:var(--color-canvas,#f8f9fa);">
              <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
                <strong style="font-size:13px;color:var(--color-primary,#1d5c94);">{p.quarter}</strong>
                <span class="lap__badge lap__badge--final">{p.progress}% Selesai</span>
              </div>
              <p style="margin:0 0 12px;font-size:12px;color:var(--color-text,#16202b);line-height:1.4;">{p.target}</p>
              <div style="height:6px;background:var(--color-border,#ebecee);border-radius:4px;overflow:hidden;">
                <div style={`height:100%;background:var(--color-primary,#1d5c94);width:${p.progress}%`}></div>
              </div>
            </div>
          ))}
        </div>
      </section>
    </div>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const content = document.getElementById('budget-content');
      const notice = document.getElementById('restricted-notice');

      function checkRole() {
        let role = 'head';
        try { role = localStorage.getItem('user_role') || 'head'; } catch {}
        const isStaff = role === 'staff';
        if (content) content.style.display = isStaff ? 'none' : 'block';
        if (notice) notice.style.display = isStaff ? 'block' : 'none';
      }

      window.addEventListener('roleChanged', checkRole);
      checkRole();
    });
  </script>
</HumasLayout>
