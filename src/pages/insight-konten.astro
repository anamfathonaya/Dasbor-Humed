---
import HumasLayout from '../layouts/HumasLayout.astro';
---

<HumasLayout
  title="Insight Konten — Humas Internal Peduli Negeri"
  pageTitle="Insight Konten"
  pageSubtitle="Tren topik, analisis celah liputan (content gaps), dan rekomendasi ide"
  currentPath="/insight-konten"
  pageContentId="insight-konten"
>
  <div class="insight" data-node-id="insight.root">
    <!-- Toolbar Pengaturan Periode Analitik -->
    <section class="insight__toolbar" aria-label="Pengaturan periode">
      <span class="insight__field">
        <label for="insight-periode">Periode analitik</label>
        <select id="insight-periode" data-period>
          <option value="30">30 hari terakhir</option>
          <option value="90" selected>90 hari terakhir</option>
          <option value="180">6 bulan terakhir</option>
        </select>
      </span>
      <span class="insight__field">
        <label for="insight-banding">Bandingkan dengan</label>
        <select id="insight-banding" data-compare>
          <option value="prev" selected>Periode sebelumnya</option>
          <option value="yoy">Periode sama tahun lalu</option>
        </select>
      </span>
      <span class="insight__toolbar-note" data-period-note>
        Sumber: agregasi pemantauan berita RSS/Telegram, sentimen publik, dan riwayat interaksi media sosial lembaga.
      </span>
    </section>

    <!-- Layout 2 Kolom: Kiri Tren & Content Gap, Kanan Ide Tersimpan -->
    <div class="insight__cols">
      <div style="display:flex;flex-direction:column;gap:var(--space-5,20px);min-width:0;">
        <!-- Card 1: Tren Topik -->
        <section class="insight__card" aria-labelledby="insight-tren-title" data-node-id="insight.tren">
          <div class="insight__card-head">
            <h2 id="insight-tren-title">Tren Topik Komunikasi</h2>
            <p>Frekuensi kemunculan lintas sumber berita & kanal sosial</p>
          </div>
          <div class="insight__chart">
            <div class="insight__legend">
              <span><i class="insight__swatch" style="background:var(--color-data-blue, #2f6ea8)"></i> Periode ini</span>
              <span><i class="insight__swatch" style="background:var(--color-neutral-soft, #e9edf2)"></i> Periode pembanding</span>
            </div>
            <div class="insight__bars" data-bars></div>
          </div>
          <p class="insight__summary" data-chart-summary>Topik "Layanan publik digital" naik paling tinggi dibanding periode pembanding.</p>
        </section>

        <!-- Card 2: Content Gap Table -->
        <section class="insight__card" aria-labelledby="insight-gap-title" data-node-id="insight.gap">
          <div class="insight__card-head">
            <h2 id="insight-gap-title">Celah Liputan (Content Gap)</h2>
            <p>Topik dengan animo pencarian tinggi namun liputan internal masih minim</p>
          </div>
          <div class="insight__table-wrap">
            <table>
              <caption class="insight__summary" style="border-top:0;padding:var(--space-3,12px) var(--space-3,12px) 0;">
                Volume permintaan dari pencarian situs dan interaksi kanal sosial pada periode terpilih.
              </caption>
              <thead>
                <tr>
                  <th scope="col">Topik Bahasan</th>
                  <th scope="col">Permintaan</th>
                  <th scope="col">Liputan</th>
                  <th scope="col">Peluang</th>
                  <th scope="col">Aksi</th>
                </tr>
              </thead>
              <tbody data-gap-body>
                <tr>
                  <td class="insight-gap-title">Distribusi bantuan air bersih kemarau<span>Kategori: Bencana & Sosial</span></td>
                  <td class="num">4.120</td>
                  <td class="num">3 artikel</td>
                  <td><span class="insight__badge" data-tone="high">Tinggi</span></td>
                  <td><button class="insight__btn" type="button" data-action="insight:save-idea" data-idea="Liputan distribusi air bersih posko kekeringan" data-source="Content gap · Bencana">Simpan ide</button></td>
                </tr>
                <tr>
                  <td class="insight-gap-title">Transparansi penyaluran donasi publik<span>Kategori: Akuntabilitas</span></td>
                  <td class="num">3.480</td>
                  <td class="num">5 artikel</td>
                  <td><span class="insight__badge" data-tone="high">Tinggi</span></td>
                  <td><button class="insight__btn" type="button" data-action="insight:save-idea" data-idea="Infografis laporan penyaluran donasi publik" data-source="Content gap · Akuntabilitas">Simpan ide</button></td>
                </tr>
                <tr>
                  <td class="insight-gap-title">Mitigasi bencana hidrometeorologi<span>Kategori: Kesiapsiagaan</span></td>
                  <td class="num">2.760</td>
                  <td class="num">7 artikel</td>
                  <td><span class="insight__badge" data-tone="mid">Sedang</span></td>
                  <td><button class="insight__btn" type="button" data-action="insight:save-idea" data-idea="Panduan warga siaga bencana hidrometeorologi" data-source="Content gap · Kesiapsiagaan">Simpan ide</button></td>
                </tr>
                <tr>
                  <td class="insight-gap-title">Pemberdayaan UMKM binaan pasca-bencana<span>Kategori: Ekonomi</span></td>
                  <td class="num">1.940</td>
                  <td class="num">6 artikel</td>
                  <td><span class="insight__badge" data-tone="mid">Sedang</span></td>
                  <td><button class="insight__btn" type="button" data-action="insight:save-idea" data-idea="Kisah inspiratif UMKM bangkit pasca-bencana" data-source="Content gap · Ekonomi">Simpan ide</button></td>
                </tr>
                <tr>
                  <td class="insight-gap-title">Layanan pengaduan dan respon cepat<span>Kategori: Pelayanan</span></td>
                  <td class="num">1.210</td>
                  <td class="num">9 artikel</td>
                  <td><span class="insight__badge" data-tone="low">Terliput</span></td>
                  <td><button class="insight__btn" type="button" data-action="insight:save-idea" data-idea="Alur respon cepat pengaduan kemanusiaan" data-source="Content gap · Pelayanan">Simpan ide</button></td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>
      </div>

      <!-- Card 3: Ide Tersimpan & Siap Dijadwalkan -->
      <section class="insight__card" aria-labelledby="insight-ide-title" data-node-id="insight.ide">
        <div class="insight__card-head">
          <h2 id="insight-ide-title">Ide Konten Tersimpan</h2>
          <p><span data-idea-count>2</span> ide siap diadopsi ke editorial</p>
        </div>
        <div class="insight__ideas" data-idea-list>
          <article class="insight__idea" data-idea-item data-adopted="false">
            <div class="insight__idea-head">
              <div style="min-width:0;">
                <h3>Seri penjelasan singkat SOP tanggap darurat</h3>
                <p class="insight__idea-meta">Tren topik · Edukasi Publik · disimpan 10 Juni 2026</p>
              </div>
            </div>
            <div class="insight__idea-actions">
              <button class="insight__btn" type="button" data-action="insight:adopt">Adopsi ke kalender</button>
              <button class="insight__btn" type="button" data-action="insight:remove">Hapus</button>
            </div>
          </article>
          <article class="insight__idea" data-idea-item data-adopted="false">
            <div class="insight__idea-head">
              <div style="min-width:0;">
                <h3>Infografis capaian penyaluran bantuan Q2</h3>
                <p class="insight__idea-meta">Content gap · Akuntabilitas · disimpan 8 Juni 2026</p>
              </div>
            </div>
            <div class="insight__idea-actions">
              <button class="insight__btn" type="button" data-action="insight:adopt">Adopsi ke kalender</button>
              <button class="insight__btn" type="button" data-action="insight:remove">Hapus</button>
            </div>
          </article>
        </div>
        <div class="insight__empty" data-idea-empty hidden>
          <h3>Belum ada ide tersimpan</h3>
          <p>Simpan ide dari daftar content gap atau tren topik agar bisa dijadwalkan ke kalender editorial.</p>
        </div>
      </section>
    </div>
  </div>

  <!-- Dialog Adopsi Ide -->
  <dialog class="insight__dialog" id="insight-adopt-dialog" data-node-id="insight.dialog" aria-labelledby="insight-dialog-title">
    <div class="insight__dialog-head">
      <div>
        <h2 id="insight-dialog-title">Adopsi ide ke kalender</h2>
        <p data-dialog-source id="insight-dialog-sub">Atur rencana tayang untuk ide terpilih.</p>
      </div>
      <button class="insight__close" type="button" id="btn-close-adopt" aria-label="Tutup dialog">
        <iconify-icon icon="lucide:x" aria-hidden="true"></iconify-icon>
      </button>
    </div>
    <form method="dialog" id="insight-adopt-form">
      <div class="insight__dialog-body">
        <div>
          <label class="insight__label" for="insight-tanggal">Tanggal rencana tayang</label>
          <input class="insight__input" id="insight-tanggal" type="date" value="2026-06-18" required />
        </div>
        <div>
          <label class="insight__label" for="insight-kanal">Kanal publikasi</label>
          <select class="insight__select" id="insight-kanal">
            <option>Instagram</option>
            <option>Situs web</option>
            <option>Facebook</option>
            <option>WhatsApp Siaran</option>
            <option>YouTube</option>
          </select>
        </div>
        <div>
          <label class="insight__label" for="insight-penanggung">Penanggung jawab</label>
          <select class="insight__select" id="insight-penanggung">
            <option>Rani Maulida</option>
            <option>Budi Santoso</option>
            <option>Dewi Lestari</option>
          </select>
        </div>
      </div>
      <div class="insight__dialog-foot">
        <button class="insight__btn" type="button" id="btn-cancel-adopt">Batal</button>
        <button class="insight__btn insight__btn--primary" type="submit">Simpan jadwal</button>
      </div>
    </form>
  </dialog>

  <p class="insight__toast" role="status" aria-live="polite" id="insight-toast" hidden></p>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const insight = document.querySelector('[data-node-id="insight.root"]');
      if (!insight) return;

      const period = insight.querySelector('[data-period]');
      const compare = insight.querySelector('[data-compare]');
      const bars = insight.querySelector('[data-bars]');
      const summary = insight.querySelector('[data-chart-summary]');
      const ideaList = insight.querySelector('[data-idea-list]');
      const ideaEmpty = insight.querySelector('[data-idea-empty]');
      const ideaCount = insight.querySelector('[data-idea-count]');
      const dialog = document.getElementById('insight-adopt-dialog');
      const dialogSub = document.getElementById('insight-dialog-sub');
      const toast = document.getElementById('insight-toast');

      let currentIdeaTitle = '';

      const datasets = {
        '30': {
          unit: '30 hari terakhir',
          rows: [
            { label: 'Bantuan kemanusiaan', now: 118, prev: 96 },
            { label: 'Mitigasi bencana', now: 94, prev: 88 },
            { label: 'Pemberdayaan UMKM', now: 76, prev: 61 },
            { label: 'Transparansi anggaran', now: 64, prev: 40 },
            { label: 'Layanan posko medis', now: 52, prev: 50 },
            { label: 'Pendidikan yatim', now: 41, prev: 45 }
          ]
        },
        '90': {
          unit: '90 hari terakhir',
          rows: [
            { label: 'Bantuan kemanusiaan', now: 412, prev: 305 },
            { label: 'Mitigasi bencana', now: 288, prev: 264 },
            { label: 'Pemberdayaan UMKM', now: 231, prev: 178 },
            { label: 'Transparansi anggaran', now: 196, prev: 121 },
            { label: 'Layanan posko medis', now: 158, prev: 149 },
            { label: 'Pendidikan yatim', now: 124, prev: 138 }
          ]
        },
        '180': {
          unit: '6 bulan terakhir',
          rows: [
            { label: 'Bantuan kemanusiaan', now: 806, prev: 604 },
            { label: 'Mitigasi bencana', now: 561, prev: 522 },
            { label: 'Pemberdayaan UMKM', now: 448, prev: 361 },
            { label: 'Transparansi anggaran', now: 372, prev: 240 },
            { label: 'Layanan posko medis', now: 311, prev: 296 },
            { label: 'Pendidikan yatim', now: 252, prev: 277 }
          ]
        }
      };

      const fmt = new Intl.NumberFormat('id-ID');

      const drawChart = () => {
        const set = datasets[period.value] || datasets['90'];
        const max = Math.max.apply(null, set.rows.map((r) => Math.max(r.now, r.prev)));
        bars.replaceChildren();

        set.rows.forEach((row) => {
          const wrapper = document.createElement('div');
          wrapper.className = 'insight__row';

          const label = document.createElement('span');
          label.className = 'insight__row-label';
          label.textContent = row.label;

          const track = document.createElement('span');
          track.className = 'insight__track';
          const barNow = document.createElement('span');
          barNow.className = 'insight__bar';
          barNow.style.width = (row.now / max * 100).toFixed(1) + '%';
          const barPrev = document.createElement('span');
          barPrev.className = 'insight__bar insight__bar--prev';
          barPrev.style.width = (row.prev / max * 100).toFixed(1) + '%';
          track.append(barNow, barPrev);

          const value = document.createElement('span');
          value.className = 'insight__row-value';
          value.textContent = fmt.format(row.now);

          const note = document.createElement('span');
          note.className = 'insight__row-note';
          const diff = row.now - row.prev;
          const sign = diff >= 0 ? '+' : '−';
          note.textContent = 'Pembanding ' + fmt.format(row.prev) + ' · ' + sign + fmt.format(Math.abs(diff));

          wrapper.append(label, track, value, note);
          bars.append(wrapper);
        });

        const top = set.rows.slice().sort((a, b) => (b.now - b.prev) - (a.now - a.prev))[0];
        const compareLabel = compare.value === 'yoy' ? 'periode sama tahun lalu' : 'periode pembanding';
        if (summary) summary.textContent = 'Periode ' + set.unit + ': topik "' + top.label + '" naik paling tinggi dibanding ' + compareLabel + '.';
      };

      const refreshIdeas = () => {
        const items = Array.from(ideaList.querySelectorAll('[data-idea-item]'));
        if (ideaCount) ideaCount.textContent = String(items.length);
        if (ideaEmpty) ideaEmpty.hidden = items.length !== 0;
      };

      const notify = (message) => {
        if (!toast) return;
        toast.textContent = message;
        toast.hidden = false;
        setTimeout(() => { toast.hidden = true; }, 3200);
      };

      period?.addEventListener('change', drawChart);
      compare?.addEventListener('change', drawChart);
      drawChart();

      // Actions
      insight.addEventListener('click', (event) => {
        const trigger = event.target.closest('[data-action]');
        if (!trigger) return;
        const action = trigger.dataset.action;

        if (action === 'insight:save-idea') {
          const title = trigger.dataset.idea;
          const exists = Array.from(ideaList.querySelectorAll('[data-idea-item] h3')).some((h) => h.textContent === title);
          if (exists) {
            notify('Ide ini sudah tersimpan dalam daftar.');
            return;
          }

          const card = document.createElement('article');
          card.className = 'insight__idea';
          card.setAttribute('data-idea-item', '');
          card.dataset.adopted = 'false';
          card.innerHTML = `
            <div class="insight__idea-head">
              <div style="min-width:0;">
                <h3>${title}</h3>
                <p class="insight__idea-meta">${trigger.dataset.source || 'Content gap'} · Disimpan baru saja</p>
              </div>
            </div>
            <div class="insight__idea-actions">
              <button class="insight__btn" type="button" data-action="insight:adopt">Adopsi ke kalender</button>
              <button class="insight__btn" type="button" data-action="insight:remove">Hapus</button>
            </div>
          `;
          ideaList.prepend(card);
          refreshIdeas();
          notify(`Ide disimpan: "${title}"`);
        }

        if (action === 'insight:remove') {
          const card = trigger.closest('[data-idea-item]');
          if (card) {
            card.remove();
            refreshIdeas();
            notify('Ide dihapus dari simpanan.');
          }
        }

        if (action === 'insight:adopt') {
          const card = trigger.closest('[data-idea-item]');
          currentIdeaTitle = card?.querySelector('h3')?.textContent || 'Ide Konten';
          if (dialogSub) dialogSub.textContent = `Atur rencana tayang untuk: "${currentIdeaTitle}"`;
          if (dialog) dialog.showModal();
        }
      });

      document.getElementById('btn-close-adopt')?.addEventListener('click', () => {
        if (dialog) dialog.close();
      });
      document.getElementById('btn-cancel-adopt')?.addEventListener('click', () => {
        if (dialog) dialog.close();
      });

      document.getElementById('insight-adopt-form')?.addEventListener('submit', (e) => {
        e.preventDefault();
        if (dialog) dialog.close();
        notify(`Ide berhasil dijadwalkan ke Kalender Konten: "${currentIdeaTitle}"`);
      });
    });
  </script>
</HumasLayout>
