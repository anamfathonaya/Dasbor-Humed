---
import HumasLayout from '../layouts/HumasLayout.astro';
import {
  mockBudgetLines,
  budgetCategories,
  budgetOwners,
  budgetQuarters,
  budgetYears,
} from '../lib/clientDataFetcher';
---

<HumasLayout
  title="Daftar RAB & LRA — Humas Internal Peduli Negeri"
  pageTitle="Daftar Program Anggaran (RAB & LRA)"
  pageSubtitle="Rincian pos belanja kegiatan humas, filter kuartal/PJ, dan kalkulasi serapan anggaran"
  currentPath="/daftar-rab-lra"
  pageContentId="laporan"
>
  <main class="lap" data-node-id="laporan.rab-lra">
    <!-- Sub-Navigasi Modul Laporan Detail -->
    <div style="display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap;">
      <a href="/laporan" class="lap__mini" style="padding:6px 14px;border-radius:8px;text-decoration:none;border:1px solid var(--color-border,#dbe1e8);background:var(--color-surface,#fff);color:var(--color-text,#16202b);">
        Ringkasan Semua Laporan
      </a>
      <a href="/laporan-kinerja" class="lap__mini" style="padding:6px 14px;border-radius:8px;text-decoration:none;border:1px solid var(--color-border,#dbe1e8);background:var(--color-surface,#fff);color:var(--color-text,#16202b);">
        Laporan Kinerja Kanal
      </a>
      <a href="/laporan-anggaran" class="lap__mini" style="padding:6px 14px;border-radius:8px;text-decoration:none;border:1px solid var(--color-border,#dbe1e8);background:var(--color-surface,#fff);color:var(--color-text,#16202b);">
        Laporan Anggaran
      </a>
      <a href="/daftar-rab-lra" class="lap__mini" style="background:var(--color-primary,#1d5c94);color:#fff;font-weight:600;padding:6px 14px;border-radius:8px;text-decoration:none;">
        Daftar RAB & LRA
      </a>
      <a href="/laporan-tahunan" class="lap__mini" style="padding:6px 14px;border-radius:8px;text-decoration:none;border:1px solid var(--color-border,#dbe1e8);background:var(--color-surface,#fff);color:var(--color-text,#16202b);">
        Laporan Tahunan
      </a>
      <a href="/bagikan-cetak" class="lap__mini" style="padding:6px 14px;border-radius:8px;text-decoration:none;border:1px solid var(--color-border,#dbe1e8);background:var(--color-surface,#fff);color:var(--color-text,#16202b);">
        Bagikan & Cetak
      </a>
    </div>

    <!-- Filter Card -->
    <div class="lap__card" style="margin-bottom:16px;padding:16px;">
      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(160px, 1fr));gap:12px;">
        <div>
          <label style="display:block;font-size:11px;font-weight:600;margin-bottom:4px;">Pencarian Program</label>
          <input type="search" id="filter-search" class="kb__select" style="width:100%;height:36px;" placeholder="Cari nama kegiatan..." />
        </div>
        <div>
          <label style="display:block;font-size:11px;font-weight:600;margin-bottom:4px;">Kategori</label>
          <select id="filter-category" class="lap__select" style="width:100%;height:36px;">
            {budgetCategories.map(c => <option value={c}>{c}</option>)}
          </select>
        </div>
        <div>
          <label style="display:block;font-size:11px;font-weight:600;margin-bottom:4px;">Penanggung Jawab (PJ)</label>
          <select id="filter-owner" class="lap__select" style="width:100%;height:36px;">
            {budgetOwners.map(o => <option value={o}>{o}</option>)}
          </select>
        </div>
        <div>
          <label style="display:block;font-size:11px;font-weight:600;margin-bottom:4px;">Kuartal</label>
          <select id="filter-quarter" class="lap__select" style="width:100%;height:36px;">
            {budgetQuarters.map(q => <option value={q}>{q}</option>)}
          </select>
        </div>
        <div>
          <label style="display:block;font-size:11px;font-weight:600;margin-bottom:4px;">Status Serapan</label>
          <select id="filter-status" class="lap__select" style="width:100%;height:36px;">
            <option value="Semua Status">Semua Status</option>
            <option value="hemat">Hemat (&lt; 85%)</option>
            <option value="sesuai">Optimal (85% - 100%)</option>
            <option value="melebihi">Melebihi RAB (&gt; 100%)</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Summary Box -->
    <div id="stats-summary" style="display:grid;grid-template-columns:repeat(auto-fit, minmax(200px, 1fr));gap:16px;margin-bottom:16px;"></div>

    <!-- Tabel RAB LRA -->
    <section class="lap__card">
      <div class="lap__toolbar">
        <div>
          <h2 style="font-size:15px;margin:0;">Rincian Pos Anggaran Kegiatan</h2>
          <span id="count-info" style="font-size:12px;color:var(--color-muted,#5a6875);">Memuat data...</span>
        </div>
        <button class="lap__btn lap__btn--primary" type="button" onclick="alert('Membuka formulir pengajuan mata anggaran baru.')">
          <iconify-icon icon="lucide:plus" aria-hidden="true"></iconify-icon> Tambah Program
        </button>
      </div>

      <div class="lap__table-wrap">
        <table class="lap__table">
          <thead>
            <tr>
              <th>No</th>
              <th>Program & Kegiatan</th>
              <th>Kategori</th>
              <th>PJ</th>
              <th>Periode</th>
              <th style="text-align:right">Pagu RAB</th>
              <th style="text-align:right">Realisasi (LRA)</th>
              <th style="text-align:right">Sisa Saldo</th>
              <th>Serapan</th>
            </tr>
          </thead>
          <tbody id="budget-rows"></tbody>
        </table>
      </div>
      <p id="empty-state" style="text-align:center;padding:24px;color:var(--color-muted,#5a6875);display:none;">
        Tidak ditemukan data anggaran yang cocok dengan filter.
      </p>
    </section>
  </main>

  <script define:vars={{ initialData: mockBudgetLines }}>
    document.addEventListener('DOMContentLoaded', () => {
      const searchEl = document.getElementById('filter-search');
      const categoryEl = document.getElementById('filter-category');
      const ownerEl = document.getElementById('filter-owner');
      const quarterEl = document.getElementById('filter-quarter');
      const statusEl = document.getElementById('filter-status');
      const rowsEl = document.getElementById('budget-rows');
      const statsEl = document.getElementById('stats-summary');
      const emptyEl = document.getElementById('empty-state');
      const countEl = document.getElementById('count-info');

      const fmt = (v) => 'Rp ' + Number(v).toLocaleString('id-ID');

      function render() {
        if (!rowsEl || !statsEl) return;
        const q = (searchEl?.value || '').toLowerCase().trim();
        const cat = categoryEl?.value || 'Semua Kategori';
        const own = ownerEl?.value || 'Semua PJ';
        const qtr = quarterEl?.value || 'Semua Kuartal';
        const st = statusEl?.value || 'Semua Status';

        const filtered = initialData.filter((item) => {
          const matchQ = !q || item.program.toLowerCase().includes(q);
          const matchCat = cat === 'Semua Kategori' || item.category === cat;
          const matchOwn = own === 'Semua PJ' || item.owner === own;
          const matchQtr = qtr === 'Semua Kuartal' || item.quarter === qtr;
          const pct = Math.round((item.lra / item.rab) * 100);
          let matchSt = true;
          if (st === 'hemat') matchSt = pct < 85;
          if (st === 'sesuai') matchSt = pct >= 85 && pct <= 100;
          if (st === 'melebihi') matchSt = pct > 100;
          return matchQ && matchCat && matchOwn && matchQtr && matchSt;
        });

        if (countEl) countEl.textContent = `${filtered.length} item program ditemukan`;
        if (emptyEl) emptyEl.style.display = filtered.length === 0 ? 'block' : 'none';

        const sumRab = filtered.reduce((acc, i) => acc + i.rab, 0);
        const sumLra = filtered.reduce((acc, i) => acc + i.lra, 0);
        const sumSisa = sumRab - sumLra;
        const avgPct = sumRab > 0 ? Math.round((sumLra / sumRab) * 100) : 0;

        statsEl.innerHTML = `
          <div class="lap__card" style="padding:14px;">
            <span style="font-size:11px;color:var(--color-muted,#5a6875);display:block;">Total RAB Filter</span>
            <strong style="font-size:18px;">${fmt(sumRab)}</strong>
          </div>
          <div class="lap__card" style="padding:14px;">
            <span style="font-size:11px;color:var(--color-muted,#5a6875);display:block;">Total Realisasi LRA</span>
            <strong style="font-size:18px;color:var(--color-primary,#1d5c94);">${fmt(sumLra)}</strong>
          </div>
          <div class="lap__card" style="padding:14px;">
            <span style="font-size:11px;color:var(--color-muted,#5a6875);display:block;">Sisa Anggaran</span>
            <strong style="font-size:18px;color:#10b981;">${fmt(sumSisa)}</strong>
          </div>
          <div class="lap__card" style="padding:14px;">
            <span style="font-size:11px;color:var(--color-muted,#5a6875);display:block;">Rata-rata Serapan</span>
            <strong style="font-size:18px;color:var(--color-primary,#1d5c94);">${avgPct}%</strong>
          </div>
        `;

        rowsEl.innerHTML = filtered.map((item, idx) => {
          const sisa = item.rab - item.lra;
          const pct = Math.round((item.lra / item.rab) * 100);
          const isOver = item.lra > item.rab;
          return `
            <tr>
              <td>${idx + 1}</td>
              <td><strong>${item.program}</strong></td>
              <td><span class="lap__badge lap__badge--draf">${item.category}</span></td>
              <td>${item.owner}</td>
              <td>${item.year} - ${item.quarter}</td>
              <td style="text-align:right">${fmt(item.rab)}</td>
              <td style="text-align:right"><strong>${fmt(item.lra)}</strong></td>
              <td style="text-align:right;color:${sisa < 0 ? '#ef4444' : '#10b981'}">${fmt(sisa)}</td>
              <td>
                <div style="display:flex;align-items:center;gap:6px;">
                  <div style="flex:1;height:6px;background:var(--color-border,#ebecee);border-radius:3px;overflow:hidden;">
                    <div style="height:100%;background:${isOver ? '#ef4444' : 'var(--color-primary,#1d5c94)'};width:${Math.min(pct, 100)}%;"></div>
                  </div>
                  <span style="font-size:11px;font-weight:600;color:${isOver ? '#ef4444' : 'inherit'}">${pct}%</span>
                </div>
              </td>
            </tr>
          `;
        }).join('');
      }

      searchEl?.addEventListener('input', render);
      categoryEl?.addEventListener('change', render);
      ownerEl?.addEventListener('change', render);
      quarterEl?.addEventListener('change', render);
      statusEl?.addEventListener('change', render);
      render();
    });
  </script>
</HumasLayout>
