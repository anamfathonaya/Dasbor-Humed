---
import HumasLayout from '../layouts/HumasLayout.astro';
import RealtimeIntegrationStatus from '../components/react/RealtimeIntegrationStatus';
import {
  mockOrgProfile,
  mockIntegrations,
} from '../lib/clientDataFetcher';
---

<HumasLayout
  title="Pengaturan & Integrasi — Humas Internal Peduli Negeri"
  pageTitle="Pengaturan & Integrasi"
  pageSubtitle="Konfigurasi lembaga, integrasi penyimpanan DAM NAS, Akun Google (SSO & AI Pro), dan Meta Graph API"
  currentPath="/pengaturan"
  pageContentId="pengaturan"
>
  <main class="cfg" data-node-id="pengaturan.main">
    <!-- Sub Navigasi Pengaturan & Detail -->
    <div style="display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap;">
      <a href="/pengaturan" class="cfg__btn" style="background:var(--color-primary,#1d5c94);color:#fff;font-weight:600;">
        Pusat Pengaturan
      </a>
      <a href="/pengaturan-dam" class="cfg__btn">
        <iconify-icon icon="lucide:hard-drive" aria-hidden="true"></iconify-icon>Koneksi DAM NAS
      </a>
      <a href="/integrasi-google" class="cfg__btn">
        <iconify-icon icon="logos:google-icon" aria-hidden="true"></iconify-icon>Akun Google (SSO & AI Pro)
      </a>
      <a href="/manajemen-akun" class="cfg__btn">
        <iconify-icon icon="lucide:users" aria-hidden="true"></iconify-icon>Akun & Hak Akses
      </a>
      <a href="/jejak-audit" class="cfg__btn">
        <iconify-icon icon="lucide:shield-check" aria-hidden="true"></iconify-icon>Jejak Audit
      </a>
    </div>

    <!-- Top Bar -->
    <div class="cfg__bar">
      <p class="cfg__bar-text">
        <b>Pusat Pengaturan:</b> Identitas lembaga, integrasi penyimpanan DAM NAS Synology, Akun Google (SSO & Google AI Pro), dan keamanan sistem.
      </p>
      <div class="cfg__bar-actions">
        <a href="/manajemen-akun" class="cfg__btn">
          <iconify-icon icon="lucide:users" aria-hidden="true"></iconify-icon>Manajemen Akun & Log Audit
        </a>
        <button class="cfg__btn cfg__btn--primary" type="button" id="btn-test-all-api">
          <iconify-icon icon="lucide:zap" aria-hidden="true"></iconify-icon>Uji Semua Koneksi API
        </button>
      </div>
    </div>

    <!-- Tab Bar -->
    <div class="cfg__tabs" role="tablist">
      <button class="cfg__tab cfg__tab--active" role="tab" aria-selected="true" data-tab="integrasi">
        <iconify-icon icon="lucide:plug" aria-hidden="true"></iconify-icon>Integrasi DAM NAS & Cloud
      </button>
      <button class="cfg__tab" role="tab" aria-selected="false" data-tab="profil">
        <iconify-icon icon="lucide:building-2" aria-hidden="true"></iconify-icon>Profil Lembaga
      </button>
      <button class="cfg__tab" role="tab" aria-selected="false" data-tab="keamanan">
        <iconify-icon icon="lucide:shield-check" aria-hidden="true"></iconify-icon>Kebijakan Keamanan & Webhook
      </button>
    </div>

    <!-- Section 1: Integrasi Eksternal & Penyimpanan (Default Aktif) -->
    <div class="cfg__card" id="pane-integrasi">
      <div class="cfg__card-head">
        <div>
          <h2 class="cfg__card-title">Konektor Penyimpanan & API Kanal Publikasi</h2>
          <p class="cfg__card-sub">Status sambungan server DAM lokal, penyimpanan Cloud, dan gateway sosial media</p>
        </div>
        <span class="cfg__badge cfg__badge--green">3 dari 4 Layanan Terhubung Normal</span>
      </div>

      <!-- Realtime Integration Status Island (Auto Heartbeat & Test Connection) -->
      <RealtimeIntegrationStatus client:load />
    </div>

    <!-- Section 2: Profil Lembaga (Hidden by Tab) -->
    <div class="cfg__card" id="pane-profil" hidden>
      <div class="cfg__card-head">
        <div>
          <h2 class="cfg__card-title">Profil & Legalitas Yayasan</h2>
          <p class="cfg__card-sub">Informasi resmi yang tercantum pada footer laporan tahunan dan kop surat siaran pers</p>
        </div>
      </div>
      <form class="cfg__form-grid" id="form-profil-lembaga">
        <div class="cfg__field">
          <label style="display:block;margin-bottom:4px;font-size:12px;font-weight:600;color:var(--color-text,#16202b);">Nama Resmi Yayasan</label>
          <input type="text" class="kb__select" style="width:100%;" value={mockOrgProfile.name} required>
        </div>
        <div class="cfg__field">
          <label style="display:block;margin-bottom:4px;font-size:12px;font-weight:600;color:var(--color-text,#16202b);">Nama Singkat / Brand Organisasi</label>
          <input type="text" class="kb__select" style="width:100%;" value={mockOrgProfile.shortName} required>
        </div>
        <div class="cfg__field" style="grid-column: 1 / -1;">
          <label style="display:block;margin-bottom:4px;font-size:12px;font-weight:600;color:var(--color-text,#16202b);">Slogan & Tagline Lembaga</label>
          <input type="text" class="kb__select" style="width:100%;" value={mockOrgProfile.tagline} required>
        </div>
        <div class="cfg__field" style="grid-column: 1 / -1;">
          <label style="display:block;margin-bottom:4px;font-size:12px;font-weight:600;color:var(--color-text,#16202b);">Alamat Kantor Pusat</label>
          <input type="text" class="kb__select" style="width:100%;" value={mockOrgProfile.address} required>
        </div>
        <div class="cfg__field">
          <label style="display:block;margin-bottom:4px;font-size:12px;font-weight:600;color:var(--color-text,#16202b);">Email Humas & Kerja Sama</label>
          <input type="email" class="kb__select" style="width:100%;" value={mockOrgProfile.contactEmail} required>
        </div>
        <div class="cfg__field">
          <label style="display:block;margin-bottom:4px;font-size:12px;font-weight:600;color:var(--color-text,#16202b);">Nomor Hotline Pelayanan Media</label>
          <input type="text" class="kb__select" style="width:100%;" value={mockOrgProfile.contactPhone} required>
        </div>
        <div style="grid-column: 1 / -1; display:flex; justify-content:flex-end;">
          <button type="submit" class="cfg__btn cfg__btn--primary">Simpan Profil Lembaga</button>
        </div>
      </form>
    </div>

    <!-- Section 3: Keamanan (Hidden by Tab) -->
    <div class="cfg__card" id="pane-keamanan" hidden>
      <div class="cfg__card-head">
        <div>
          <h2 class="cfg__card-title">Kebijakan Keamanan & Pembatasan IP</h2>
          <p class="cfg__card-sub">Pengamanan akses dasbor operasional dan enkripsi komunikasi data</p>
        </div>
      </div>
      <div style="display:flex;flex-direction:column;gap:12px;font-size:13px;">
        <label style="display:flex;align-items:center;gap:10px;cursor:pointer;">
          <input type="checkbox" checked style="width:16px;height:16px;">
          <span><b>Wajibkan Autentikasi Dua Faktor (2FA)</b> untuk peran Administrator dan Kepala Bagian</span>
        </label>
        <label style="display:flex;align-items:center;gap:10px;cursor:pointer;">
          <input type="checkbox" checked style="width:16px;height:16px;">
          <span><b>Kunci Akses Otomatis:</b> Blokir akun setelah 5 kali percobaan kata sandi salah dalam 10 menit</span>
        </label>
        <label style="display:flex;align-items:center;gap:10px;cursor:pointer;">
          <input type="checkbox" checked style="width:16px;height:16px;">
          <span><b>Enkripsi Log Audit:</b> Simpan rekaman jejak aktivitas pengguna dengan enkripsi SHA-256</span>
        </label>
      </div>
      <div style="margin-top:20px;display:flex;gap:8px;">
        <a href="/jejak-audit" class="cfg__btn">
          <iconify-icon icon="lucide:shield-check" aria-hidden="true"></iconify-icon>Lihat Log Audit Lengkap
        </a>
      </div>
    </div>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Tab switching
      const tabs = document.querySelectorAll('.cfg__tab');
      const paneIntegrasi = document.getElementById('pane-integrasi');
      const paneProfil = document.getElementById('pane-profil');
      const paneKeamanan = document.getElementById('pane-keamanan');

      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          tabs.forEach(t => {
            t.classList.remove('cfg__tab--active');
            t.setAttribute('aria-selected', 'false');
          });
          tab.classList.add('cfg__tab--active');
          tab.setAttribute('aria-selected', 'true');

          const target = tab.getAttribute('data-tab');
          if (paneIntegrasi) paneIntegrasi.hidden = target !== 'integrasi';
          if (paneProfil) paneProfil.hidden = target !== 'profil';
          if (paneKeamanan) paneKeamanan.hidden = target !== 'keamanan';
        });
      });

      // Actions
      document.getElementById('btn-test-all-api')?.addEventListener('click', () => {
        alert('Semua koneksi integrasi (DAM NAS, Akun Google SSO, Meta API) telah diverifikasi: Normal dan Responsif.');
      });

      document.querySelector('.btn-sync-dam')?.addEventListener('click', () => {
        alert('Memulai pemindaian sinkronisasi folder aset DAM NAS Synology...');
      });

      document.querySelector('.btn-test-google')?.addEventListener('click', () => {
        alert('Menguji izin akses Google Calendar & Drive API: Berhasil (OAuth2 valid).');
      });

      document.querySelector('.btn-refresh-meta')?.addEventListener('click', () => {
        alert('Token Meta Graph API diverifikasi: Masih valid untuk 78 hari ke depan.');
      });

      document.querySelector('.btn-reconnect-telegram')?.addEventListener('click', () => {
        alert('Webhook Telegram bot berhasil didaftarkan ulang dan dites: Pesan terkirim!');
      });

      document.getElementById('form-profil-lembaga')?.addEventListener('submit', (e) => {
        e.preventDefault();
        alert('Profil dan legalitas lembaga berhasil diperbarui.');
      });
    });
  </script>
</HumasLayout>
