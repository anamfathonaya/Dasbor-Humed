---
import {
  mockOrgProfile,
  mockUsers,
  mockPermissions,
  mockIntegrations,
  mockAuditLogs
} from '../data/mockSettings';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Pengaturan & Integrasi Sistem (Settings) - Dasbor Humas Media</title>
  </head>
  <body>
    <!-- HEADER NAVIGASI DASBOR -->
    <header class="top">
      <div class="brand"><span>🌐</span><h1>Dasbor Humas Media</h1></div>
      <nav>
        <a href="/dasbor-metrik">Dasbor Metrik</a>
        <a href="/kalender-konten">Kalender Konten</a>
        <a href="/papan-proyek">Papan Proyek</a>
        <a href="/pantauan-berita">Pantauan Berita</a>
        <a href="/insight-konten">Insight Konten</a>
        <a href="/laporan-anggaran">Laporan & Anggaran</a>
        <a href="/basis-pengetahuan">Basis Pengetahuan & SOP</a>
        <a href="/pengaturan" class="active">Pengaturan & Integrasi</a>
      </nav>
      <div class="role">
        <span>Peran Aktif:</span>
        <select id="user-role">
          <option value="head">Ketua Bidang (Akses Penuh)</option>
          <option value="admin">Admin (Teknis & Sistem)</option>
          <option value="staff">Staf (Konten Saja)</option>
        </select>
      </div>
    </header>

    <main>
      <!-- HEADER HALAMAN -->
      <div class="head">
        <div>
          <h2>Pusat Pengaturan, Peran & Integrasi Sistem</h2>
          <p class="muted">
            Konfigurasi identitas lembaga, matriks otorisasi pengguna (RBAC), integrasi penyimpanan DAM NAS, Google Workspace, dan jejak audit keamanan.
          </p>
        </div>
        <div class="actions">
          <button class="btn btn-secondary" id="btn-test-all-integrations">
            ⚡ Uji Semua Koneksi
          </button>
          <button class="btn" id="btn-save-master-settings">
            💾 Simpan Perubahan
          </button>
        </div>
      </div>

      <!-- BANNER NOTIFIKASI / FEEDBACK -->
      <div id="settings-alert" class="alert-box" hidden>
        <span id="settings-alert-text">Perubahan konfigurasi berhasil disimpan ke sistem.</span>
        <button type="button" id="btn-close-alert" class="btn-alert-close">✕</button>
      </div>

      <!-- NAVIGASI TAB -->
      <div class="tab-bar">
        <button class="tab-btn active" data-tab="profil">
          🏢 Profil Lembaga
        </button>
        <button class="tab-btn" data-tab="pengguna">
          👥 Pengguna & Matriks Hak Akses
        </button>
        <button class="tab-btn" data-tab="integrasi">
          🔌 Integrasi DAM NAS & Cloud
        </button>
        <button class="tab-btn" data-tab="audit">
          🛡️ Log Audit & Keamanan
        </button>
      </div>

      <!-- TAB 1: PROFIL LEMBAGA -->
      <section id="tab-content-profil" class="tab-pane active">
        <div class="card">
          <div class="card-header">
            <h3>Identitas Lembaga & Parameter Publikasi</h3>
            <p class="muted">Data ini disematkan pada kop siaran pers, laporan kinerja tahunan, dan metadata publikasi resmi.</p>
          </div>

          <form id="form-org-profile" class="form-grid">
            <div class="form-group">
              <label>Nama Resmi Lembaga</label>
              <input type="text" name="name" value={mockOrgProfile.name} required />
            </div>

            <div class="form-group">
              <label>Nama Ringkas (Label Tajuk)</label>
              <input type="text" name="shortName" value={mockOrgProfile.shortName} required />
            </div>

            <div class="form-group full">
              <label>Slogan / Tagline Lembaga</label>
              <input type="text" name="tagline" value={mockOrgProfile.tagline} />
            </div>

            <div class="form-group full">
              <label>Alamat Kantor Pusat</label>
              <textarea name="address" rows="2">{mockOrgProfile.address}</textarea>
            </div>

            <div class="form-group">
              <label>Email Kontak Humas</label>
              <input type="email" name="contactEmail" value={mockOrgProfile.contactEmail} required />
            </div>

            <div class="form-group">
              <label>Nomor Telepon Hotline Media</label>
              <input type="text" name="contactPhone" value={mockOrgProfile.contactPhone} />
            </div>

            <div class="form-group">
              <label>Tahun Anggaran Operasional</label>
              <input type="text" name="fiscalYear" value={mockOrgProfile.fiscalYear} />
            </div>

            <div class="form-group">
              <label>Zona Waktu Server</label>
              <input type="text" name="timezone" value={mockOrgProfile.timezone} />
            </div>

            <div class="form-actions full">
              <button type="submit" class="btn">Simpan Identitas Lembaga</button>
            </div>
          </form>
        </div>
      </section>

      <!-- TAB 2: PENGGUNA & MATRIKS HAK AKSES -->
      <section id="tab-content-pengguna" class="tab-pane">
        <!-- Tabel Pengguna -->
        <div class="card" style="margin-bottom: 1.5rem;">
          <div class="card-header flex-between">
            <div>
              <h3>Daftar Personil & Akun Pengguna</h3>
              <p class="muted">Anggota tim humas yang memiliki hak masuk ke sistem dasbor.</p>
            </div>
            <button class="btn btn-secondary" id="btn-add-user">+ Tambah Pengguna</button>
          </div>

          <div class="table-wrap">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Nama & Email</th>
                  <th>Departemen</th>
                  <th>Peran Sistem</th>
                  <th>Aktivitas Terakhir</th>
                  <th>Status</th>
                  <th style="text-align: right;">Aksi</th>
                </tr>
              </thead>
              <tbody>
                {mockUsers.map((user) => (
                  <tr>
                    <td>
                      <div class="user-cell">
                        <span class="user-avatar">{user.avatar}</span>
                        <div>
                          <strong>{user.name}</strong>
                          <span class="muted-sm">{user.email}</span>
                        </div>
                      </div>
                    </td>
                    <td>{user.department}</td>
                    <td><span class="badge badge-role">{user.roleLabel}</span></td>
                    <td class="muted-sm">{user.lastActive}</td>
                    <td><span class="badge badge-active">● Aktif</span></td>
                    <td style="text-align: right;">
                      <button class="btn-action text-blue">Sunting</button>
                      <button class="btn-action text-red">Nonaktif</button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Matriks Hak Akses (RBAC) -->
        <div class="card">
          <div class="card-header">
            <h3>Matriks Otorisasi Berdasarkan Peran (Role-Based Access Control)</h3>
            <p class="muted">Pengaturan izin akses fitur, persetujuan konten, pengelolaan anggaran, dan administrasi teknis.</p>
          </div>

          <div class="table-wrap">
            <table class="data-table">
              <thead>
                <tr>
                  <th style="min-width: 280px;">Modul & Deskripsi Hak Akses</th>
                  <th style="text-align: center;">Ketua Bidang (Head)</th>
                  <th style="text-align: center;">Admin Sistem (Admin)</th>
                  <th style="text-align: center;">Staf Tim (Staff)</th>
                  <th style="text-align: center;">Editor / Peninjau (Reviewer)</th>
                </tr>
              </thead>
              <tbody>
                {mockPermissions.map((perm) => (
                  <tr>
                    <td>
                      <strong>{perm.label}</strong>
                      <span class="muted-sm">{perm.description}</span>
                    </td>
                    <td style="text-align: center;">
                      <input type="checkbox" checked={perm.head} class="cb-perm" />
                    </td>
                    <td style="text-align: center;">
                      <input type="checkbox" checked={perm.admin} class="cb-perm" />
                    </td>
                    <td style="text-align: center;">
                      <input type="checkbox" checked={perm.staff} class="cb-perm" />
                    </td>
                    <td style="text-align: center;">
                      <input type="checkbox" checked={perm.reviewer} class="cb-perm" />
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- TAB 3: INTEGRASI SISTEM (DAM NAS & CLOUD) -->
      <section id="tab-content-integrasi" class="tab-pane">
        <div class="cards-grid">
          {mockIntegrations.map((item) => (
            <div class="card integration-card">
              <div class="card-header flex-between">
                <div>
                  <span class="badge badge-cat">{item.categoryLabel}</span>
                  <h3 style="margin-top: 0.4rem;">{item.name}</h3>
                </div>
                <span class={`badge ${item.status === 'connected' ? 'badge-active' : item.status === 'warning' ? 'badge-warning' : 'badge-danger'}`}>
                  ● {item.statusLabel}
                </span>
              </div>

              <p class="muted-sm" style="margin: 0.75rem 0;">{item.details}</p>

              <div class="tech-box">
                <div class="tech-row">
                  <span class="tech-label">Endpoint:</span>
                  <span class="tech-val mono truncate" title={item.endpoint}>{item.endpoint}</span>
                </div>
                <div class="tech-row">
                  <span class="tech-label">Kredensial:</span>
                  <span class="tech-val truncate" title={item.authMethod}>{item.authMethod}</span>
                </div>
                <div class="tech-row">
                  <span class="tech-label">Sinkron Terakhir:</span>
                  <span class="tech-val">{item.lastSync}</span>
                </div>
              </div>

              <div class="card-footer flex-end">
                <button class="btn btn-secondary btn-test-conn" data-target={item.name}>
                  Uji Koneksi
                </button>
                <button class="btn btn-sync-now" data-target={item.name}>
                  Sinkronkan Sekarang
                </button>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- TAB 4: LOG AUDIT & KEAMANAN -->
      <section id="tab-content-audit" class="tab-pane">
        <div class="card">
          <div class="card-header flex-between">
            <div>
              <h3>Jejak Audit Aktivitas & Peristiwa Keamanan</h3>
              <p class="muted">Catatan peristiwa perubahan konfigurasi, persetujuan berkas, dan autentikasi untuk akuntabilitas sistem.</p>
            </div>
            <button class="btn btn-secondary" id="btn-export-audit">
              📥 Ekspor Berkas CSV
            </button>
          </div>

          <div class="table-wrap">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Waktu Kejadian</th>
                  <th>Pengguna & Peran</th>
                  <th>Aksi / Tindakan</th>
                  <th>Objek Sasaran</th>
                  <th>Alamat IP</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                {mockAuditLogs.map((log) => (
                  <tr>
                    <td class="mono muted-sm">{log.timestamp}</td>
                    <td>
                      <strong>{log.userName}</strong>
                      <span class="muted-sm">{log.userRole}</span>
                    </td>
                    <td><strong class="text-slate">{log.action}</strong></td>
                    <td class="mono muted-sm truncate max-w-sm" title={log.target}>{log.target}</td>
                    <td class="mono muted-sm">{log.ipAddress}</td>
                    <td>
                      <span class={`badge ${log.status === 'success' ? 'badge-active' : log.status === 'warning' ? 'badge-warning' : 'badge-danger'}`}>
                        {log.status === 'success' ? 'Berhasil' : log.status === 'warning' ? 'Peringatan' : 'Gagal'}
                      </span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>
    </main>

    <style>
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
        background: #f8fafc;
        color: #1e293b;
      }

      .top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.85rem 1.75rem;
        background: #0f172a;
        color: #fff;
        flex-wrap: wrap;
        gap: 1rem;
      }
      .brand { display: flex; align-items: center; gap: 0.6rem; }
      .top h1 { font-size: 1.1rem; margin: 0; color: #f8fafc; }
      .top nav { display: flex; gap: 1.25rem; flex-wrap: wrap; }
      .top nav a { color: #94a3b8; text-decoration: none; font-size: 0.9rem; }
      .top nav a.active, .top nav a:hover { color: #38bdf8; }
      .role { display: flex; gap: 0.5rem; align-items: center; font-size: 0.8rem; }
      .role select { font: inherit; padding: 0.25rem 0.5rem; border-radius: 6px; border: 1px solid #334155; background: #1e293b; color: #f8fafc; }

      main { max-width: 1320px; margin: 0 auto; padding: 1.5rem; }
      .head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1.5rem;
      }
      .head h2 { margin: 0 0 0.25rem; font-size: 1.35rem; color: #0f172a; }
      .muted { margin: 0; color: #64748b; font-size: 0.9rem; line-height: 1.5; }
      .muted-sm { display: block; font-size: 0.78rem; color: #64748b; margin-top: 0.15rem; }
      .text-slate { color: #0f172a; }
      .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }

      .actions { display: flex; gap: 0.6rem; }
      .btn {
        font: inherit;
        background: #0284c7;
        color: #fff;
        border: 0;
        padding: 0.55rem 1rem;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        transition: background 0.15s;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.88rem;
      }
      .btn:hover { background: #0369a1; }
      .btn-secondary {
        background: #fff;
        border: 1px solid #cbd5e1;
        color: #334155;
      }
      .btn-secondary:hover { background: #f1f5f9; }

      /* Tab bar */
      .tab-bar {
        display: flex;
        gap: 0.5rem;
        border-bottom: 1px solid #e2e8f0;
        margin-bottom: 1.5rem;
        overflow-x: auto;
      }
      .tab-btn {
        font: inherit;
        background: none;
        border: 0;
        border-bottom: 2px solid transparent;
        padding: 0.75rem 1.25rem;
        font-size: 0.9rem;
        font-weight: 600;
        color: #64748b;
        cursor: pointer;
        white-space: nowrap;
        transition: all 0.15s;
      }
      .tab-btn:hover { color: #0f172a; }
      .tab-btn.active {
        color: #0284c7;
        border-bottom-color: #0284c7;
      }

      .tab-pane { display: none; }
      .tab-pane.active { display: block; }

      /* Alert Box */
      .alert-box {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #ecfdf5;
        border: 1px solid #a7f3d0;
        color: #065f46;
        padding: 0.75rem 1.25rem;
        border-radius: 8px;
        font-size: 0.88rem;
        margin-bottom: 1.25rem;
      }
      .btn-alert-close {
        background: none;
        border: none;
        font-size: 1rem;
        color: #065f46;
        cursor: pointer;
      }

      /* Card styles */
      .card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 1.5rem;
      }
      .card-header { margin-bottom: 1.25rem; }
      .card-header h3 { margin: 0 0 0.25rem; font-size: 1.15rem; color: #0f172a; }
      .flex-between { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; }
      .flex-end { display: flex; justify-content: flex-end; gap: 0.5rem; }

      /* Forms */
      .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.25rem;
      }
      @media (max-width: 768px) {
        .form-grid { grid-template-columns: 1fr; }
      }
      .form-group { display: flex; flex-direction: column; gap: 0.35rem; }
      .form-group.full { grid-column: 1 / -1; }
      .form-group label { font-size: 0.8rem; font-weight: 600; color: #475569; }
      .form-group input, .form-group textarea, .form-group select {
        font: inherit;
        padding: 0.55rem 0.75rem;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        font-size: 0.9rem;
      }
      .form-actions {
        display: flex;
        justify-content: flex-end;
        padding-top: 1rem;
        border-top: 1px solid #f1f5f9;
      }

      /* Tables */
      .table-wrap { overflow-x: auto; }
      .data-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
        font-size: 0.88rem;
      }
      .data-table th {
        background: #f8fafc;
        padding: 0.75rem 1rem;
        font-size: 0.75rem;
        text-transform: uppercase;
        color: #475569;
        border-bottom: 1px solid #e2e8f0;
        font-weight: 700;
      }
      .data-table td {
        padding: 0.85rem 1rem;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
      }
      .data-table tr:hover td { background: #f8fafc; }

      .user-cell { display: flex; align-items: center; gap: 0.75rem; }
      .user-avatar {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: #e0f2fe;
        color: #0369a1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.8rem;
      }

      .btn-action {
        background: none;
        border: none;
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        padding: 0.2rem 0.4rem;
      }
      .text-blue { color: #0284c7; }
      .text-blue:hover { text-decoration: underline; }
      .text-red { color: #e11d48; }
      .text-red:hover { text-decoration: underline; }

      .cb-perm {
        width: 16px;
        height: 16px;
        cursor: pointer;
        accent-color: #0284c7;
      }

      /* Badges */
      .badge {
        display: inline-flex;
        align-items: center;
        padding: 0.2rem 0.55rem;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 600;
      }
      .badge-role { background: #f1f5f9; color: #334155; }
      .badge-cat { background: #e0f2fe; color: #0369a1; }
      .badge-active { background: #dcfce7; color: #166534; }
      .badge-warning { background: #fef3c7; color: #92400e; }
      .badge-danger { background: #fee2e2; color: #991b1b; }

      /* Integration Grid */
      .cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
        gap: 1.25rem;
      }
      @media (max-width: 640px) {
        .cards-grid { grid-template-columns: 1fr; }
      }
      .integration-card {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }
      .tech-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 0.75rem;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        margin: 0.75rem 0 1.25rem;
      }
      .tech-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.78rem;
      }
      .tech-label { color: #64748b; font-weight: 500; }
      .tech-val { color: #1e293b; max-width: 250px; }
      .truncate {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .card-footer {
        padding-top: 1rem;
        border-top: 1px solid #f1f5f9;
      }
    </style>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        // Tab switching
        const tabBtns = document.querySelectorAll('.tab-btn');
        const tabPanes = document.querySelectorAll('.tab-pane');
        const alertBox = document.getElementById('settings-alert');
        const alertText = document.getElementById('settings-alert-text');
        const btnCloseAlert = document.getElementById('btn-close-alert');

        function notify(msg: string) {
          if (alertBox && alertText) {
            alertText.textContent = msg;
            alertBox.hidden = false;
            setTimeout(() => {
              alertBox.hidden = true;
            }, 3500);
          }
        }

        btnCloseAlert?.addEventListener('click', () => {
          if (alertBox) alertBox.hidden = true;
        });

        tabBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            const targetId = btn.getAttribute('data-tab');

            tabBtns.forEach((b) => b.classList.remove('active'));
            tabPanes.forEach((p) => p.classList.remove('active'));

            btn.classList.add('active');
            const targetPane = document.getElementById(`tab-content-${targetId}`);
            if (targetPane) targetPane.classList.add('active');
          });
        });

        // Form save
        document.getElementById('form-org-profile')?.addEventListener('submit', (e) => {
          e.preventDefault();
          notify('Identitas lembaga dan parameter umum berhasil diperbarui.');
        });

        // Master buttons
        document.getElementById('btn-save-master-settings')?.addEventListener('click', () => {
          notify('Semua konfigurasi sistem dan matriks izin berhasil disimpan.');
        });

        document.getElementById('btn-test-all-integrations')?.addEventListener('click', () => {
          notify('Uji koneksi DAM NAS, Google Workspace, dan Meta Graph API sukses terhubung.');
        });

        // Single integration buttons
        document.querySelectorAll('.btn-test-conn').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            const target = (e.currentTarget as HTMLElement).getAttribute('data-target');
            notify(`Konektivitas ke ${target} stabil (Waktu respons: 28ms).`);
          });
        });

        document.querySelectorAll('.btn-sync-now').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            const target = (e.currentTarget as HTMLElement).getAttribute('data-target');
            notify(`Sinkronisasi berkas dan indeks aset untuk ${target} dimulai.`);
          });
        });

        // Export and add user
        document.getElementById('btn-export-audit')?.addEventListener('click', () => {
          notify('Berkas riwayat audit berhasil diekspor (audit_logs_oktober_2026.csv).');
        });

        document.getElementById('btn-add-user')?.addEventListener('click', () => {
          notify('Modal tambah personil tim baru dibuka.');
        });

        // Role select in navbar sync with localStorage
        const userRoleSelect = document.getElementById('user-role') as HTMLSelectElement | null;
        if (userRoleSelect) {
          try {
            const savedRole = localStorage.getItem('user_role');
            if (savedRole) userRoleSelect.value = savedRole;
          } catch {}
          userRoleSelect.addEventListener('change', () => {
            try {
              localStorage.setItem('user_role', userRoleSelect.value);
            } catch {}
            notify(`Peran aktif diganti ke: ${userRoleSelect.options[userRoleSelect.selectedIndex].text}`);
          });
        }
      });
    </script>
