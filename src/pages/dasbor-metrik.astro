---
import HumasLayout from '../layouts/HumasLayout.astro';
---

<HumasLayout
  title="Dasbor Metrik — Humas Internal Peduli Negeri"
  pageTitle="Dasbor Metrik (Telah Disatukan)"
  pageSubtitle="Metrik performa dan analitik kanal kini terintegrasi di Dasbor Utama"
  currentPath="/dasbor-metrik"
  pageContentId="dasbor-metrik"
>
  <div class="redirect-box" style="text-align:center;padding:48px 24px;background:var(--color-surface,#fff);border:1px solid var(--color-border,#dbe1e8);border-radius:var(--radius-lg,12px);max-width:640px;margin:32px auto;display:flex;flex-direction:column;align-items:center;gap:16px;">
    <iconify-icon icon="lucide:check-circle" style="font-size: 54px; color: var(--color-primary,#1d5c94);"></iconify-icon>
    <h2 style="margin: 0; font-size: 22px; font-weight: 700; color: var(--color-text,#16202b);">Modul Metrik Telah Disatukan</h2>
    <p style="margin: 0; max-width: 480px; color: var(--color-text-muted,#5a6875); font-size: 14px; line-height: 1.6;">
      Seluruh visual analitik performa, grafik tren interaktif 12 pekan, dan tabel kanal kini terintegrasi penuh ke dalam <b>Dasbor & Metrik Utama</b>.
    </p>
    <a href="/dasbor" class="redirect-btn" style="display:inline-flex;align-items:center;gap:8px;padding:10px 20px;border-radius:8px;background:var(--color-primary,#1d5c94);color:#fff;text-decoration:none;font-weight:600;font-size:14px;margin-top:8px;">
      <iconify-icon icon="lucide:arrow-right" aria-hidden="true"></iconify-icon>
      Buka Dasbor & Metrik Utama
    </a>
  </div>
</HumasLayout>
