---
import HumasLayout from '../layouts/HumasLayout.astro';
import {
  mockKnowledgeDocs,
  knowledgeCategories,
} from '../lib/clientDataFetcher';

const totalDocs = mockKnowledgeDocs.length;
const sopCount = mockKnowledgeDocs.filter(d => d.category === 'SOP').length;
const guidelineCount = mockKnowledgeDocs.filter(d => d.category === 'Pedoman Brand' || d.category === 'Panduan Teknis').length;
const workflowCount = mockKnowledgeDocs.filter(d => d.category === 'Alur Kerja' || d.category === 'Template').length;
---

<HumasLayout
  title="Basis Pengetahuan & SOP — Humas Internal Peduli Negeri"
  pageTitle="Basis Pengetahuan & SOP"
  pageSubtitle="Repositori SOP resmi, panduan krisis, etika peliputan bencana & alur kerja lembaga"
  currentPath="/basis-pengetahuan"
  pageContentId="basis-pengetahuan"
>
  <main class="kb" data-node-id="basis-pengetahuan.main">
    <!-- Top Bar -->
    <div class="kb__bar">
      <p class="kb__bar-text">
        <b>Katalog Dokumen Resmi:</b> {totalDocs} Prosedur SOP, Pedoman Brand, dan Alur Kerja Lembaga telah diverifikasi.
      </p>
      <div class="kb__bar-actions">
        <a href="/sop" class="kb__btn">
          <iconify-icon icon="lucide:workflow" aria-hidden="true"></iconify-icon>Papan Visual SOP
        </a>
        <a href="/basis-pengetahuan/status-usulan" class="kb__btn">
          <iconify-icon icon="lucide:clipboard-list" aria-hidden="true"></iconify-icon>Status Usulan
        </a>
        <button class="kb__btn kb__btn--primary" type="button" id="btn-open-kb-modal">
          <iconify-icon icon="lucide:plus" aria-hidden="true"></iconify-icon>Ajukan Dokumen / SOP Baru
        </button>
      </div>
    </div>

    <!-- 4 KPI Cards -->
    <div class="kb__kpis">
      <div class="kb__kpi-card">
        <div class="kb__kpi-head"><span>Total Dokumen Aktif</span><span class="kb__badge kb__badge--blue">Resmi v2.3</span></div>
        <div class="kb__kpi-val">{totalDocs} <span style="font-size:13px;font-weight:500;color:var(--color-muted,#5a6875)">berkas</span></div>
      </div>
      <div class="kb__kpi-card">
        <div class="kb__kpi-head"><span>SOP Lapangan & Krisis</span><span class="kb__badge kb__badge--green">Tersertifikasi</span></div>
        <div class="kb__kpi-val">{sopCount} <span style="font-size:13px;font-weight:500;color:var(--color-muted,#5a6875)">prosedur</span></div>
      </div>
      <div class="kb__kpi-card">
        <div class="kb__kpi-head"><span>Pedoman Brand & Teknis</span><span class="kb__badge kb__badge--blue">Standar</span></div>
        <div class="kb__kpi-val">{guidelineCount} <span style="font-size:13px;font-weight:500;color:var(--color-muted,#5a6875)">pedoman</span></div>
      </div>
      <div class="kb__kpi-card">
        <div class="kb__kpi-head"><span>Alur Kerja & Template</span><span class="kb__badge kb__badge--amber">Aktif</span></div>
        <div class="kb__kpi-val">{workflowCount} <span style="font-size:13px;font-weight:500;color:var(--color-muted,#5a6875)">modul</span></div>
      </div>
    </div>

    <!-- Layout Utama -->
    <div class="kb__layout">
      <!-- Kolom Daftar Dokumen -->
      <section class="kb__card">
        <div class="kb__card-head">
          <div>
            <h2 class="kb__card-title">Daftar Prosedur Operasional & Pedoman Lembaga</h2>
            <p class="kb__card-sub">Cari, unduh template, dan baca pedoman keselamatan maupun etika liputan</p>
          </div>
          <span class="kb__badge kb__badge--blue" id="kb-counter">{totalDocs} Dokumen Tampil</span>
        </div>

        <!-- Filter Row -->
        <div class="kb__filter-row">
          <div class="kb__search">
            <iconify-icon icon="lucide:search" aria-hidden="true"></iconify-icon>
            <input type="search" id="kb-search" placeholder="Cari kode dokumen, judul SOP, etika liputan..." aria-label="Cari dokumen">
          </div>
          <select class="kb__select" id="kb-category" aria-label="Pilih kategori dokumen">
            <option value="all">Semua Kategori</option>
            {knowledgeCategories.filter(c => c !== 'Semua Kategori').map(cat => (
              <option value={cat}>{cat}</option>
            ))}
          </select>
          <select class="kb__select" id="kb-role" aria-label="Pilih akses peran">
            <option value="all">Semua Akses</option>
            <option value="admin">Akses Administrator</option>
            <option value="head">Kepala Bagian</option>
          </select>
        </div>

        <!-- List Dokumen Dinamis -->
        <div class="kb__docs" id="kb-list">
          {mockKnowledgeDocs.map(doc => {
            const isSOP = doc.category === 'SOP';
            const badgeClass = isSOP ? 'kb__badge--green' : doc.category === 'Pedoman Brand' ? 'kb__badge--blue' : 'kb__badge--amber';
            const detailUrl = isSOP ? '/sop' : `/basis-pengetahuan/${doc.code.toLowerCase()}`;
            return (
              <article class="kb__doc-item" data-category={doc.category} data-code={doc.code} data-access={doc.accessRole || 'all'}>
                <div class="kb__doc-head">
                  <div style="display:flex;align-items:center;gap:8px;">
                    <span class="kb__doc-code">{doc.code}</span>
                    <span class={`kb__badge ${badgeClass}`}>{doc.category}</span>
                  </div>
                  <span class="kb__badge kb__badge--blue">{doc.version} ({doc.updatedAt})</span>
                </div>
                <h3 class="kb__doc-title">{doc.title}</h3>
                <p class="kb__doc-desc">{doc.description}</p>
                <div class="kb__doc-meta">
                  <span><iconify-icon icon="lucide:user" aria-hidden="true"></iconify-icon> {doc.author}</span>
                  <span><iconify-icon icon="lucide:clock" aria-hidden="true"></iconify-icon> Waktu baca {doc.readTime || '5 menit'}</span>
                  <span><iconify-icon icon="lucide:shield-check" aria-hidden="true"></iconify-icon> Akses: {doc.accessRole === 'all' ? 'Semua Staf' : doc.accessRole === 'admin' ? 'Admin & Pimpinan' : 'Khusus Kepala'}</span>
                </div>
                <div class="kb__doc-actions">
                  <a href={detailUrl} class="kb__btn">
                    <iconify-icon icon="lucide:eye" aria-hidden="true"></iconify-icon>Baca Dokumen
                  </a>
                  <button class="kb__btn btn-download-doc" type="button" data-title={doc.title} data-code={doc.code}>
                    <iconify-icon icon="lucide:download" aria-hidden="true"></iconify-icon>Unduh PDF
                  </button>
                </div>
              </article>
            );
          })}
        </div>

        <div id="kb-empty" class="kb__card" style="text-align:center;padding:32px;display:none;background:var(--color-surface,#fff);margin-top:16px;">
          <iconify-icon icon="lucide:folder-search" style="font-size:36px;color:var(--color-muted,#5a6875);display:block;margin:0 auto 12px;"></iconify-icon>
          <h4 style="margin:0 0 6px;color:var(--color-text,#16202b);">Tidak Ada Dokumen yang Cocok</h4>
          <p style="margin:0;font-size:13px;color:var(--color-muted,#5a6875);">Silakan periksa kata kunci pencarian atau sesuaikan pilihan kategori dokumen.</p>
        </div>
      </section>

      <!-- Kolom Samping -->
      <aside style="display:flex;flex-direction:column;gap:16px;">
        <!-- Panel Langkah Pengajuan -->
        <div class="kb__card">
          <h2 class="kb__card-title">Alur Pengajuan SOP Baru</h2>
          <p class="kb__card-sub">Mekanisme standardisasi dokumen internal</p>
          <div class="kb__quick-guide">
            <div class="kb__guide-step">
              <div class="kb__step-num">1</div>
              <div class="kb__step-body">
                <strong>Pengajuan Draf Online</strong>
                <p>Isi formulir usulan dokumen dengan menyertakan urgensi dan naskah awal.</p>
              </div>
            </div>
            <div class="kb__guide-step">
              <div class="kb__step-num">2</div>
              <div class="kb__step-body">
                <strong>Tinjauan Komite Humas</strong>
                <p>Evaluasi keselarasan etika dan aspek hukum oleh Tim Editor (1-3 hari kerja).</p>
              </div>
            </div>
            <div class="kb__guide-step">
              <div class="kb__step-num">3</div>
              <div class="kb__step-body">
                <strong>Pengesahan Kepala Bidang</strong>
                <p>Penomoran SK resmi dan pendistribusian dokumen ke dashboard staf.</p>
              </div>
            </div>
          </div>
          <button class="kb__btn kb__btn--primary btn-open-modal-trigger" type="button" style="width:100%;margin-top:4px;">
            Mulai Usulkan Dokumen
          </button>
        </div>

        <!-- Panel Kontak Bantuan & Redaksi -->
        <div class="kb__card">
          <h2 class="kb__card-title">Kontak Bantuan & Redaksi</h2>
          <p class="kb__card-sub">Hubungi jika ada keraguan operasional lapangan</p>
          <div style="display:flex;flex-direction:column;gap:10px;font-size:12px;">
            <div style="padding:10px;border-radius:10px;background:var(--color-canvas,#f8f9fa);border:1px solid var(--color-border,#ebecee);">
              <strong style="color:var(--color-text,#16202b)">Koordinator Siaga Krisis:</strong>
              <div style="color:var(--color-muted,#5a6875);margin-top:2px;">Hotline 24 Jam: 0811-9928-112</div>
              <div style="color:var(--color-muted,#5a6875);">krisis@pedulinegeri.org</div>
            </div>
            <div style="padding:10px;border-radius:10px;background:var(--color-canvas,#f8f9fa);border:1px solid var(--color-border,#ebecee);">
              <strong style="color:var(--color-text,#16202b)">Dukungan Server DAM & IT:</strong>
              <div style="color:var(--color-muted,#5a6875);margin-top:2px;">IP NAS: 192.168.1.200</div>
              <div style="color:var(--color-muted,#5a6875);">sysadmin@pedulinegeri.org</div>
            </div>
          </div>
        </div>
      </aside>
    </div>

    <!-- Modal Form Usulan -->
    <div class="kb__modal" id="kb-modal" hidden>
      <div class="kb__dialog">
        <div class="kb__dialog-head">
          <h3 style="margin:0;font-size:16px;color:var(--color-text,#16202b);">Ajukan Dokumen / Revisi SOP</h3>
          <button type="button" class="kb__dialog-close" id="btn-close-kb-modal">✕</button>
        </div>
        <form id="kb-usulan-form">
          <div class="kb__form-group">
            <label style="display:block;margin-bottom:4px;font-size:12px;font-weight:600;color:var(--color-text,#16202b);">Jenis Usulan</label>
            <select id="modal-req-type" class="kb__select" style="width:100%;" required>
              <option value="baru">Tambah Dokumen / SOP Baru</option>
              <option value="revisi">Revisi Dokumen yang Sudah Ada</option>
            </select>
          </div>
          <div class="kb__form-group">
            <label style="display:block;margin-bottom:4px;font-size:12px;font-weight:600;color:var(--color-text,#16202b);">Judul Dokumen / SOP</label>
            <input type="text" id="modal-req-title" class="kb__select" style="width:100%;" required placeholder="Contoh: SOP Liputan Tanggap Darurat Konflik">
          </div>
          <div class="kb__form-group">
            <label style="display:block;margin-bottom:4px;font-size:12px;font-weight:600;color:var(--color-text,#16202b);">Kategori</label>
            <select id="modal-req-category" class="kb__select" style="width:100%;" required>
              <option value="SOP">SOP (Standar Operasional)</option>
              <option value="Panduan Teknis">Panduan Teknis</option>
              <option value="Pedoman Brand">Pedoman Brand</option>
              <option value="Alur Kerja">Alur Kerja</option>
              <option value="Template">Template Format Kerja</option>
            </select>
          </div>
          <div class="kb__form-group">
            <label style="display:block;margin-bottom:4px;font-size:12px;font-weight:600;color:var(--color-text,#16202b);">Nama Pengusul & Unit Kerja</label>
            <input type="text" id="modal-req-author" class="kb__select" style="width:100%;" required placeholder="Nama Anda - Unit Kerja">
          </div>
          <div class="kb__form-group">
            <label style="display:block;margin-bottom:4px;font-size:12px;font-weight:600;color:var(--color-text,#16202b);">Ringkasan Latar Belakang / Urgensi</label>
            <textarea id="modal-req-notes" rows="3" class="kb__select" style="width:100%;height:auto;padding:8px;" required placeholder="Jelaskan mengapa SOP atau dokumen ini dibutuhkan..."></textarea>
          </div>
          <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:16px;">
            <button type="button" class="kb__btn" id="btn-cancel-kb-modal">Batal</button>
            <button type="submit" class="kb__btn kb__btn--primary">Kirimkan Usulan</button>
          </div>
        </form>
      </div>
    </div>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('kb-search') as HTMLInputElement | null;
      const categorySelect = document.getElementById('kb-category') as HTMLSelectElement | null;
      const roleSelect = document.getElementById('kb-role') as HTMLSelectElement | null;
      const counterEl = document.getElementById('kb-counter');
      const emptyEl = document.getElementById('kb-empty');
      const docItems = document.querySelectorAll('.kb__doc-item');

      function filterDocs() {
        const query = (searchInput?.value || '').toLowerCase().trim();
        const cat = categorySelect?.value || 'all';
        const role = roleSelect?.value || 'all';
        let visibleCount = 0;

        docItems.forEach(el => {
          const item = el as HTMLElement;
          const text = item.textContent?.toLowerCase() || '';
          const itemCat = item.dataset.category || '';
          const itemAccess = item.dataset.access || 'all';

          const matchQuery = !query || text.includes(query);
          const matchCat = cat === 'all' || itemCat === cat;
          const matchRole = role === 'all' || itemAccess === 'all' || itemAccess === role || role === 'head';

          if (matchQuery && matchCat && matchRole) {
            item.style.display = 'flex';
            visibleCount++;
          } else {
            item.style.display = 'none';
          }
        });

        if (counterEl) {
          counterEl.textContent = `${visibleCount} Dokumen Tampil`;
        }
        if (emptyEl) {
          emptyEl.style.display = visibleCount === 0 ? 'block' : 'none';
        }
      }

      searchInput?.addEventListener('input', filterDocs);
      categorySelect?.addEventListener('change', filterDocs);
      roleSelect?.addEventListener('change', filterDocs);

      // Modal handling
      const modal = document.getElementById('kb-modal');
      const openBtn = document.getElementById('btn-open-kb-modal');
      const closeBtn = document.getElementById('btn-close-kb-modal');
      const cancelBtn = document.getElementById('btn-cancel-kb-modal');
      const openTriggers = document.querySelectorAll('.btn-open-modal-trigger');
      const form = document.getElementById('kb-usulan-form');

      function showModal() {
        if (modal) modal.hidden = false;
      }
      function hideModal() {
        if (modal) modal.hidden = true;
      }

      openBtn?.addEventListener('click', showModal);
      openTriggers.forEach(t => t.addEventListener('click', showModal));
      closeBtn?.addEventListener('click', hideModal);
      cancelBtn?.addEventListener('click', hideModal);

      form?.addEventListener('submit', (e) => {
        e.preventDefault();
        alert('Usulan berhasil dikirimkan ke antrean kurasi Kepala Bidang Humas!');
        hideModal();
        if (form instanceof HTMLFormElement) form.reset();
      });

      // Download buttons
      document.querySelectorAll('.btn-download-doc').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLElement;
          const title = target.dataset.title || 'Dokumen';
          const code = target.dataset.code || 'DOC';
          alert(`Mengunduh paket berkas resmi ${code}: ${title} (PDF).`);
        });
      });
    });
  </script>
</HumasLayout>
