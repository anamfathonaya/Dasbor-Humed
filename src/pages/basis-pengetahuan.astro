---
import {
  mockKnowledgeDocs,
  knowledgeCategories,
} from '../lib/clientDataFetcher';
import RoleNavigation from '../components/RoleNavigation.astro';

const totalDocs = mockKnowledgeDocs.length;
const sopCount = mockKnowledgeDocs.filter(d => d.category === 'SOP').length;
const guidelineCount = mockKnowledgeDocs.filter(d => d.category === 'Pedoman Brand' || d.category === 'Panduan Teknis').length;
const workflowCount = mockKnowledgeDocs.filter(d => d.category === 'Alur Kerja' || d.category === 'Template').length;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Basis Pengetahuan & SOP Lembaga (Knowledge Base) — Dasbor Humas Media</title>
  </head>
  <body>
    <RoleNavigation currentPath="/basis-pengetahuan" />

    <main>
      <!-- HEADER HALAMAN -->
      <div class="head">
        <div>
          <h2>Basis Pengetahuan & Prosedur Operasional Standar (SOP)</h2>
          <p class="muted">
            Repositori resmi pedoman peliputan bencana, etika redaksi, komunikasi krisis, alur kerja omnichannel, dan template kerja lembaga.
          </p>
        </div>
        <div class="actions">
          <a href="/basis-pengetahuan/status-usulan" class="btn btn-secondary" style="text-decoration:none; display:inline-flex; align-items:center; gap:0.4rem;">
            📋 Status Usulan & Tinjauan
          </a>
          <button class="btn" id="btn-request-doc">➕ Ajukan Revisi / Dokumen Baru</button>
        </div>
      </div>

      <!-- KARTU STATISTIK DOKUMENTASI -->
      <section class="stats">
        <div class="card hl">
          <span class="lbl">Total Dokumen Aktif</span>
          <strong>{totalDocs} Dokumen</strong>
        </div>
        <div class="card">
          <span class="lbl">SOP Prosedur Lapangan</span>
          <strong>{sopCount} Prosedur</strong>
        </div>
        <div class="card">
          <span class="lbl">Pedoman Brand & Teknis</span>
          <strong>{guidelineCount} Pedoman</strong>
        </div>
        <div class="card">
          <span class="lbl">Alur Kerja & Template</span>
          <strong>{workflowCount} Modul</strong>
        </div>
      </section>

      <!-- FILTER & PENCARIAN -->
      <section class="filter-card">
        <div class="filter-grid">
          <div class="search-box">
            <label for="filter-search">Pencarian Dokumen</label>
            <input type="text" id="filter-search" placeholder="Cari kode dokumen, judul SOP, kata kunci panduan..." />
          </div>
          <div>
            <label for="filter-category">Kategori Dokumen</label>
            <select id="filter-category">
              {knowledgeCategories.map(c => <option value={c}>{c}</option>)}
            </select>
          </div>
          <div>
            <label for="filter-access">Tingkat Akses Dokumen</label>
            <select id="filter-access">
              <option value="all">Semua Dokumen Terbuka</option>
              <option value="admin">Termasuk Akses Khusus Admin</option>
              <option value="head">Semua Tingkat Akses (Termasuk Ketua Bidang)</option>
            </select>
          </div>
        </div>
      </section>

      <!-- DAFTAR DOKUMEN -->
      <section class="box">
        <div class="box-head">
          <h3>Daftar Dokumen Resmi & Prosedur Kerja</h3>
          <span id="doc-counter" class="count-badge">{totalDocs} dokumen ditampilkan</span>
        </div>

        <div class="doc-list" id="docs-container"></div>

        <div id="empty-state" class="empty-box" hidden>
          <span class="empty-icon">📂</span>
          <h4>Tidak Ada Dokumen yang Cocok</h4>
          <p class="muted">Silakan periksa kata kunci pencarian atau sesuaikan pilihan kategori dokumen.</p>
        </div>
      </section>
    </main>

    <!-- MODAL AJUKAN REVISI / DOKUMEN BARU -->
    <dialog id="request-dialog" class="custom-dialog">
      <form id="request-form" method="dialog">
        <div class="dialog-header">
          <h3 id="dialog-heading">Formulir Usulan Dokumen & SOP Lembaga</h3>
          <button type="button" class="btn-close" id="btn-close-dialog">✕</button>
        </div>
        <div class="dialog-body">
          <div class="form-type-row">
            <label class="radio-label">
              <input type="radio" name="req-type" value="baru" checked id="radio-type-new" />
              <span>➕ Tambah Dokumen / SOP Baru</span>
            </label>
            <label class="radio-label">
              <input type="radio" name="req-type" value="revisi" id="radio-type-revision" />
              <span>🔄 Usulkan Revisi Dokumen yang Ada</span>
            </label>
          </div>

          <div id="target-doc-wrapper" class="form-group-item" hidden>
            <label for="req-target-doc">Pilih Dokumen yang Ingin Diperbarui</label>
            <select id="req-target-doc">
              {mockKnowledgeDocs.map(d => (
                <option value={d.code}>{d.code} - {d.title} ({d.version})</option>
              ))}
            </select>
          </div>

          <div class="form-group-item">
            <label for="req-title">
              Judul Usulan Dokumen / SOP <span class="req">*</span>
            </label>
            <input type="text" id="req-title" required placeholder="Contoh: SOP Liputan Tanggap Darurat Konflik dan Kerusuhan" />
          </div>

          <div class="form-row-2">
            <div class="form-group-item">
              <label for="req-category">Kategori Dokumen <span class="req">*</span></label>
              <select id="req-category" required>
                <option value="SOP">SOP (Standar Operasional)</option>
                <option value="Panduan Teknis">Panduan Teknis</option>
                <option value="Pedoman Brand">Pedoman Brand</option>
                <option value="Alur Kerja">Alur Kerja</option>
                <option value="Template">Template Format Kerja</option>
              </select>
            </div>
            <div class="form-group-item">
              <label for="req-urgency">Tingkat Urgensi Kebutuhan</label>
              <select id="req-urgency">
                <option value="Biasa">Biasa (Siklus Rapat Bulanan)</option>
                <option value="Mendesak">Mendesak (Respons Bencana Aktif)</option>
                <option value="Rutin">Penyesuaian Rutin Tahunan</option>
              </select>
            </div>
          </div>

          <div class="form-group-item">
            <label for="req-author">Nama Pengusul & Unit Kerja <span class="req">*</span></label>
            <input type="text" id="req-author" required placeholder="Contoh: Rian - Tim Liputan Bencana Wilayah Barat" />
          </div>

          <div class="form-group-item">
            <label for="req-notes">
              Uraian Latar Belakang & Rincian Poin Perubahan <span class="req">*</span>
            </label>
            <textarea id="req-notes" rows="4" required placeholder="Jelaskan kendala di lapangan, perubahan regulasi, atau draf langkah kerja baru yang diusulkan..."></textarea>
          </div>
        </div>
        <div class="dialog-footer">
          <button type="button" class="btn-ghost" id="btn-cancel-dialog">Batal</button>
          <button type="submit" class="btn" id="btn-submit-req">📨 Kirim Usulan ke Redaksi Humas</button>
        </div>
      </form>
    </dialog>

    <div id="toast" class="toast"></div>

    <script define:vars={{ initialDocs: mockKnowledgeDocs }}>
      const roleSel = document.getElementById('user-role');
      const searchEl = document.getElementById('filter-search');
      const catEl = document.getElementById('filter-category');
      const accessEl = document.getElementById('filter-access');
      const containerEl = document.getElementById('docs-container');
      const counterEl = document.getElementById('doc-counter');
      const emptyEl = document.getElementById('empty-state');
      const toast = document.getElementById('toast');

      let currentRole = 'head';
      try { currentRole = localStorage.getItem('user_role') || 'head'; } catch {}
      if (roleSel) roleSel.value = currentRole;

      function getCategoryBadgeClass(category) {
        switch (category) {
          case 'SOP': return 'badge-sop';
          case 'Pedoman Brand': return 'badge-brand';
          case 'Panduan Teknis': return 'badge-tech';
          case 'Alur Kerja': return 'badge-workflow';
          default: return 'badge-template';
        }
      }

      function renderDocs() {
        const query = (searchEl?.value || '').toLowerCase().trim();
        const selectedCat = catEl?.value || 'Semua Kategori';
        const selectedAccess = accessEl?.value || 'all';

        const filtered = initialDocs.map(doc => {
          // Cari di kode, judul, dan deskripsi utama
          let matchScore = 0;
          let matchedSnippet = '';

          if (!query) {
            matchScore = 1;
          } else {
            if (doc.code.toLowerCase().includes(query)) matchScore += 10;
            if (doc.title.toLowerCase().includes(query)) matchScore += 5;
            if (doc.description.toLowerCase().includes(query)) {
              matchScore += 3;
              matchedSnippet = doc.description;
            }

            // Pencarian mendalam di setiap section & bab
            if (doc.sections) {
              for (const sec of doc.sections) {
                if (sec.heading.toLowerCase().includes(query) || sec.content.toLowerCase().includes(query)) {
                  matchScore += 4;
                  if (!matchedSnippet) matchedSnippet = `${sec.heading}: ${sec.content}`;
                }
                if (sec.checklist) {
                  for (const chk of sec.checklist) {
                    if (chk.toLowerCase().includes(query)) {
                      matchScore += 3;
                      if (!matchedSnippet) matchedSnippet = `Daftar Periksa: ${chk}`;
                    }
                  }
                }
                if (sec.notes && sec.notes.toLowerCase().includes(query)) {
                  matchScore += 2;
                  if (!matchedSnippet) matchedSnippet = `Catatan: ${sec.notes}`;
                }
              }
            }

            // Pencarian di tahapan langkah berurutan (SOP Steps)
            if (doc.steps) {
              for (const st of doc.steps) {
                if (
                  st.title.toLowerCase().includes(query) ||
                  st.action.toLowerCase().includes(query) ||
                  st.output.toLowerCase().includes(query)
                ) {
                  matchScore += 4;
                  if (!matchedSnippet) matchedSnippet = `Langkah ${st.stepNumber} (${st.title}): ${st.action}`;
                }
              }
            }
          }

          // Filter kategori
          const matchCat = selectedCat === 'Semua Kategori' || doc.category === selectedCat;

          // Filter akses role
          let matchAccess = true;
          if (doc.accessRole === 'admin' && currentRole === 'staff') {
            matchAccess = false;
          }
          if (doc.accessRole === 'head' && (currentRole === 'staff' || currentRole === 'admin')) {
            matchAccess = false;
          }

          return {
            doc,
            isMatch: matchScore > 0 && matchCat && matchAccess,
            matchedSnippet
          };
        }).filter(item => item.isMatch);

        if (counterEl) {
          const suffix = query ? `untuk kata kunci "${query}"` : '';
          counterEl.textContent = `${filtered.length} dokumen ditemukan ${suffix}`;
        }

        if (emptyEl) {
          emptyEl.hidden = filtered.length > 0;
        }

        if (containerEl) {
          containerEl.innerHTML = filtered.map(({ doc, matchedSnippet }) => {
            const isRestricted = doc.accessRole !== 'all';
            return `
              <article class="doc-card">
                <div class="doc-top">
                  <div class="doc-meta-header">
                    <span class="doc-code">${doc.code}</span>
                    <span class="badge ${getCategoryBadgeClass(doc.category)}">${doc.category}</span>
                    <span class="doc-ver">${doc.version}</span>
                    ${isRestricted ? `<span class="badge-role">Akses: ${doc.accessRole.toUpperCase()}</span>` : ''}
                  </div>
                  <span class="read-time">⏱️ ${doc.readTime} baca</span>
                </div>

                <h4 class="doc-card-title">${doc.title}</h4>
                <p class="doc-desc">${doc.description}</p>

                ${matchedSnippet && query ? `
                  <div class="match-snippet-box">
                    <span class="snippet-label">🔍 Potongan Isi yang Cocok:</span>
                    <p class="snippet-text">"${matchedSnippet.slice(0, 160)}${matchedSnippet.length > 160 ? '...' : ''}"</p>
                  </div>
                ` : ''}

                <div class="doc-footer">
                  <div class="doc-by">
                    <span>Oleh: <strong>${doc.author}</strong></span>
                    <small>Pembaruan Terakhir: ${doc.lastUpdated}</small>
                  </div>
                  <div class="doc-actions">
                    <a href="/basis-pengetahuan/${doc.id}" class="btn-read">Buka Dokumen</a>
                    <button class="btn-download" data-id="${doc.id}" title="Unduh Salinan PDF">📥 Unduh</button>
                  </div>
                </div>
              </article>
            `;
          }).join('');
        }
      }

      // Event listener pencarian dan filter
      if (searchEl) searchEl.addEventListener('input', renderDocs);
      if (catEl) catEl.addEventListener('change', renderDocs);
      if (accessEl) accessEl.addEventListener('change', renderDocs);

      if (roleSel) {
        roleSel.addEventListener('change', (e) => {
          currentRole = e.target.value;
          try { localStorage.setItem('user_role', currentRole); } catch {}
          renderDocs();
          showToast(`Peran pengguna dialihkan ke: ${currentRole.toUpperCase()}`);
        });
      }

      // Interaksi tombol dokumen
      if (containerEl) {
        containerEl.addEventListener('click', (e) => {
          const btnRead = e.target.closest('.btn-read');
          const btnDownload = e.target.closest('.btn-download');

          if (btnRead) {
            const id = Number(btnRead.dataset.id);
            const doc = initialDocs.find(d => d.id === id);
            if (doc) {
              showToast(`Membuka rincian: ${doc.code} (${doc.title})`);
            }
          }

          if (btnDownload) {
            const id = Number(btnDownload.dataset.id);
            const doc = initialDocs.find(d => d.id === id);
            if (doc) {
              showToast(`Mengunduh salinan resmi: ${doc.code}.pdf`);
            }
          }
        });
      }

      // Dialog pengajuan revisi
      const reqDialog = document.getElementById('request-dialog');
      const btnReq = document.getElementById('btn-request-doc');
      const btnCloseDialog = document.getElementById('btn-close-dialog');
      const btnCancelDialog = document.getElementById('btn-cancel-dialog');
      const reqForm = document.getElementById('request-form');
      const radioNew = document.getElementById('radio-type-new');
      const radioRev = document.getElementById('radio-type-revision');
      const targetDocWrapper = document.getElementById('target-doc-wrapper');
      const targetDocSelect = document.getElementById('req-target-doc');
      const reqTitleInput = document.getElementById('req-title');
      const reqCategorySelect = document.getElementById('req-category');
      const reqAuthorInput = document.getElementById('req-author');
      const reqNotesTextarea = document.getElementById('req-notes');

      function toggleFormType() {
        const isRevision = radioRev?.checked;
        if (targetDocWrapper) targetDocWrapper.hidden = !isRevision;
        if (isRevision && targetDocSelect && reqTitleInput) {
          const selectedCode = targetDocSelect.value;
          const found = initialDocs.find(d => d.code === selectedCode);
          if (found) {
            reqTitleInput.value = `Revisi: ${found.title}`;
            if (reqCategorySelect) reqCategorySelect.value = found.category;
          }
        }
      }

      if (radioNew) radioNew.addEventListener('change', toggleFormType);
      if (radioRev) radioRev.addEventListener('change', toggleFormType);
      if (targetDocSelect) targetDocSelect.addEventListener('change', toggleFormType);

      if (btnReq) {
        btnReq.addEventListener('click', () => {
          if (radioNew) radioNew.checked = true;
          toggleFormType();
          reqDialog?.showModal();
        });
      }

      [btnCloseDialog, btnCancelDialog].forEach(btn => {
        if (btn) btn.addEventListener('click', () => reqDialog?.close());
      });

      if (reqForm) {
        reqForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const title = reqTitleInput?.value.trim() || 'Dokumen Usulan';
          const cat = reqCategorySelect?.value || 'SOP';
          const author = reqAuthorInput?.value.trim() || 'Staf Humas';
          const notes = reqNotesTextarea?.value.trim() || '';
          const isRevision = radioRev?.checked;

          if (isRevision) {
            const targetCode = targetDocSelect?.value;
            const existingDoc = initialDocs.find(d => d.code === targetCode);
            if (existingDoc) {
              existingDoc.lastUpdated = 'Hari ini (Diusulkan)';
              existingDoc.version = `${existingDoc.version}-rev`;
              existingDoc.description = `${existingDoc.description} [Catatan Revisi Diajukan: ${notes.slice(0, 80)}...]`;
            }
            showToast(`Usulan revisi untuk "${targetCode}" berhasil diajukan ke Dewan Redaksi!`);
          } else {
            const nextId = initialDocs.length ? Math.max(...initialDocs.map(d => d.id)) + 1 : 1;
            const newCode = `USUL-${cat.slice(0, 3).toUpperCase()}-0${nextId}`;
            const newDoc = {
              id: nextId,
              code: newCode,
              title: title,
              category: cat,
              description: notes || 'Usulan dokumen operasional baru yang diajukan oleh staf divisi.',
              lastUpdated: 'Hari ini',
              author: author,
              version: 'v1.0-draft',
              accessRole: 'all',
              readTime: '5 menit',
              sections: [
                {
                  heading: '1. Latar Belakang Kebutuhan Operasional',
                  content: notes || 'Dokumen ini diajukan untuk melengkapi kebutuhan standarisasi kerja di lapangan.'
                }
              ]
            };
            initialDocs.unshift(newDoc);
            showToast(`Usulan dokumen baru "${title}" (${newCode}) berhasil didaftarkan!`);
          }

          reqDialog?.close();
          reqForm.reset();
          renderDocs();
        });
      }

      function showToast(msg) {
        if (!toast) return;
        toast.textContent = msg;
        toast.classList.add('show');
        setTimeout(() => toast.classList.remove('show'), 2500);
      }

      // Render awal
      renderDocs();
    </script>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
    background: #f8fafc;
    color: #1e293b;
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.85rem 1.75rem;
    background: #0f172a;
    color: #fff;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .brand { display: flex; align-items: center; gap: 0.6rem; }
  .top h1 { font-size: 1.1rem; margin: 0; color: #f8fafc; }
  .top nav { display: flex; gap: 1.25rem; flex-wrap: wrap; }
  .top nav a { color: #94a3b8; text-decoration: none; font-size: 0.9rem; }
  .top nav a.active, .top nav a:hover { color: #38bdf8; }
  .role { display: flex; gap: 0.5rem; align-items: center; font-size: 0.8rem; }
  .role select { font: inherit; padding: 0.25rem 0.5rem; border-radius: 6px; border: 1px solid #334155; background: #1e293b; color: #f8fafc; }

  main { max-width: 1320px; margin: 0 auto; padding: 1.5rem; }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .head h2 { margin: 0 0 0.25rem; font-size: 1.35rem; color: #0f172a; }
  .muted { margin: 0; color: #64748b; font-size: 0.9rem; line-height: 1.5; }
  .actions { display: flex; gap: 0.6rem; }

  .btn {
    font: inherit;
    background: #0284c7;
    color: #fff;
    border: 0;
    padding: 0.55rem 1rem;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.15s;
  }
  .btn:hover { background: #0369a1; }
  .btn-ghost {
    font: inherit;
    background: #fff;
    border: 1px solid #cbd5e1;
    color: #334155;
    padding: 0.55rem 1rem;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
  }
  .btn-ghost:hover { background: #f1f5f9; }

  /* STATS CARDS */
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .card {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 1.15rem;
  }
  .card.hl { border-left: 4px solid #0284c7; }
  .card .lbl { display: block; font-size: 0.8rem; color: #64748b; margin-bottom: 0.3rem; }
  .card strong { font-size: 1.25rem; color: #0f172a; }

  /* FILTER CARD */
  .filter-card {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 1.25rem;
    margin-bottom: 1.5rem;
  }
  .filter-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 1rem;
    align-items: flex-end;
  }
  @media (max-width: 860px) {
    .filter-grid { grid-template-columns: 1fr; }
  }
  .filter-grid label {
    display: block;
    font-size: 0.78rem;
    font-weight: 600;
    color: #475569;
    margin-bottom: 0.35rem;
  }
  .filter-grid input, .filter-grid select {
    width: 100%;
    font: inherit;
    padding: 0.5rem 0.75rem;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-size: 0.88rem;
    background: #fff;
  }
  .filter-grid input:focus, .filter-grid select:focus {
    outline: none;
    border-color: #0284c7;
    box-shadow: 0 0 0 3px rgba(2,132,199,0.15);
  }

  /* BOX & LIST */
  .box {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 1.35rem;
  }
  .box-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .box-head h3 { margin: 0; font-size: 1.05rem; color: #0f172a; }
  .count-badge {
    background: #f1f5f9;
    color: #475569;
    font-size: 0.78rem;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    font-weight: 600;
  }

  .doc-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 1.25rem;
  }
  @media (max-width: 600px) {
    .doc-list { grid-template-columns: 1fr; }
  }

  .doc-card {
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 1.2rem;
    background: #fafbfc;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.15s, border-color 0.15s;
  }
  .doc-card:hover {
    border-color: #cbd5e1;
    background: #fff;
    transform: translateY(-2px);
  }

  .doc-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }
  .doc-meta-header {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .doc-code {
    font-size: 0.75rem;
    font-family: ui-monospace, "Segoe UI Mono", monospace;
    font-weight: 700;
    background: #0f172a;
    color: #fff;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
  }
  .doc-ver {
    font-size: 0.72rem;
    color: #64748b;
    font-weight: 600;
  }
  .read-time {
    font-size: 0.72rem;
    color: #64748b;
  }

