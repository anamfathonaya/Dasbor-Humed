---
import HumasLayout from '../layouts/HumasLayout.astro';
import {
  mockUsers,
  mockAuditLogs,
} from '../lib/clientDataFetcher';
---

<HumasLayout
  title="Manajemen Akun & Log Audit — Humas Internal Peduli Negeri"
  pageTitle="Manajemen Akun & Log Audit"
  pageSubtitle="Manajemen pengguna, hak akses berbasis peran (RBAC), dan pemantauan jejak audit keamanan"
  currentPath="/manajemen-akun"
  pageContentId="akun"
>
  <main class="akn" data-node-id="akun.main">
    <!-- Sub Navigasi Pengaturan & Detail -->
    <div style="display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap;">
      <a href="/pengaturan" class="akn__btn">
        <iconify-icon icon="lucide:plug-zap" aria-hidden="true"></iconify-icon>Pusat Pengaturan
      </a>
      <a href="/manajemen-akun" class="akn__btn" style="background:var(--color-primary,#1d5c94);color:#fff;font-weight:600;">
        <iconify-icon icon="lucide:users" aria-hidden="true"></iconify-icon>Akun & Hak Akses
      </a>
      <a href="/jejak-audit" class="akn__btn">
        <iconify-icon icon="lucide:shield-check" aria-hidden="true"></iconify-icon>Jejak Audit
      </a>
      <a href="/profil-akun" class="akn__btn">
        <iconify-icon icon="lucide:user" aria-hidden="true"></iconify-icon>Profil Saya
      </a>
    </div>

    <!-- Top Bar -->
    <div class="akn__bar">
      <p class="akn__bar-text">
        <b>Pengelolaan Akses Tim:</b> {mockUsers.length} Pengguna terdaftar, otorisasi RBAC aktif, dan jejak audit tersimpan aman.
      </p>
      <div class="akn__bar-actions">
        <a href="/pengaturan" class="akn__btn">
          <iconify-icon icon="lucide:arrow-left" aria-hidden="true"></iconify-icon>Pusat Pengaturan
        </a>
        <button class="akn__btn akn__btn--primary" type="button" id="btn-open-add-user">
          <iconify-icon icon="lucide:user-plus" aria-hidden="true"></iconify-icon>Undang Pengguna Baru
        </button>
      </div>
    </div>

    <!-- 4 KPI Cards -->
    <div class="akn__kpis">
      <div class="akn__kpi-card">
        <div class="akn__kpi-head"><span>Pengguna Aktif</span><span class="akn__badge akn__badge--green">Online</span></div>
        <div class="akn__kpi-val">{mockUsers.length} <span style="font-size:13px;font-weight:500;color:var(--color-muted,#5a6875)">personil</span></div>
      </div>
      <div class="akn__kpi-card">
        <div class="akn__kpi-head"><span>Tingkat Peran (RBAC)</span><span class="akn__badge akn__badge--blue">4 Level</span></div>
        <div class="akn__kpi-val">4 <span style="font-size:13px;font-weight:500;color:var(--color-muted,#5a6875)">tingkatan</span></div>
      </div>
      <div class="akn__kpi-card">
        <div class="akn__kpi-head"><span>Aktivitas Hari Ini</span><span class="akn__badge akn__badge--blue">Log Audit</span></div>
        <div class="akn__kpi-val">128 <span style="font-size:13px;font-weight:500;color:var(--color-muted,#5a6875)">event</span></div>
      </div>
      <div class="akn__kpi-card">
        <div class="akn__kpi-head"><span>Percobaan Gagal (Anomali)</span><span class="akn__badge akn__badge--amber">Terblokir</span></div>
        <div class="akn__kpi-val">1 <span style="font-size:13px;font-weight:500;color:var(--color-muted,#5a6875)">percobaan</span></div>
      </div>
    </div>

    <!-- Tabel Pengguna -->
    <section class="akn__card">
      <div class="akn__card-head">
        <div>
          <h2 class="akn__card-title">Daftar Akun Pengguna & Hak Akses</h2>
          <p class="akn__card-sub">Hak kelola modul konten, persetujuan anggaran, dan administrasi sistem</p>
        </div>
      </div>

      <div class="akn__table-wrap">
        <table class="akn__table">
          <thead>
            <tr>
              <th>Pengguna</th>
              <th>Peran Lembaga</th>
              <th>Unit Kerja</th>
              <th>Status Akun</th>
              <th>Aktivitas Terakhir</th>
              <th>Aksi</th>
            </tr>
          </thead>
          <tbody>
            {mockUsers.map(user => {
              const initials = user.name.split(' ').map(n => n[0]).slice(0, 2).join('').toUpperCase();
              const roleBadgeClass = user.role === 'head' ? 'akn__badge--blue' : user.role === 'admin' ? 'akn__badge--blue' : 'akn__badge--green';
              const roleTitle = user.role === 'head' ? 'Kepala Bagian Humas' : user.role === 'admin' ? 'Administrator Teknis' : user.role === 'reviewer' ? 'Peninjau Redaksi' : 'Staf Konten';
              return (
                <tr>
                  <td>
                    <div style="display:flex;align-items:center;gap:10px;">
                      <span class="akn__avatar">{initials}</span>
                      <div>
                        <strong style="display:block;font-size:13px;">{user.name}</strong>
                        <span style="font-size:11px;color:var(--color-muted,#5a6875);">{user.email}</span>
                      </div>
                    </div>
                  </td>
                  <td><span class={`akn__badge ${roleBadgeClass}`}>{roleTitle}</span></td>
                  <td>{user.unit || 'Divisi Komunikasi & Publikasi'}</td>
                  <td><span class="akn__badge akn__badge--green">Aktif</span></td>
                  <td style="font-size:12px;color:var(--color-muted,#5a6875);">{user.lastActive || 'Baru saja'}</td>
                  <td><button class="akn__btn btn-manage-user" type="button" data-name={user.name}>Kelola</button></td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Tabel Log Audit Keamanan -->
    <section class="akn__card">
      <div class="akn__card-head">
        <div>
          <h2 class="akn__card-title">Jejak Audit Keamanan Sistem Terbaru</h2>
          <p class="akn__card-sub">Rekaman kronologis operasi penting, autentikasi, dan perubahan data</p>
        </div>
        <button class="akn__btn" type="button" id="btn-export-audit">
          <iconify-icon icon="lucide:download" aria-hidden="true"></iconify-icon>Ekspor Log Audit
        </button>
      </div>

      <div class="akn__table-wrap">
        <table class="akn__table">
          <thead>
            <tr>
              <th>Waktu Kejadian</th>
              <th>Nama Pengguna</th>
              <th>Tindakan / Operasi</th>
              <th>Target Objek</th>
              <th>Alamat IP</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td style="font-size:12px;color:var(--color-muted,#5a6875);">11 Okt 2026, 20:35 WIB</td>
              <td><strong>Budi Santoso</strong> <span style="font-size:11px;color:var(--color-muted,#7a8794);">(Admin)</span></td>
              <td>Perbaruan Konfigurasi Integrasi</td>
              <td><code>Akun Google SSO Token (Google AI Pro)</code></td>
              <td>192.168.1.45 (Kantor)</td>
              <td><span class="akn__badge akn__badge--green">Sukses</span></td>
            </tr>
            <tr>
              <td style="font-size:12px;color:var(--color-muted,#5a6875);">11 Okt 2026, 19:42 WIB</td>
              <td><strong>Rani Maulida</strong> <span style="font-size:11px;color:var(--color-muted,#7a8794);">(Kepala Humas)</span></td>
              <td>Pengesahan Revisi SOP Humas</td>
              <td><code>SOP-HUMAS-2025-01 (Kanal Krisis)</code></td>
              <td>180.252.16.89 (VPN Eksternal)</td>
              <td><span class="akn__badge akn__badge--green">Sukses</span></td>
            </tr>
            <tr>
              <td style="font-size:12px;color:var(--color-muted,#5a6875);">11 Okt 2026, 13:02 WIB</td>
              <td><strong>Percobaan Tamu</strong> <span style="font-size:11px;color:var(--color-muted,#7a8794);">(Anonim)</span></td>
              <td>Gagal Autentikasi Pengguna</td>
              <td><code>admin.backup@pedulinegeri.org (3x Salah)</code></td>
              <td>114.124.201.33 (Luar Jaringan)</td>
              <td><span class="akn__badge akn__badge--amber">Gagal / Anomali</span></td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      document.getElementById('btn-open-add-user')?.addEventListener('click', () => {
        const email = prompt('Masukkan alamat email staf baru yang ingin diundang:');
        if (email) {
          alert(`Undangan aktivasi akun berhasil dikirimkan ke ${email}`);
        }
      });

      document.getElementById('btn-export-audit')?.addEventListener('click', () => {
        alert('Mengunduh rekaman audit log format CSV...');
      });

      document.querySelectorAll('.btn-manage-user').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLElement;
          const name = target.dataset.name || 'Pengguna';
          alert(`Membuka modal pengelolaan hak akses untuk ${name}`);
        });
      });
    });
  </script>
</HumasLayout>
