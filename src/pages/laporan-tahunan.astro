---
import HumasLayout from '../layouts/HumasLayout.astro';
import {
  mockAnnualReportsByYear,
  mockBudgetLines,
} from '../lib/clientDataFetcher';
import { formatRupiah, formatNumber } from '../lib/format';

const availableYears = Object.keys(mockAnnualReportsByYear).sort((a, b) => Number(b) - Number(a));
---

<HumasLayout
  title="Laporan Tahunan — Humas Internal Peduli Negeri"
  pageTitle="Laporan Tahunan & Rencana Kerja"
  pageSubtitle="Kompilasi capaian tahunan, realisasi serapan anggaran (RAB & LRA), dan indikator dampak kemanusiaan"
  currentPath="/laporan-tahunan"
  pageContentId="laporan"
>
  <main class="lap" data-node-id="laporan.tahunan">
    <!-- Sub-Navigasi Modul Laporan Detail -->
    <div style="display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap;">
      <a href="/laporan" class="lap__mini" style="padding:6px 14px;border-radius:8px;text-decoration:none;border:1px solid var(--color-border,#dbe1e8);background:var(--color-surface,#fff);color:var(--color-text,#16202b);">
        Ringkasan Semua Laporan
      </a>
      <a href="/laporan-kinerja" class="lap__mini" style="padding:6px 14px;border-radius:8px;text-decoration:none;border:1px solid var(--color-border,#dbe1e8);background:var(--color-surface,#fff);color:var(--color-text,#16202b);">
        Laporan Kinerja Kanal
      </a>
      <a href="/laporan-anggaran" class="lap__mini" style="padding:6px 14px;border-radius:8px;text-decoration:none;border:1px solid var(--color-border,#dbe1e8);background:var(--color-surface,#fff);color:var(--color-text,#16202b);">
        Laporan Anggaran
      </a>
      <a href="/daftar-rab-lra" class="lap__mini" style="padding:6px 14px;border-radius:8px;text-decoration:none;border:1px solid var(--color-border,#dbe1e8);background:var(--color-surface,#fff);color:var(--color-text,#16202b);">
        Daftar RAB & LRA
      </a>
      <a href="/laporan-tahunan" class="lap__mini" style="background:var(--color-primary,#1d5c94);color:#fff;font-weight:600;padding:6px 14px;border-radius:8px;text-decoration:none;">
        Laporan Tahunan
      </a>
      <a href="/bagikan-cetak" class="lap__mini" style="padding:6px 14px;border-radius:8px;text-decoration:none;border:1px solid var(--color-border,#dbe1e8);background:var(--color-surface,#fff);color:var(--color-text,#16202b);">
        Bagikan & Cetak
      </a>
    </div>

    <!-- Filter Tahun & Toolbar -->
    <div class="lap__card" style="margin-bottom:16px;padding:16px;">
      <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;">
        <div style="display:flex;align-items:center;gap:10px;">
          <label style="font-size:12px;font-weight:600;">Tahun Buku:</label>
          <select id="select-year" class="lap__select">
            {availableYears.map(y => <option value={y} selected={y === '2026'}>Tahun {y}</option>)}
          </select>
        </div>
        <button class="lap__btn lap__btn--primary" type="button" onclick="window.print()">
          <iconify-icon icon="lucide:printer" aria-hidden="true"></iconify-icon> Cetak / Unduh PDF
        </button>
      </div>
    </div>

    <!-- Banner Tema Tahunan -->
    <div class="lap__card" style="margin-bottom:20px;background:linear-gradient(135deg, #1d5c94 0%, #0d2841 100%);color:#fff;padding:24px;">
      <span class="lap__badge lap__badge--final" id="display-year-tag" style="background:rgba(255,255,255,0.2);color:#fff;">Laporan Tahunan 2026</span>
      <h1 id="display-theme" style="margin:12px 0 6px;font-size:24px;font-weight:700;">Menjangkau yang Terjauh</h1>
      <p id="display-summary" style="margin:0;font-size:14px;opacity:0.9;max-width:700px;line-height:1.5;">Ringkasan eksekutif program...</p>
    </div>

    <!-- 4 KPI Cards Tahunan -->
    <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));gap:16px;margin-bottom:20px;">
      <div class="lap__card" style="padding:16px;">
        <span style="font-size:12px;color:var(--color-muted,#5a6875);display:block;margin-bottom:4px;">Total Donatur Terhimpun</span>
        <strong id="stat-donors" style="font-size:20px;color:var(--color-primary,#1d5c94);">0</strong>
      </div>
      <div class="lap__card" style="padding:16px;">
        <span style="font-size:12px;color:var(--color-muted,#5a6875);display:block;margin-bottom:4px;">Penerima Manfaat (Jiwa)</span>
        <strong id="stat-beneficiaries" style="font-size:20px;color:var(--color-text,#16202b);">0</strong>
      </div>
      <div class="lap__card" style="padding:16px;">
        <span style="font-size:12px;color:var(--color-muted,#5a6875);display:block;margin-bottom:4px;">Total Donasi Terhimpun</span>
        <strong id="stat-raised" style="font-size:20px;color:#10b981;">Rp 0</strong>
      </div>
      <div class="lap__card" style="padding:16px;">
        <span style="font-size:12px;color:var(--color-muted,#5a6875);display:block;margin-bottom:4px;">Total Dana Disalurkan</span>
        <strong id="stat-distributed" style="font-size:20px;color:var(--color-primary,#1d5c94);">Rp 0</strong>
      </div>
    </div>

    <!-- Rencana Program per Kuartal -->
    <section class="lap__card" style="margin-bottom:20px;">
      <div class="lap__toolbar">
        <div>
          <h2 style="font-size:15px;margin:0;">Progres Rencana Kerja per Kuartal</h2>
          <p style="font-size:12px;color:var(--color-muted,#5a6875);margin:2px 0 0;">Capaian sasaran fisik dan jadwal eksekusi</p>
        </div>
      </div>
      <div id="quarterly-cards" style="display:grid;grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));gap:16px;margin-top:16px;"></div>
    </section>

    <!-- Tonggak Capaian (Milestones) -->
    <section class="lap__card">
      <div class="lap__toolbar">
        <div>
          <h2 style="font-size:15px;margin:0;">Tonggak Capaian (Milestones) Utama</h2>
          <p style="font-size:12px;color:var(--color-muted,#5a6875);margin:2px 0 0;">Peristiwa kunci dan akselerasi dampak kemanusiaan</p>
        </div>
      </div>
      <div id="milestones-timeline" style="display:flex;flex-direction:column;gap:12px;margin-top:16px;"></div>
    </section>
  </main>

  <script define:vars={{ reportData: mockAnnualReportsByYear }}>
    document.addEventListener('DOMContentLoaded', () => {
      const yearSelect = document.getElementById('select-year');
      const themeTag = document.getElementById('display-year-tag');
      const themeTitle = document.getElementById('display-theme');
      const themeDesc = document.getElementById('display-summary');
      const statDonors = document.getElementById('stat-donors');
      const statBeneficiaries = document.getElementById('stat-beneficiaries');
      const statRaised = document.getElementById('stat-raised');
      const statDistributed = document.getElementById('stat-distributed');
      const quarterContainer = document.getElementById('quarterly-cards');
      const milestonesContainer = document.getElementById('milestones-timeline');

      const fmtRupiah = (val) => 'Rp ' + Number(val).toLocaleString('id-ID');
      const fmtNum = (val) => Number(val).toLocaleString('id-ID');

      function updateYear(year) {
        const data = reportData[year] || reportData['2026'];
        if (!data) return;

        if (themeTag) themeTag.textContent = `Laporan Tahunan ${data.year}`;
        if (themeTitle) themeTitle.textContent = data.theme;
        if (themeDesc) themeDesc.textContent = data.summary;

        if (statDonors) statDonors.textContent = fmtNum(data.donorsCount);
        if (statBeneficiaries) statBeneficiaries.textContent = fmtNum(data.beneficiariesCount);
        if (statRaised) statRaised.textContent = fmtRupiah(data.totalRaised);
        if (statDistributed) statDistributed.textContent = fmtRupiah(data.totalDistributed);

        if (quarterContainer) {
          quarterContainer.innerHTML = data.quarterlyPlan.map((q) => `
            <div style="padding:14px;border-radius:8px;border:1px solid var(--color-border,#ebecee);background:var(--color-canvas,#f8f9fa);">
              <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
                <strong style="color:var(--color-primary,#1d5c94);font-size:13px;">${q.quarter}</strong>
                <span class="lap__badge lap__badge--final">${q.progress}% Selesai</span>
              </div>
              <p style="margin:0 0 10px;font-size:12px;color:var(--color-text,#16202b);">${q.target}</p>
              <div style="height:6px;background:var(--color-border,#ebecee);border-radius:3px;overflow:hidden;">
                <div style="height:100%;background:var(--color-primary,#1d5c94);width:${q.progress}%;"></div>
              </div>
            </div>
          `).join('');
        }

        if (milestonesContainer) {
          milestonesContainer.innerHTML = data.milestones.map((m) => `
            <div style="display:flex;gap:12px;align-items:flex-start;padding:12px;border-radius:8px;border:1px solid var(--color-border,#ebecee);background:var(--color-canvas,#f8f9fa);">
              <span class="lap__badge lap__badge--draf" style="white-space:nowrap;">${m.date}</span>
              <div>
                <strong style="font-size:13px;display:block;margin-bottom:2px;">${m.title}</strong>
                <p style="margin:0;font-size:12px;color:var(--color-muted,#5a6875);">${m.description}</p>
              </div>
            </div>
          `).join('');
        }
      }

      yearSelect?.addEventListener('change', (e) => {
        updateYear(e.target.value);
      });

      updateYear('2026');
    });
  </script>
</HumasLayout>
