---
import HumasLayout from '../layouts/HumasLayout.astro';
import { mockAuditLogs } from '../lib/clientDataFetcher';

const extendedAuditLogs = [
  ...mockAuditLogs,
  {
    id: 'aud-104',
    timestamp: '11 Okt 2026, 11:20 WIB',
    userName: 'Budi Santoso',
    userRole: 'Administrator Teknis',
    action: 'Penambahan Pemetaan Folder DAM',
    target: 'smb://192.168.1.200/dam-humas/audio-arsip',
    ipAddress: '192.168.1.45 (Jaringan Kantor)',
    status: 'success' as const
  },
  {
    id: 'aud-103',
    timestamp: '10 Okt 2026, 16:45 WIB',
    userName: 'Rani Maulida',
    userRole: 'Ketua Bidang Humas',
    action: 'Perubahan Matriks Izin RBAC',
    target: 'Modul Anggaran: Pembatasan Akses Staf Konten',
    ipAddress: '180.252.16.89 (VPN Eksternal)',
    status: 'success' as const
  },
  {
    id: 'aud-102',
    timestamp: '10 Okt 2026, 09:12 WIB',
    userName: 'Dewi Lestari',
    userRole: 'Staf Kreatif & Konten',
    action: 'Pembaruan Profil & Kontak Pribadi',
    target: 'dewi.creative@pedulinegeri.org',
    ipAddress: '192.168.1.88 (Jaringan Kantor)',
    status: 'success' as const
  },
  {
    id: 'aud-101',
    timestamp: '09 Okt 2026, 22:18 WIB',
    userName: 'Sistem Keamanan Firewall',
    userRole: 'Otomatisasi',
    action: 'Blokir Percobaan Brute-Force',
    target: 'IP: 103.111.45.12 (Upaya 5x Salah Sandi)',
    ipAddress: '103.111.45.12 (Luar Negeri)',
    status: 'warning' as const
  }
];
---

<HumasLayout
  title="Jejak Audit Keamanan — Humas Internal Peduli Negeri"
  pageTitle="Jejak Audit Perubahan & Keamanan"
  pageSubtitle="Rekam jejak tidak dapat diubah (immutable audit trail) untuk setiap modifikasi parameter sistem & otorisasi"
  currentPath="/jejak-audit"
  pageContentId="akun"
>
  <main class="akn" data-node-id="audit.main">
    <!-- Sub Navigasi Pengaturan & Detail -->
    <div style="display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap;">
      <a href="/pengaturan" class="akn__btn">
        <iconify-icon icon="lucide:plug-zap" aria-hidden="true"></iconify-icon>Pusat Pengaturan
      </a>
      <a href="/manajemen-akun" class="akn__btn">
        <iconify-icon icon="lucide:users" aria-hidden="true"></iconify-icon>Akun & Hak Akses
      </a>
      <a href="/jejak-audit" class="akn__btn" style="background:var(--color-primary,#1d5c94);color:#fff;font-weight:600;">
        <iconify-icon icon="lucide:shield-check" aria-hidden="true"></iconify-icon>Jejak Audit
      </a>
      <a href="/profil-akun" class="akn__btn">
        <iconify-icon icon="lucide:user" aria-hidden="true"></iconify-icon>Profil Saya
      </a>
    </div>

    <!-- Top Bar -->
    <div class="akn__bar">
      <p class="akn__bar-text">
        <b>Audit Trail Aktif:</b> {extendedAuditLogs.length} Peristiwa tercatat bulan ini, integritas log tersimpan aman.
      </p>
      <div class="akn__bar-actions">
        <a href="/pengaturan" class="akn__btn">
          <iconify-icon icon="lucide:arrow-left" aria-hidden="true"></iconify-icon>Kembali ke Pengaturan
        </a>
        <button class="akn__btn akn__btn--primary" type="button" id="btn-export-audit-csv">
          <iconify-icon icon="lucide:download" aria-hidden="true"></iconify-icon>Unduh Berkas Audit (CSV)
        </button>
      </div>
    </div>

    <!-- 4 KPI Cards -->
    <div class="akn__kpis">
      <div class="akn__kpi-card">
        <div class="akn__kpi-head"><span>Total Peristiwa Tercatat</span><span class="akn__badge akn__badge--blue">Oktober 2026</span></div>
        <div class="akn__kpi-val">{extendedAuditLogs.length} <span style="font-size:13px;font-weight:500;color:var(--color-muted,#5a6875)">log</span></div>
      </div>
      <div class="akn__kpi-card">
        <div class="akn__kpi-head"><span>Aksi Sukses Terverifikasi</span><span class="akn__badge akn__badge--green">RBAC Valid</span></div>
        <div class="akn__kpi-val">7 <span style="font-size:13px;font-weight:500;color:var(--color-muted,#5a6875)">kejadian</span></div>
      </div>
      <div class="akn__kpi-card">
        <div class="akn__kpi-head"><span>Peringatan Keamanan</span><span class="akn__badge akn__badge--amber">Anomali IP</span></div>
        <div class="akn__kpi-val">1 <span style="font-size:13px;font-weight:500;color:var(--color-muted,#5a6875)">kasus</span></div>
      </div>
      <div class="akn__kpi-card">
        <div class="akn__kpi-head"><span>Upaya Akses Gagal</span><span class="akn__badge akn__badge--amber">Terblokir</span></div>
        <div class="akn__kpi-val">1 <span style="font-size:13px;font-weight:500;color:var(--color-muted,#5a6875)">kasus</span></div>
      </div>
    </div>

    <!-- Filter Bar -->
    <div class="akn__card" style="margin-bottom:16px;">
      <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:center;">
        <div style="flex:1;min-width:240px;">
          <input
            type="search"
            id="search-audit"
            placeholder="Cari berdasarkan nama pengguna, jenis tindakan, atau objek sasaran..."
            class="kb__select"
            style="width:100%;height:38px;padding:0 12px;"
          />
        </div>
        <div>
          <select id="filter-audit-status" class="kb__select" style="height:38px;">
            <option value="all">Semua Status</option>
            <option value="success">Berhasil Saja</option>
            <option value="warning">Peringatan</option>
            <option value="failed">Gagal Saja</option>
          </select>
        </div>
        <div>
          <select id="filter-audit-role" class="kb__select" style="height:38px;">
            <option value="all">Semua Peran Pelaku</option>
            <option value="Administrator Teknis">Administrator Teknis</option>
            <option value="Ketua Bagian Humas">Ketua Bidang</option>
            <option value="Staf">Staf Konten</option>
            <option value="Otomatisasi">Sistem Otomatis</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Tabel Log Audit -->
    <section class="akn__card">
      <div class="akn__card-head">
        <div>
          <h2 class="akn__card-title">Rekaman Kronologis Log Audit Sistem</h2>
          <p class="akn__card-sub">Dipantau dengan timestamp presisi dan pengikatan alamat IP perangkat</p>
        </div>
      </div>

      <div class="akn__table-wrap">
        <table class="akn__table">
          <thead>
            <tr>
              <th>ID & Waktu Kejadian</th>
              <th>Pelaku & Peran</th>
              <th>Tindakan / Operasi</th>
              <th>Objek Sasaran</th>
              <th>Alamat IP & Jaringan</th>
              <th>Hasil</th>
            </tr>
          </thead>
          <tbody id="audit-tbody">
            {extendedAuditLogs.map((log) => (
              <tr data-status={log.status} data-text={`${log.userName} ${log.action} ${log.target} ${log.userRole}`.toLowerCase()}>
                <td>
                  <strong style="display:block;font-size:12px;font-family:monospace;color:var(--color-primary,#1d5c94);">{log.id}</strong>
                  <span style="font-size:11px;color:var(--color-muted,#5a6875);">{log.timestamp}</span>
                </td>
                <td>
                  <strong style="display:block;font-size:13px;">{log.userName}</strong>
                  <span style="font-size:11px;color:var(--color-muted,#5a6875);">{log.userRole}</span>
                </td>
                <td>
                  <strong style="color:var(--color-text,#16202b);font-size:13px;">{log.action}</strong>
                </td>
                <td>
                  <code style="font-size:12px;background:var(--color-canvas,#f8f9fa);padding:2px 6px;border-radius:4px;border:1px solid var(--color-border,#ebecee);word-break:break-all;">{log.target}</code>
                </td>
                <td>
                  <span style="font-size:12px;color:var(--color-muted,#5a6875);">{log.ipAddress}</span>
                </td>
                <td>
                  <span class={`akn__badge ${log.status === 'success' ? 'akn__badge--green' : 'akn__badge--amber'}`}>
                    ● {log.status === 'success' ? 'Berhasil' : log.status === 'warning' ? 'Peringatan' : 'Gagal'}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('search-audit') as HTMLInputElement | null;
      const statusSelect = document.getElementById('filter-audit-status') as HTMLSelectElement | null;
      const roleSelect = document.getElementById('filter-audit-role') as HTMLSelectElement | null;
      const rows = document.querySelectorAll('#audit-tbody tr');

      function filterAudit() {
        const query = (searchInput?.value || '').toLowerCase().trim();
        const status = statusSelect?.value || 'all';
        const role = (roleSelect?.value || 'all').toLowerCase();

        rows.forEach(r => {
          const row = r as HTMLElement;
          const text = row.getAttribute('data-text') || '';
          const rowStatus = row.getAttribute('data-status') || '';

          const matchQuery = !query || text.includes(query);
          const matchStatus = status === 'all' || rowStatus === status;
          const matchRole = role === 'all' || text.includes(role);

          if (matchQuery && matchStatus && matchRole) {
            row.style.display = '';
          } else {
            row.style.display = 'none';
          }
        });
      }

      searchInput?.addEventListener('input', filterAudit);
      statusSelect?.addEventListener('change', filterAudit);
      roleSelect?.addEventListener('change', filterAudit);

      document.getElementById('btn-export-audit-csv')?.addEventListener('click', () => {
        alert('Mengunduh rekaman audit log lengkap format CSV...');
      });
    });
  </script>
</HumasLayout>
