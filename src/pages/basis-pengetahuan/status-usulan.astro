---
import { mockProposals, type DocumentProposal } from '../../data/mockKnowledge';

// Hitung metrik awal dari mock
const totalProposals = mockProposals.length;
const pendingCount = mockProposals.filter(p => p.status === 'menunggu_tinjauan').length;
const approvedCount = mockProposals.filter(p => p.status === 'disetujui').length;
const needsRevisionCount = mockProposals.filter(p => p.status === 'perlu_revisi').length;
const rejectedCount = mockProposals.filter(p => p.status === 'ditolak').length;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Status Usulan & Panel Tinjauan Dokumen SOP (Dasbor Humas Media)</title>
  </head>
  <body>
    <!-- HEADER NAVIGASI DASBOR -->
    <header class="top">
      <div class="brand"><span>🌐</span><h1>Dasbor Humas Media</h1></div>
      <nav>
        <a href="/dasbor-metrik">Dasbor Metrik</a>
        <a href="/kalender-konten">Kalender Konten</a>
        <a href="/papan-proyek">Papan Proyek</a>
        <a href="/pantauan-berita">Pantauan Berita</a>
        <a href="/insight-konten">Insight Konten</a>
        <a href="/laporan-anggaran">Laporan & Anggaran</a>
        <a href="/basis-pengetahuan" class="active">Basis Pengetahuan & SOP</a>
      </nav>
      <div class="role">
        <span>Peran Aktif:</span>
        <select id="user-role">
          <option value="head" selected>Ketua Bidang</option>
          <option value="admin">Admin</option>
          <option value="staff">Staf</option>
        </select>
      </div>
    </header>

    <main>
      <!-- BREADCRUMB & HEADER -->
      <div class="breadcrumb">
        <a href="/basis-pengetahuan">← Kembali ke Basis Pengetahuan & SOP</a>
      </div>

      <div class="head">
        <div>
          <h2>Status Usulan & Panel Tinjauan Dokumen SOP</h2>
          <p class="muted">
            Pelacakan siklus hidup usulan dokumen baru dan revisi SOP: mulai dari pengajuan staf, verifikasi administrasi, hingga persetujuan resmi oleh Ketua Bidang atau Admin.
          </p>
        </div>
        <div class="actions">
          <a href="/basis-pengetahuan" class="btn btn-secondary">➕ Ajukan Usulan Baru</a>
        </div>
      </div>

      <!-- BANNER ROLE BASED ACCESS NOTICE -->
      <div id="role-notice-banner" class="role-notice head-mode">
        <div class="notice-icon">🛡️</div>
        <div class="notice-body">
          <strong id="role-notice-title">Mode Peninjau Berwenang Aktif (Ketua Bidang)</strong>
          <p id="role-notice-desc">
            Anda memiliki hak otorisasi penuh untuk menyetujui, meminta revisi, atau menolak usulan SOP dan dokumen kebijakan internal.
          </p>
        </div>
        <div class="badge-role" id="role-notice-badge">Akses: Otoritas Penuh</div>
      </div>

      <!-- KARTU STATISTIK USULAN -->
      <section class="stats">
        <div class="card hl" data-status-filter="all">
          <span class="lbl">Total Usulan Masuk</span>
          <strong id="stat-total">{totalProposals} Usulan</strong>
        </div>
        <div class="card warning" data-status-filter="menunggu_tinjauan">
          <span class="lbl">Menunggu Tinjauan</span>
          <strong id="stat-pending">{pendingCount} Usulan</strong>
        </div>
        <div class="card success" data-status-filter="disetujui">
          <span class="lbl">Telah Disetujui</span>
          <strong id="stat-approved">{approvedCount} Usulan</strong>
        </div>
        <div class="card info" data-status-filter="perlu_revisi">
          <span class="lbl">Perlu Revisi</span>
          <strong id="stat-revision">{needsRevisionCount} Usulan</strong>
        </div>
        <div class="card danger" data-status-filter="ditolak">
          <span class="lbl">Ditolak</span>
          <strong id="stat-rejected">{rejectedCount} Usulan</strong>
        </div>
      </section>

      <!-- FILTER & PENCARIAN USULAN -->
      <section class="filter-bar">
        <div class="filter-group search-group">
          <label for="filter-search" class="visually-hidden">Cari Usulan</label>
          <div class="search-input-wrap">
            <span class="search-icon">🔍</span>
            <input 
              type="text" 
              id="filter-search" 
              placeholder="Cari ID usulan, judul dokumen, nama pengusul, atau kata kunci..." 
              autocomplete="off"
            />
            <button type="button" id="btn-clear-search" class="btn-clear" aria-label="Bersihkan pencarian" style="display:none;">✕</button>
          </div>
        </div>

        <div class="filter-group">
          <label for="filter-status">Status Tinjauan:</label>
          <select id="filter-status">
            <option value="all">Semua Status ({totalProposals})</option>
            <option value="menunggu_tinjauan">Menunggu Tinjauan ({pendingCount})</option>
            <option value="disetujui">Disetujui ({approvedCount})</option>
            <option value="perlu_revisi">Perlu Revisi ({needsRevisionCount})</option>
            <option value="ditolak">Ditolak ({rejectedCount})</option>
          </select>
        </div>

        <div class="filter-group">
          <label for="filter-type">Jenis Pengajuan:</label>
          <select id="filter-type">
            <option value="all">Semua Jenis</option>
            <option value="revision">Revisi Dokumen yang Ada</option>
            <option value="new">Dokumen / SOP Baru</option>
          </select>
        </div>

        <div class="filter-group">
          <label for="filter-urgency">Urgensi:</label>
          <select id="filter-urgency">
            <option value="all">Semua Urgensi</option>
            <option value="mendesak">Mendesak</option>
            <option value="penting">Penting</option>
            <option value="normal">Normal</option>
          </select>
        </div>
      </section>

      <!-- NOTIFIKASI FEEDBACK TINDAKAN -->
      <div id="action-toast" class="toast" role="status" aria-live="polite" style="display:none;">
        <span class="toast-icon">✅</span>
        <span id="toast-message">Status usulan berhasil diperbarui.</span>
      </div>

      <!-- DAFTAR USULAN / GRID PROPOSALS -->
      <section class="proposals-container">
        <div class="table-responsive">
          <table class="proposals-table">
            <thead>
              <tr>
                <th style="width: 140px;">ID & Jenis</th>
                <th>Usulan Dokumen & Ringkasan</th>
                <th style="width: 170px;">Pengusul & Waktu</th>
                <th style="width: 120px;">Urgensi</th>
                <th style="width: 150px;">Status Tinjauan</th>
                <th style="width: 160px; text-align: center;">Tindakan</th>
              </tr>
            </thead>
            <tbody id="proposals-tbody">
              {mockProposals.map((item) => (
                <tr 
                  class="proposal-row" 
                  data-id={item.id}
                  data-status={item.status}
                  data-type={item.type}
                  data-urgency={item.urgency}
                  data-search={`${item.id} ${item.title} ${item.submitterName} ${item.reason} ${item.targetDocCode || ''} ${item.targetDocTitle || ''}`.toLowerCase()}
                >
                  <td>
                    <div class="id-badge-wrap">
                      <span class="id-tag">{item.id}</span>
                      <span class={`type-pill ${item.type}`}>
                        {item.type === 'revision' ? 'Revisi SOP' : 'Dokumen Baru'}
                      </span>
                    </div>
                  </td>
                  <td>
                    <div class="doc-info">
                      <h3 class="proposal-title">{item.title}</h3>
                      {item.targetDocCode && (
                        <div class="target-doc-ref">
                          <span>Mengacu pada:</span>
                          <code>{item.targetDocCode}</code>
                          <span class="target-title">({item.targetDocTitle})</span>
                        </div>
                      )}
                      <p class="reason-snippet">{item.reason}</p>
                    </div>
                  </td>
                  <td>
                    <div class="submitter-info">
                      <strong>{item.submitterName}</strong>
                      <span class="submitter-role">Role: {item.submitterRole}</span>
                      <span class="time-stamp">{item.submittedAt}</span>
                    </div>
                  </td>
                  <td>
                    <span class={`urgency-pill ${item.urgency}`}>
                      {item.urgency === 'mendesak' ? '🚨 Mendesak' : item.urgency === 'penting' ? '⚠️ Penting' : 'Normal'}
                    </span>
                  </td>
                  <td>
                    <div class="status-cell">
                      <span class={`status-pill ${item.status}`}>
                        {item.status === 'menunggu_tinjauan' ? '⏳ Menunggu Tinjauan' :
                         item.status === 'disetujui' ? '✅ Disetujui' :
                         item.status === 'perlu_revisi' ? '✏️ Perlu Revisi' : '❌ Ditolak'}
                      </span>
                      {item.reviewedBy && (
                        <span class="reviewer-meta" title={item.reviewNotes}>
                          Oleh: {item.reviewedBy.split('(')[0].trim()}
                        </span>
                      )}
                    </div>
                  </td>
                  <td style="text-align: center;">
                    <div class="row-actions">
                      <button 
                        type="button" 
                        class="btn-sm btn-detail" 
                        data-action="view" 
                        data-id={item.id}
                        aria-label={`Buka detail usulan ${item.id}`}
                      >
                        👁️ Rincian
                      </button>
                      <button 
                        type="button" 
                        class="btn-sm btn-review review-action-btn" 
                        data-action="review" 
                        data-id={item.id}
                        aria-label={`Tinjau usulan ${item.id}`}
                      >
                        ⚖️ Tinjau
                      </button>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- STATE KOSONG JIKA TIDAK ADA HASIL FILTER -->
        <div id="empty-state" class="empty-state" style="display: none;">
          <div class="empty-icon">📂</div>
          <h3>Tidak Ada Usulan Ditemukan</h3>
          <p class="muted">
            Tidak ada data usulan dokumen yang sesuai dengan kata kunci atau filter status yang dipilih.
          </p>
          <button type="button" id="btn-reset-filters" class="btn btn-secondary">
            Reset Semua Filter
          </button>
        </div>
      </section>

      <!-- MODAL RINCIAN USULAN -->
      <div id="modal-detail" class="modal-backdrop" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="detail-modal-title">
        <div class="modal-card">
          <div class="modal-head">
            <div>
              <span id="detail-type-badge" class="type-pill revision">Revisi SOP</span>
              <h3 id="detail-modal-title" style="margin-top: 0.4rem; font-size: 1.15rem; color: #f1f5f9;">Rincian Usulan Dokumen</h3>
              <span id="detail-id-tag" class="id-tag">USUL-2026-001</span>
            </div>
            <button type="button" class="btn-close" id="btn-close-detail" aria-label="Tutup modal">✕</button>
          </div>

          <div class="modal-body">
            <div class="detail-section">
              <span class="detail-label">Judul Usulan Dokumen</span>
              <p id="detail-title" class="detail-value text-strong"></p>
            </div>

            <div class="detail-grid-2">
              <div class="detail-section">
                <span class="detail-label">Kategori Dokumen</span>
                <p id="detail-category" class="detail-value"></p>
              </div>
              <div class="detail-section">
                <span class="detail-label">Tingkat Urgensi</span>
                <p id="detail-urgency" class="detail-value"></p>
              </div>
            </div>

            <div id="detail-target-wrapper" class="detail-section callout-target" style="display: none;">
              <span class="detail-label">Dokumen Rujukan / Basis Revisi</span>
              <div class="target-box">
                <code id="detail-target-code"></code>
                <strong id="detail-target-title"></strong>
              </div>
            </div>

            <div class="detail-grid-2">
              <div class="detail-section">
                <span class="detail-label">Diajukan Oleh</span>
                <p id="detail-submitter" class="detail-value"></p>
              </div>
              <div class="detail-section">
                <span class="detail-label">Waktu Pengajuan</span>
                <p id="detail-time" class="detail-value"></p>
              </div>
            </div>

            <div class="detail-section">
              <span class="detail-label">Latar Belakang & Alasan Kebutuhan</span>
              <div id="detail-reason" class="detail-box"></div>
            </div>

            <div class="detail-section">
              <span class="detail-label">Usulan Isi / Poin Perubahan yang Diajukan</span>
              <div id="detail-suggested" class="detail-box highlight-box"></div>
            </div>

            <!-- CATATAN PENINJAU JIKA SUDAH PERNAH DITINJAU -->
            <div id="detail-review-section" class="detail-section review-result-box" style="display: none;">
              <span class="detail-label">Hasil Tinjauan Wewenang</span>
              <div class="review-status-bar">
                <span id="detail-review-status-pill" class="status-pill"></span>
                <span id="detail-reviewer-name" class="reviewer-tag"></span>
              </div>
              <p id="detail-review-notes" class="review-notes-text"></p>
            </div>
          </div>

          <div class="modal-foot">
            <button type="button" class="btn btn-secondary" id="btn-close-detail-foot">Tutup</button>
            <button type="button" class="btn btn-review review-action-btn" id="btn-proceed-to-review">⚖️ Buka Panel Tinjau</button>
          </div>
        </div>
      </div>

      <!-- MODAL PANEL TINJAU BERWENANG -->
      <div id="modal-review" class="modal-backdrop" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="review-modal-title">
        <div class="modal-card">
          <div class="modal-head">
            <div>
              <span class="badge-role">Panel Otoritas Humas</span>
              <h3 id="review-modal-title" style="margin-top: 0.4rem; font-size: 1.15rem; color: #f1f5f9;">Tinjau & Putuskan Usulan Dokumen</h3>
              <span id="review-id-tag" class="id-tag">USUL-2026-001</span>
            </div>
            <button type="button" class="btn-close" id="btn-close-review" aria-label="Tutup modal tinjauan">✕</button>
          </div>

          <form id="form-review-decision">
            <div class="modal-body">
              <input type="hidden" id="review-input-id" value="" />

              <div class="review-summary-banner">
                <strong id="review-summary-title"></strong>
                <p id="review-summary-meta" class="muted" style="margin-top: 0.2rem; font-size: 0.85rem;"></p>
              </div>

              <!-- PILIHAN KEPUTUSAN -->
              <div class="form-group">
                <label class="form-label required">Keputusan Peninjauan:</label>
                <div class="decision-radios">
                  <label class="radio-card approve">
                    <input type="radio" name="decision" value="disetujui" required />
                    <div class="radio-body">
                      <span class="radio-title">✅ Setujui Usulan</span>
                      <span class="radio-sub">Terima usulan untuk langsung diintegrasikan ke dokumen resmi SOP atau repositori.</span>
                    </div>
                  </label>

                  <label class="radio-card revision">
                    <input type="radio" name="decision" value="perlu_revisi" required />
                    <div class="radio-body">
                      <span class="radio-title">✏️ Perlu Revisi / Kelengkapan</span>
                      <span class="radio-sub">Kembalikan usulan ke pengusul untuk perbaikan klausul atau data pendukung.</span>
                    </div>
                  </label>

                  <label class="radio-card reject">
                    <input type="radio" name="decision" value="ditolak" required />
                    <div class="radio-body">
                      <span class="radio-title">❌ Tolak Usulan</span>
                      <span class="radio-sub">Usulan tidak relevan dengan standar regulasi atau bertentangan dengan kebijakan yayasan.</span>
                    </div>
                  </label>
                </div>
              </div>

              <!-- CATATAN RESMI PENINJAU -->
              <div class="form-group">
                <label for="review-notes-input" class="form-label required">Catatan Resmi & Arahan Peninjau:</label>
                <textarea 
                  id="review-notes-input" 
                  rows="4" 
                  class="form-control" 
                  placeholder="Tuliskan arahan tindak lanjut, revisi yang diperlukan, atau justifikasi penolakan..."
                  required
                ></textarea>
                <span class="form-help">Catatan ini akan tercatat dalam log riwayat audit dokumen lembaga.</span>
              </div>

              <!-- INTEGRASI KE REPOSITORI JIKA DISETUJUI -->
              <div id="sync-repo-toggle-wrap" class="checkbox-box" style="display: none;">
                <label class="checkbox-label">
                  <input type="checkbox" id="sync-repo-toggle" checked />
                  <span>Langsung terbitkan status versi ke draft repositori aktif</span>
                </label>
              </div>
            </div>

            <div class="modal-foot">
              <button type="button" class="btn btn-secondary" id="btn-cancel-review">Batal</button>
              <button type="submit" class="btn btn-primary" id="btn-submit-decision">Simpan Keputusan Resmi</button>
            </div>
          </form>
        </div>
      </div>
    </main>

    <!-- INLINE SCRIPT DENGAN LOGIKA REAKTIF LENGKAP -->
    <script is:inline>
      (function() {
        // State usulan lokal (dimuat dari localStorage jika ada, fallback ke server mock)
        var STORAGE_KEY = 'dasbor_humas_proposals_store_v1';
        
        var initialProposals = [];
        try {
          var saved = localStorage.getItem(STORAGE_KEY);
          if (saved) {
            initialProposals = JSON.parse(saved);
          }
        } catch (e) {
          console.error('Gagal membaca localStorage:', e);
        }

        // Jika belum ada di localStorage, ambil dari data server mock yang di-embed
        if (!initialProposals || initialProposals.length === 0) {
          initialProposals = [
            {
              id: 'USUL-2026-001',
              type: 'revision',
              title: 'Pembaruan Batas Waktu Unggah Dokumentasi Tanggap Darurat Bencana',
              category: 'SOP',
              targetDocCode: 'SOP-HUM-01',
              targetDocTitle: 'SOP Peliputan dan Dokumentasi Bencana di Lapangan',
              submitterName: 'Rian Pratama',
              submitterRole: 'staff',
              submittedAt: '09 Oktober 2026, 14:20 WIB',
              urgency: 'penting',
              reason: 'Koneksi internet di posko bencana sering mengalami kendala bandwidth saat jam malam sehingga batas unggah jam 21.00 WIB sulit dipenuhi tanpa risiko kegagalan transmisi.',
              suggestedContent: 'Menambahkan opsi kelonggaran pengunggahan bertahap (priority batching: foto resolusi sedang untuk siaran pers dahulu, file RAW menyusul pagi hari pukul 06.00 WIB).',
              status: 'menunggu_tinjauan'
            },
            {
              id: 'USUL-2026-002',
              type: 'new',
              title: 'Panduan Penanganan Hak Jawab dan Klarifikasi Berita Viral Medsos',
              category: 'Panduan Teknis',
              submitterName: 'Dewi Lestari',
              submitterRole: 'staff',
              submittedAt: '08 Oktober 2026, 09:15 WIB',
              urgency: 'mendesak',
              reason: 'Belum ada panduan resmi tata cara merespons misinformasi penyaluran bantuan di platform X (Twitter) dan TikTok saat isu sedang bergulir cepat.',
              suggestedContent: 'Membuat matriks respon krisis medsos, format template pernyataan klarifikasi resmi, dan pembatasan wewenang admin akun agar tidak membalas tanpa arahan Ketua Bidang.',
              status: 'menunggu_tinjauan'
            },
            {
              id: 'USUL-2026-003',
              type: 'revision',
              title: 'Penyesuaian Aturan Perlindungan Wajah Penerima Manfaat Dhuafa Lansia',
              category: 'SOP',
              targetDocCode: 'SOP-DON-02',
              targetDocTitle: 'Etika Publikasi Donatur dan Penerima Manfaat',
              submitterName: 'Ahmad Fauzi',
              submitterRole: 'admin',
              submittedAt: '04 Oktober 2026, 11:30 WIB',
              urgency: 'normal',
              reason: 'Menegaskan batas persetujuan dokumentasi untuk lansia yang hidup sebatang kara dan menjaga harkat martabat keluarga.',
              suggestedContent: 'Penambahan klausul persetujuan berbasis saksi aparat desa / rukun tetangga setempat bila penerima manfaat berhalangan tanda tangan.',
              status: 'disetujui',
              reviewedBy: 'Dr. Hendra Gunawan (Ketua Bidang Humas)',
              reviewedAt: '06 Oktober 2026, 16:45 WIB',
              reviewNotes: 'Disetujui untuk diintegrasikan pada revisi SOP v1.9 bulan depan. Sangat bagus untuk kepatuhan etis kemanusiaan.'
            },
            {
              id: 'USUL-2026-004',
              type: 'new',
              title: 'SOP Penggunaan AI Generatif dalam Pembuatan Naskah Kampanye Kemanusiaan',
              category: 'Pedoman Brand',
              submitterName: 'Budi Santoso',
              submitterRole: 'staff',
              submittedAt: '29 September 2026, 15:00 WIB',
              urgency: 'normal',
              reason: 'Staf copywriter mulai memanfaatkan AI generatif untuk drafting konten, diperlukan batasan etika dan pelarangan upload data pribadi donatur ke prompt publik.',
              suggestedContent: 'Dilarang memasukkan NIK, nama lengkap penerima manfaat, dan foto asli tanpa enkripsi ke alat AI pihak ketiga.',
              status: 'perlu_revisi',
              reviewedBy: 'Siti Rahma (Admin Humas)',
              reviewedAt: '02 Oktober 2026, 10:10 WIB',
              reviewNotes: 'Ide sangat baik, namun butuh detail sinkronisasi dengan kebijakan IT keamanan siber lembaga sebelum diajukan ke Ketua Bidang.'
            }
          ];
          saveProposals(initialProposals);
        }

        var proposals = initialProposals;

        function saveProposals(data) {
          try {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
          } catch (e) {
            console.error('Gagal menyimpan ke localStorage:', e);
          }
        }

        // Elemen DOM
        var roleSelect = document.getElementById('user-role');
        var roleNoticeBanner = document.getElementById('role-notice-banner');
        var roleNoticeTitle = document.getElementById('role-notice-title');
        var roleNoticeDesc = document.getElementById('role-notice-desc');
        var roleNoticeBadge = document.getElementById('role-notice-badge');

        var filterSearch = document.getElementById('filter-search');
        var btnClearSearch = document.getElementById('btn-clear-search');
        var filterStatus = document.getElementById('filter-status');
        var filterType = document.getElementById('filter-type');
        var filterUrgency = document.getElementById('filter-urgency');
        var tbody = document.getElementById('proposals-tbody');
        var emptyState = document.getElementById('empty-state');
        var btnResetFilters = document.getElementById('btn-reset-filters');

        var statTotal = document.getElementById('stat-total');
        var statPending = document.getElementById('stat-pending');
        var statApproved = document.getElementById('stat-approved');
        var statRevision = document.getElementById('stat-revision');
        var statRejected = document.getElementById('stat-rejected');

        var modalDetail = document.getElementById('modal-detail');
        var btnCloseDetail = document.getElementById('btn-close-detail');
        var btnCloseDetailFoot = document.getElementById('btn-close-detail-foot');
        var btnProceedToReview = document.getElementById('btn-proceed-to-review');

        var modalReview = document.getElementById('modal-review');
        var btnCloseReview = document.getElementById('btn-close-review');
        var btnCancelReview = document.getElementById('btn-cancel-review');
        var formReviewDecision = document.getElementById('form-review-decision');
        var syncRepoToggleWrap = document.getElementById('sync-repo-toggle-wrap');

        var actionToast = document.getElementById('action-toast');
        var toastMessage = document.getElementById('toast-message');

        var currentSelectedId = null;

        // Tampilkan Toast
        function showToast(msg) {
          if (!actionToast || !toastMessage) return;
          toastMessage.textContent = msg;
          actionToast.style.display = 'flex';
          setTimeout(function() {
            actionToast.style.display = 'none';
          }, 3500);
        }

        // Perbarui Statistik
        function updateStats() {
          var total = proposals.length;
          var pending = proposals.filter(function(p) { return p.status === 'menunggu_tinjauan'; }).length;
          var approved = proposals.filter(function(p) { return p.status === 'disetujui'; }).length;
          var revision = proposals.filter(function(p) { return p.status === 'perlu_revisi'; }).length;
          var rejected = proposals.filter(function(p) { return p.status === 'ditolak'; }).length;

          if (statTotal) statTotal.textContent = total + ' Usulan';
          if (statPending) statPending.textContent = pending + ' Usulan';
          if (statApproved) statApproved.textContent = approved + ' Usulan';
          if (statRevision) statRevision.textContent = revision + ' Usulan';
          if (statRejected) statRejected.textContent = rejected + ' Usulan';

          // Update teks pada dropdown filter
          if (filterStatus) {
            filterStatus.options[0].text = 'Semua Status (' + total + ')';
            filterStatus.options[1].text = 'Menunggu Tinjauan (' + pending + ')';
            filterStatus.options[2].text = 'Disetujui (' + approved + ')';
            filterStatus.options[3].text = 'Perlu Revisi (' + revision + ')';
            filterStatus.options[4].text = 'Ditolak (' + rejected + ')';
          }
        }

        // Render Baris Tabel
        function renderTable() {
          if (!tbody) return;

          var searchVal = (filterSearch ? filterSearch.value : '').toLowerCase().trim();
          var statusVal = filterStatus ? filterStatus.value : 'all';
          var typeVal = filterType ? filterType.value : 'all';
          var urgencyVal = filterUrgency ? filterUrgency.value : 'all';
          var currentRole = roleSelect ? roleSelect.value : 'head';
          var canReview = currentRole === 'head' || currentRole === 'admin';

          var rows = proposals.filter(function(item) {
            var matchSearch = true;
            if (searchVal) {
              var searchCorpus = (
                item.id + ' ' + 
                item.title + ' ' + 
                item.submitterName + ' ' + 
                item.reason + ' ' + 
                (item.targetDocCode || '') + ' ' + 
                (item.targetDocTitle || '')
              ).toLowerCase();
              matchSearch = searchCorpus.indexOf(searchVal) !== -1;
            }

            var matchStatus = statusVal === 'all' || item.status === statusVal;
            var matchType = typeVal === 'all' || item.type === typeVal;
            var matchUrgency = urgencyVal === 'all' || item.urgency === urgencyVal;

            return matchSearch && matchStatus && matchType && matchUrgency;
          });

          if (rows.length === 0) {
            tbody.innerHTML = '';
            if (emptyState) emptyState.style.display = 'block';
            return;
          }

          if (emptyState) emptyState.style.display = 'none';

          var html = rows.map(function(item) {
            var typeLabel = item.type === 'revision' ? 'Revisi SOP' : 'Dokumen Baru';
            var urgencyLabel = item.urgency === 'mendesak' ? '🚨 Mendesak' : 
                               item.urgency === 'penting' ? '⚠️ Penting' : 'Normal';
            var statusLabel = item.status === 'menunggu_tinjauan' ? '⏳ Menunggu Tinjauan' :
                              item.status === 'disetujui' ? '✅ Disetujui' :
                              item.status === 'perlu_revisi' ? '✏️ Perlu Revisi' : '❌ Ditolak';

            var reviewerHtml = '';
            if (item.reviewedBy) {
              var reviewerShort = item.reviewedBy.split('(')[0].trim();
              reviewerHtml = '<span class="reviewer-meta" title="' + (item.reviewNotes || '') + '">Oleh: ' + reviewerShort + '</span>';
            }

            var targetHtml = '';
            if (item.targetDocCode) {
              targetHtml = '<div class="target-doc-ref">' +
                '<span>Mengacu pada:</span>' +
                '<code>' + item.targetDocCode + '</code>' +
                '<span class="target-title">(' + (item.targetDocTitle || '') + ')</span>' +
                '</div>';
            }

            var reviewBtnStyle = canReview ? '' : 'style="opacity: 0.45; cursor: not-allowed;" title="Hanya Admin / Ketua Bidang yang berwenang meninjau"';

            return '<tr class="proposal-row" data-id="' + item.id + '">' +
              '<td>' +
                '<div class="id-badge-wrap">' +
                  '<span class="id-tag">' + item.id + '</span>' +
                  '<span class="type-pill ' + item.type + '">' + typeLabel + '</span>' +
                '</div>' +
              '</td>' +
              '<td>' +
                '<div class="doc-info">' +
                  '<h3 class="proposal-title">' + item.title + '</h3>' +
                  targetHtml +
                  '<p class="reason-snippet">' + item.reason + '</p>' +
                '</div>' +
              '</td>' +
              '<td>' +
                '<div class="submitter-info">' +
                  '<strong>' + item.submitterName + '</strong>' +
                  '<span class="submitter-role">Role: ' + item.submitterRole + '</span>' +
                  '<span class="time-stamp">' + item.submittedAt + '</span>' +
                '</div>' +
              '</td>' +
              '<td>' +
                '<span class="urgency-pill ' + item.urgency + '">' + urgencyLabel + '</span>' +
              '</td>' +
              '<td>' +
                '<div class="status-cell">' +
                  '<span class="status-pill ' + item.status + '">' + statusLabel + '</span>' +
                  reviewerHtml +
                '</div>' +
              '</td>' +
              '<td style="text-align: center;">' +
                '<div class="row-actions">' +
                  '<button type="button" class="btn-sm btn-detail" data-action="view" data-id="' + item.id + '">' +
                    '👁️ Rincian' +
                  '</button>' +
                  '<button type="button" class="btn-sm btn-review review-action-btn" data-action="review" data-id="' + item.id + '" ' + reviewBtnStyle + '>' +
                    '⚖️ Tinjau' +
                  '</button>' +
                '</div>' +
              '</td>' +
            '</tr>';
          }).join('');

          tbody.innerHTML = html;
        }

        // Terapkan Pembatasan Peran (RBAC)
        function applyRoleChanges() {
          var role = roleSelect ? roleSelect.value : 'head';
          if (!roleNoticeBanner) return;

          roleNoticeBanner.className = 'role-notice ' + role + '-mode';

          if (role === 'head') {
            roleNoticeTitle.textContent = 'Mode Peninjau Berwenang Aktif (Ketua Bidang)';
            roleNoticeDesc.textContent = 'Anda memiliki otoritas tertinggi untuk memberikan pengesahan dokumen resmi atau mengembalikan usulan untuk revisi.';
            roleNoticeBadge.textContent = 'Akses: Otoritas Penuh';
            roleNoticeBadge.className = 'badge-role head-badge';
          } else if (role === 'admin') {
            roleNoticeTitle.textContent = 'Mode Peninjau Operasional Aktif (Admin)';
            roleNoticeDesc.textContent = 'Anda berwenang memvalidasi kelengkapan berkas usulan teknis sebelum diajukan ke Ketua Bidang.';
            roleNoticeBadge.textContent = 'Akses: Peninjau Admin';
            roleNoticeBadge.className = 'badge-role admin-badge';
          } else {
            roleNoticeTitle.textContent = 'Mode Tinjauan Staf (Hanya Lihat)';
            roleNoticeDesc.textContent = 'Sebagai staf, Anda dapat memantau status persetujuan usulan Anda namun tidak memiliki wewenang memberikan keputusan.';
            roleNoticeBadge.textContent = 'Akses: Pembaca';
            roleNoticeBadge.className = 'badge-role staff-badge';
          }

          renderTable();
        }

        // Buka Modal Rincian
        function openDetailModal(id) {
          var item = proposals.find(function(p) { return p.id === id; });
          if (!item || !modalDetail) return;
          currentSelectedId = id;

          var detailTypeBadge = document.getElementById('detail-type-badge');
          var detailIdTag = document.getElementById('detail-id-tag');
          var detailTitle = document.getElementById('detail-title');
          var detailCategory = document.getElementById('detail-category');
          var detailUrgency = document.getElementById('detail-urgency');
          var detailTargetWrapper = document.getElementById('detail-target-wrapper');
          var detailTargetCode = document.getElementById('detail-target-code');
          var detailTargetTitle = document.getElementById('detail-target-title');
          var detailSubmitter = document.getElementById('detail-submitter');
          var detailTime = document.getElementById('detail-time');
          var detailReason = document.getElementById('detail-reason');
          var detailSuggested = document.getElementById('detail-suggested');
          var detailReviewSection = document.getElementById('detail-review-section');
          var detailReviewStatusPill = document.getElementById('detail-review-status-pill');
          var detailReviewerName = document.getElementById('detail-reviewer-name');
          var detailReviewNotes = document.getElementById('detail-review-notes');

          if (detailTypeBadge) {
            detailTypeBadge.className = 'type-pill ' + item.type;
            detailTypeBadge.textContent = item.type === 'revision' ? 'Revisi Dokumen SOP' : 'Dokumen SOP Baru';
          }
          if (detailIdTag) detailIdTag.textContent = item.id;
          if (detailTitle) detailTitle.textContent = item.title;
          if (detailCategory) detailCategory.textContent = item.category;
          if (detailUrgency) {
            detailUrgency.textContent = item.urgency.toUpperCase();
            detailUrgency.className = 'detail-value urgency-text ' + item.urgency;
          }

          if (item.targetDocCode && detailTargetWrapper) {
            detailTargetWrapper.style.display = 'block';
            if (detailTargetCode) detailTargetCode.textContent = item.targetDocCode;
            if (detailTargetTitle) detailTargetTitle.textContent = item.targetDocTitle || '';
          } else if (detailTargetWrapper) {
            detailTargetWrapper.style.display = 'none';
          }

          if (detailSubmitter) detailSubmitter.textContent = item.submitterName + ' (' + item.submitterRole + ')';
          if (detailTime) detailTime.textContent = item.submittedAt;
          if (detailReason) detailReason.textContent = item.reason;
          if (detailSuggested) detailSuggested.textContent = item.suggestedContent;

          if (item.reviewedBy && detailReviewSection) {
            detailReviewSection.style.display = 'block';
            if (detailReviewStatusPill) {
              detailReviewStatusPill.className = 'status-pill ' + item.status;
              detailReviewStatusPill.textContent = item.status === 'disetujui' ? '✅ Disetujui' :
                                                  item.status === 'perlu_revisi' ? '✏️ Perlu Revisi' : '❌ Ditolak';
            }
            if (detailReviewerName) detailReviewerName.textContent = 'Ditinjau oleh: ' + item.reviewedBy + ' (' + (item.reviewedAt || '') + ')';
            if (detailReviewNotes) detailReviewNotes.textContent = item.reviewNotes || '-';
          } else if (detailReviewSection) {
            detailReviewSection.style.display = 'none';
          }

          // Periksa tombol buka review di footer modal
          var currentRole = roleSelect ? roleSelect.value : 'head';
          if (btnProceedToReview) {
            if (currentRole === 'staff') {
              btnProceedToReview.style.display = 'none';
            } else {
              btnProceedToReview.style.display = 'inline-block';
            }
          }

          modalDetail.style.display = 'flex';
        }

        // Buka Modal Tinjau
        function openReviewModal(id) {
          var currentRole = roleSelect ? roleSelect.value : 'head';
          if (currentRole === 'staff') {
            alert('Akses Ditolak: Anda saat ini berada dalam peran Staf. Hanya Ketua Bidang atau Admin yang berhak meninjau dan memberi keputusan usulan.');
            return;
          }

          var item = proposals.find(function(p) { return p.id === id; });
          if (!item || !modalReview) return;
          currentSelectedId = id;

          var reviewIdTag = document.getElementById('review-id-tag');
          var reviewSummaryTitle = document.getElementById('review-summary-title');
          var reviewSummaryMeta = document.getElementById('review-summary-meta');
          var reviewInputId = document.getElementById('review-input-id');
          var reviewNotesInput = document.getElementById('review-notes-input');

          if (reviewIdTag) reviewIdTag.textContent = item.id;
          if (reviewSummaryTitle) reviewSummaryTitle.textContent = item.title;
          if (reviewSummaryMeta) {
            reviewSummaryMeta.textContent = 'Diajukan oleh ' + item.submitterName + ' (' + item.submittedAt + ') • Kategori: ' + item.category;
          }
          if (reviewInputId) reviewInputId.value = item.id;
          if (reviewNotesInput) reviewNotesInput.value = item.reviewNotes || '';

          // Reset radio selection
          var radios = document.getElementsByName('decision');
          for (var i = 0; i < radios.length; i++) {
            if (radios[i].value === item.status) {
              radios[i].checked = true;
            } else {
              radios[i].checked = false;
            }
          }

          if (modalDetail) modalDetail.style.display = 'none';
          modalReview.style.display = 'flex';
        }

        // Delegasi Klik pada Tabel
        if (tbody) {
          tbody.addEventListener('click', function(e) {
            var target = e.target;
            var btn = target.closest('button[data-action]');
            if (!btn) return;

            var action = btn.getAttribute('data-action');
            var id = btn.getAttribute('data-id');

            if (action === 'view') {
              openDetailModal(id);
            } else if (action === 'review') {
              openReviewModal(id);
            }
          });
        }

        // Tutup Modal Detail
        if (btnCloseDetail) btnCloseDetail.addEventListener('click', function() { modalDetail.style.display = 'none'; });
        if (btnCloseDetailFoot) btnCloseDetailFoot.addEventListener('click', function() { modalDetail.style.display = 'none'; });

        // Lanjut ke Panel Review dari Detail
        if (btnProceedToReview) {
          btnProceedToReview.addEventListener('click', function() {
            if (currentSelectedId) {
              openReviewModal(currentSelectedId);
            }
          });
        }

        // Tutup Modal Review
        if (btnCloseReview) btnCloseReview.addEventListener('click', function() { modalReview.style.display = 'none'; });
        if (btnCancelReview) btnCancelReview.addEventListener('click', function() { modalReview.style.display = 'none'; });

        // Handle Radio Decision Change
        var decisionRadios = document.getElementsByName('decision');
        for (var d = 0; d < decisionRadios.length; d++) {
          decisionRadios[d].addEventListener('change', function() {
            if (syncRepoToggleWrap) {
              syncRepoToggleWrap.style.display = this.value === 'disetujui' ? 'block' : 'none';
            }
          });
        }

        // Submit Keputusan Tinjauan
        if (formReviewDecision) {
          formReviewDecision.addEventListener('submit', function(e) {
            e.preventDefault();

            var id = document.getElementById('review-input-id').value;
            var notes = document.getElementById('review-notes-input').value.trim();
            var selectedDecision = null;
            for (var j = 0; j < decisionRadios.length; j++) {
              if (decisionRadios[j].checked) {
                selectedDecision = decisionRadios[j].value;
                break;
              }
            }

            if (!selectedDecision) {
              alert('Silakan pilih salah satu keputusan peninjauan.');
              return;
            }

            var itemIndex = proposals.findIndex(function(p) { return p.id === id; });
            if (itemIndex === -1) return;

            var currentRole = roleSelect ? roleSelect.value : 'head';
            var reviewerName = currentRole === 'head' ? 'Dr. Hendra Gunawan (Ketua Bidang Humas)' : 'Siti Rahma (Admin Humas)';
            var nowStr = new Date().toLocaleDateString('id-ID', { day: '2-digit', month: 'long', year: 'numeric' }) + ', ' +
                         new Date().toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) + ' WIB';

            proposals[itemIndex].status = selectedDecision;
            proposals[itemIndex].reviewedBy = reviewerName;
            proposals[itemIndex].reviewedAt = nowStr;
            proposals[itemIndex].reviewNotes = notes;

            saveProposals(proposals);
            updateStats();
            renderTable();

            modalReview.style.display = 'none';
            var decisionText = selectedDecision === 'disetujui' ? 'Disetujui' : 
                               selectedDecision === 'perlu_revisi' ? 'Memerlukan Revisi' : 'Ditolak';
            showToast('Keputusan berhasil disimpan: Usulan ' + id + ' kini berstatus ' + decisionText + '.');
          });
        }

        // Event Listener Pencarian & Filter
        if (filterSearch) {
          filterSearch.addEventListener('input', function() {
            if (btnClearSearch) {
              btnClearSearch.style.display = this.value.length > 0 ? 'block' : 'none';
            }
            renderTable();
          });
        }

        if (btnClearSearch) {
          btnClearSearch.addEventListener('click', function() {
            filterSearch.value = '';
            this.style.display = 'none';
            renderTable();
          });
        }

        if (filterStatus) filterStatus.addEventListener('change', renderTable);
        if (filterType) filterType.addEventListener('change', renderTable);
        if (filterUrgency) filterUrgency.addEventListener('change', renderTable);

        // Filter Klik Kartu Statistik
        var statCards = document.querySelectorAll('.stats .card');
        statCards.forEach(function(card) {
          card.addEventListener('click', function() {
            var filterVal = this.getAttribute('data-status-filter');
            if (filterVal && filterStatus) {
              filterStatus.value = filterVal;
              renderTable();
            }
          });
        });

        if (btnResetFilters) {
          btnResetFilters.addEventListener('click', function() {
            if (filterSearch) filterSearch.value = '';
            if (btnClearSearch) btnClearSearch.style.display = 'none';
            if (filterStatus) filterStatus.value = 'all';
            if (filterType) filterType.value = 'all';
            if (filterUrgency) filterUrgency.value = 'all';
            renderTable();
          });
        }

        // Listener Perubahan Role
        if (roleSelect) {
          roleSelect.addEventListener('change', applyRoleChanges);
        }

        // Klik Luar Modal untuk Menutup
        window.addEventListener('click', function(e) {
          if (e.target === modalDetail) modalDetail.style.display = 'none';
          if (e.target === modalReview) modalReview.style.display = 'none';
        });

        // Inisialisasi awal
        updateStats();
        applyRoleChanges();
      })();
    </script>

    <style>
      :root {
        --bg-main: #0f172a;
        --card-bg: #1e293b;
        --border-color: #334155;
        --text-primary: #f8fafc;
        --text-secondary: #94a3b8;
        --primary: #3b82f6;
        --primary-hover: #2563eb;
        --accent: #0ea5e9;
        --success: #10b981;
        --warning: #f59e0b;
        --danger: #ef4444;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        background-color: var(--bg-main);
        color: var(--text-primary);
        line-height: 1.5;
        padding-bottom: 3rem;
      }

      /* TOP NAV */
      header.top {
        background: #111827;
        border-bottom: 1px solid var(--border-color);
        padding: 0.75rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .brand { display: flex; align-items: center; gap: 0.5rem; }
      .brand h1 { font-size: 1.1rem; font-weight: 700; color: #f8fafc; }
      nav { display: flex; gap: 0.4rem; flex-wrap: wrap; }
      nav a {
        color: var(--text-secondary);
        text-decoration: none;
        padding: 0.4rem 0.65rem;
        border-radius: 6px;
        font-size: 0.85rem;
        transition: background 0.15s, color 0.15s;
      }
      nav a:hover, nav a.active {
        background: #1e293b;
        color: #60a5fa;
        font-weight: 600;
      }
      .role {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.85rem;
        color: var(--text-secondary);
      }
      .role select {
        background: #1e293b;
        border: 1px solid var(--border-color);
        color: #f8fafc;
        padding: 0.3rem 0.6rem;
        border-radius: 6px;
        cursor: pointer;
      }

      main {
        max-width: 1200px;
        margin: 1.5rem auto;
        padding: 0 1rem;
      }

      /* BREADCRUMB */
      .breadcrumb {
        margin-bottom: 1rem;
      }
      .breadcrumb a {
        color: #38bdf8;
        text-decoration: none;
        font-size: 0.88rem;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
      }
      .breadcrumb a:hover {
        text-decoration: underline;
      }

      /* HEAD */
      .head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 1.5rem;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .head h2 { font-size: 1.45rem; color: #f8fafc; margin-bottom: 0.25rem; }
      .head .muted { color: var(--text-secondary); font-size: 0.9rem; max-width: 780px; }
      .head .actions { display: flex; gap: 0.5rem; align-items: center; }

      /* BUTTONS */
      .btn {
        background: var(--primary);
        color: #fff;
        border: none;
        padding: 0.55rem 1rem;
        border-radius: 6px;
        font-size: 0.88rem;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        transition: background 0.15s;
        text-decoration: none;
      }
      .btn:hover { background: var(--primary-hover); }
      .btn-secondary {
        background: #334155;
        color: #e2e8f0;
        border: 1px solid #475569;
      }
      .btn-secondary:hover { background: #475569; color: #fff; }
      .btn-review {
        background: #d97706;
        color: #fff;
        border: none;
      }
      .btn-review:hover { background: #b45309; }

      .btn-sm {
        padding: 0.35rem 0.65rem;
        border-radius: 4px;
        font-size: 0.78rem;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        border: none;
        transition: opacity 0.15s;
      }
      .btn-detail { background: #334155; color: #f1f5f9; }
      .btn-detail:hover { background: #475569; }

      /* ROLE NOTICE BANNER */
      .role-notice {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.85rem 1.25rem;
        border-radius: 8px;
        margin-bottom: 1.5rem;
        border: 1px solid transparent;
      }
      .role-notice.head-mode {
        background: rgba(16, 185, 129, 0.12);
        border-color: rgba(16, 185, 129, 0.3);
      }
      .role-notice.admin-mode {
        background: rgba(59, 130, 246, 0.12);
        border-color: rgba(59, 130, 246, 0.3);
      }
      .role-notice.staff-mode {
        background: rgba(245, 158, 11, 0.12);
        border-color: rgba(245, 158, 11, 0.3);
      }
      .notice-icon { font-size: 1.5rem; }
      .notice-body { flex: 1; }
      .notice-body strong { display: block; font-size: 0.95rem; color: #f8fafc; }
      .notice-body p { font-size: 0.82rem; color: #cbd5e1; margin-top: 0.15rem; }
      .badge-role {
        font-size: 0.75rem;
        padding: 0.25rem 0.6rem;
        border-radius: 9999px;
        font-weight: 700;
        letter-spacing: 0.02em;
        text-transform: uppercase;
      }
      .head-badge { background: #065f46; color: #6ee7b7; border: 1px solid #10b981; }
      .admin-badge { background: #1e40af; color: #93c5fd; border: 1px solid #3b82f6; }
      .staff-badge { background: #78350f; color: #fcd34d; border: 1px solid #f59e0b; }

      /* STATS */
      .stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
      }
      .stats .card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 1rem;
        cursor: pointer;
        transition: transform 0.15s, border-color 0.15s;
      }
      .stats .card:hover {
        transform: translateY(-2px);
        border-color: #64748b;
      }
      .stats .card .lbl { display: block; font-size: 0.78rem; color: var(--text-secondary); margin-bottom: 0.3rem; }
      .stats .card strong { font-size: 1.35rem; color: #f8fafc; font-weight: 700; }
      .stats .card.hl { border-left: 4px solid var(--accent); }
      .stats .card.warning { border-left: 4px solid var(--warning); }
      .stats .card.success { border-left: 4px solid var(--success); }
      .stats .card.info { border-left: 4px solid #38bdf8; }
      .stats .card.danger { border-left: 4px solid var(--danger); }

      /* FILTER BAR */
      .filter-bar {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 0.85rem 1rem;
        display: flex;
        gap: 1rem;
        align-items: center;
        flex-wrap: wrap;
        margin-bottom: 1.5rem;
      }
      .filter-group {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.85rem;
        color: var(--text-secondary);
      }
      .search-group { flex: 1; min-width: 260px; }
      .search-input-wrap {
        position: relative;
        width: 100%;
        display: flex;
        align-items: center;
      }
      .search-icon {
        position: absolute;
        left: 0.65rem;
        font-size: 0.85rem;
        color: #64748b;
        pointer-events: none;
      }
      .search-input-wrap input {
        width: 100%;
        background: #0f172a;
        border: 1px solid var(--border-color);
        color: #f8fafc;
        padding: 0.45rem 2rem 0.45rem 2rem;
        border-radius: 6px;
        font-size: 0.85rem;
      }
      .search-input-wrap input:focus {
        outline: none;
        border-color: var(--primary);
      }
      .btn-clear {
        position: absolute;
        right: 0.5rem;
        background: transparent;
        border: none;
        color: #94a3b8;
        font-size: 0.85rem;
        cursor: pointer;
        padding: 0.2rem 0.4rem;
      }
      .filter-group select {
        background: #0f172a;
        border: 1px solid var(--border-color);
        color: #f8fafc;
        padding: 0.45rem 0.65rem;
        border-radius: 6px;
        font-size: 0.85rem;
        cursor: pointer;
      }

      /* TOAST */
      .toast {
        background: #065f46;
        border: 1px solid #10b981;
        color: #ecfdf5;
        padding: 0.75rem 1.25rem;
        border-radius: 6px;
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-size: 0.9rem;
        animation: fadeIn 0.2s ease-in;
      }
      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(-6px); }
        to { opacity: 1; transform: translateY(0); }
      }

      /* TABLE */
      .proposals-container {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        overflow: hidden;
      }
      .table-responsive { width: 100%; overflow-x: auto; }
      .proposals-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.88rem;
        text-align: left;
      }
      .proposals-table th {
        background: #111827;
        color: #94a3b8;
        font-weight: 600;
        padding: 0.75rem 1rem;
        border-bottom: 1px solid var(--border-color);
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
      }
      .proposals-table td {
        padding: 1rem;
        border-bottom: 1px solid #283548;
        vertical-align: top;
      }
      .proposals-table tr:hover {
        background: rgba(255, 255, 255, 0.02);
      }

      /* CELL STYLING */
      .id-badge-wrap { display: flex; flex-direction: column; gap: 0.4rem; }
      .id-tag {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.78rem;
        font-weight: 700;
        color: #93c5fd;
      }
      .type-pill {
        display: inline-block;
        font-size: 0.72rem;
        font-weight: 600;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        width: fit-content;
      }
      .type-pill.revision { background: #1e3a8a; color: #bfdbfe; }
      .type-pill.new { background: #064e3b; color: #a7f3d0; }

      .doc-info { display: flex; flex-direction: column; gap: 0.35rem; }
      .proposal-title {
        font-size: 0.95rem;
        font-weight: 600;
        color: #f1f5f9;
        line-height: 1.35;
      }
      .target-doc-ref {
        font-size: 0.78rem;
        color: #94a3b8;
        display: flex;
        align-items: center;
        gap: 0.35rem;
        flex-wrap: wrap;
      }
      .target-doc-ref code {
        background: #0f172a;
        color: #38bdf8;
        padding: 0.1rem 0.35rem;
        border-radius: 4px;
        font-size: 0.76rem;
      }
      .target-title { color: #64748b; }
      .reason-snippet {
        font-size: 0.82rem;
        color: #cbd5e1;
        line-height: 1.4;
      }

      .submitter-info { display: flex; flex-direction: column; gap: 0.15rem; font-size: 0.82rem; }
      .submitter-info strong { color: #e2e8f0; }
      .submitter-role { color: #94a3b8; font-size: 0.75rem; text-transform: capitalize; }
      .time-stamp { color: #64748b; font-size: 0.75rem; }

      .urgency-pill {
        display: inline-block;
        font-size: 0.75rem;
        padding: 0.25rem 0.55rem;
        border-radius: 9999px;
        font-weight: 600;
      }
      .urgency-pill.mendesak { background: rgba(239, 68, 68, 0.2); color: #fca5a5; border: 1px solid rgba(239, 68, 68, 0.4); }
      .urgency-pill.penting { background: rgba(245, 158, 11, 0.2); color: #fde68a; border: 1px solid rgba(245, 158, 11, 0.4); }
      .urgency-pill.normal { background: rgba(100, 116, 139, 0.2); color: #cbd5e1; border: 1px solid rgba(100, 116, 139, 0.4); }

      .status-cell { display: flex; flex-direction: column; gap: 0.3rem; }
      .status-pill {
        display: inline-block;
        font-size: 0.75rem;
        padding: 0.25rem 0.55rem;
        border-radius: 4px;
        font-weight: 600;
        width: fit-content;
      }
      .status-pill.menunggu_tinjauan { background: #78350f; color: #fef3c7; }
      .status-pill.disetujui { background: #065f46; color: #d1fae5; }
      .status-pill.perlu_revisi { background: #1e3a8a; color: #dbeafe; }
      .status-pill.ditolak { background: #7f1d1d; color: #fee2e2; }

      .reviewer-meta {
        font-size: 0.72rem;
        color: #94a3b8;
        font-style: italic;
      }

      .row-actions {
        display: flex;
        gap: 0.4rem;
        justify-content: center;
        flex-wrap: wrap;
      }

      /* EMPTY STATE */
      .empty-state {
        padding: 3rem 1.5rem;
        text-align: center;
      }
      .empty-icon { font-size: 2.5rem; margin-bottom: 0.5rem; }
      .empty-state h3 { font-size: 1.15rem; color: #f8fafc; margin-bottom: 0.25rem; }
      .empty-state p { font-size: 0.88rem; margin-bottom: 1.25rem; }

      /* MODALS */
      .modal-backdrop {
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0, 0, 0, 0.75);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 999;
        padding: 1rem;
      }
      .modal-card {
        background: #1e293b;
        border: 1px solid var(--border-color);
        border-radius: 10px;
        width: 100%;
        max-width: 650px;
        max-height: 90vh;
        overflow-y: auto;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);
        display: flex;
        flex-direction: column;
      }
      .modal-head {
        background: #111827;
        padding: 1rem 1.25rem;
        border-bottom: 1px solid var(--border-color);
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
      }
      .btn-close {
        background: transparent;
        border: none;
        color: #94a3b8;
        font-size: 1.25rem;
        cursor: pointer;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
      }
      .btn-close:hover { background: #334155; color: #fff; }

      .modal-body {
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 1.1rem;
      }

      .detail-section { display: flex; flex-direction: column; gap: 0.35rem; }
      .detail-label {
        font-size: 0.78rem;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        font-weight: 600;
      }
      .detail-value { font-size: 0.92rem; color: #e2e8f0; }
      .text-strong { font-size: 1.05rem; font-weight: 700; color: #f8fafc; }
      .detail-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
      .detail-box {
        background: #0f172a;
        border: 1px solid var(--border-color);
        padding: 0.75rem 1rem;
        border-radius: 6px;
        font-size: 0.88rem;
        line-height: 1.5;
        color: #cbd5e1;
      }
      .highlight-box {
        border-color: #2563eb;
        background: rgba(37, 99, 235, 0.08);
        color: #f1f5f9;
      }
      .callout-target {
        background: rgba(14, 165, 233, 0.08);
        border: 1px solid rgba(14, 165, 233, 0.3);
        padding: 0.75rem 1rem;
        border-radius: 6px;
      }
      .target-box { display: flex; align-items: center; gap: 0.5rem; margin-top: 0.2rem; }
      .target-box code {
        background: #0f172a;
        color: #38bdf8;
        padding: 0.2rem 0.4rem;
        border-radius: 4px;
        font-size: 0.85rem;
      }
      .target-box strong { font-size: 0.9rem; color: #f8fafc; }

      .review-result-box {
        background: rgba(16, 185, 129, 0.08);
        border: 1px solid rgba(16, 185, 129, 0.3);
        padding: 0.85rem 1rem;
        border-radius: 6px;
      }
      .review-status-bar {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin: 0.3rem 0;
      }
      .reviewer-tag { font-size: 0.8rem; color: #94a3b8; }
      .review-notes-text { font-size: 0.88rem; color: #e2e8f0; font-style: italic; }

      .modal-foot {
        background: #111827;
        padding: 0.85rem 1.25rem;
        border-top: 1px solid var(--border-color);
        display: flex;
        justify-content: flex-end;
        gap: 0.6rem;
      }

      /* FORM REVIEW DECISION */
      .review-summary-banner {
        background: #0f172a;
        border: 1px solid var(--border-color);
        border-left: 4px solid var(--accent);
        padding: 0.75rem 1rem;
        border-radius: 6px;
      }
      .decision-radios {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        margin-top: 0.4rem;
      }
      .radio-card {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        background: #0f172a;
        border: 1px solid var(--border-color);
        padding: 0.75rem 1rem;
        border-radius: 6px;
        cursor: pointer;
        transition: border-color 0.15s, background 0.15s;
      }
      .radio-card:hover {
        border-color: #64748b;
      }
      .radio-card input {
        margin-top: 0.2rem;
        cursor: pointer;
      }
      .radio-body { display: flex; flex-direction: column; gap: 0.2rem; }
      .radio-title { font-size: 0.9rem; font-weight: 700; color: #f8fafc; }
      .radio-sub { font-size: 0.8rem; color: #94a3b8; }

      .form-group { display: flex; flex-direction: column; gap: 0.4rem; }
      .form-label { font-size: 0.85rem; font-weight: 600; color: #e2e8f0; }
      .form-label.required::after { content: ' *'; color: #f87171; }
      .form-control {
        width: 100%;
        background: #0f172a;
        border: 1px solid var(--border-color);
        color: #f8fafc;
        padding: 0.6rem 0.75rem;
        border-radius: 6px;
        font-size: 0.88rem;
        font-family: inherit;
      }
      .form-control:focus { outline: none; border-color: var(--primary); }
      .form-help { font-size: 0.78rem; color: #94a3b8; }

      .checkbox-box {
        background: rgba(59, 130, 246, 0.08);
        border: 1px solid rgba(59, 130, 246, 0.25);
        padding: 0.65rem 0.85rem;
        border-radius: 6px;
      }
      .checkbox-label {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-size: 0.85rem;
        color: #e2e8f0;
        cursor: pointer;
      }
      .checkbox-label input { cursor: pointer; }

      /* ACCESSIBILITY & UTILITIES */
      .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      @media (max-width: 768px) {
        .detail-grid-2 { grid-template-columns: 1fr; }
        .filter-bar { flex-direction: column; align-items: stretch; }
        .search-group { min-width: 100%; }
        .filter-group { justify-content: space-between; }
      }
    </style>
  </body>
</html>
