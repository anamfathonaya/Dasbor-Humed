---
import HumasLayout from '../../layouts/HumasLayout.astro';
import { mockProposals, type DocumentProposal } from '../../lib/clientDataFetcher';

const totalProposals = mockProposals.length;
const pendingCount = mockProposals.filter(p => p.status === 'menunggu_tinjauan').length;
const approvedCount = mockProposals.filter(p => p.status === 'disetujui').length;
const needsRevisionCount = mockProposals.filter(p => p.status === 'perlu_revisi').length;
---

<HumasLayout
  title="Status Usulan Dokumen & SOP — Humas Internal Peduli Negeri"
  pageTitle="Status Usulan & Panel Tinjauan Dokumen SOP"
  pageSubtitle="Pelacakan siklus hidup usulan dokumen baru dan revisi SOP: verifikasi staf hingga persetujuan Kepala Bidang"
  currentPath="/basis-pengetahuan"
  pageContentId="basis-pengetahuan"
>
  <main class="kb" data-node-id="usulan.main">
    <!-- Top Bar -->
    <div class="kb__bar">
      <p class="kb__bar-text">
        <b>Panel Tinjauan Usulan:</b> {totalProposals} Usulan terdaftar, {pendingCount} menunggu kurasi Dewan Redaksi.
      </p>
      <div class="kb__bar-actions">
        <a href="/basis-pengetahuan" class="kb__btn">
          <iconify-icon icon="lucide:arrow-left" aria-hidden="true"></iconify-icon>Katalog Basis Pengetahuan
        </a>
        <a href="/sop" class="kb__btn">
          <iconify-icon icon="lucide:workflow" aria-hidden="true"></iconify-icon>Papan Visual SOP
        </a>
      </div>
    </div>

    <!-- 4 KPI Cards -->
    <div class="kb__kpis">
      <div class="kb__kpi-card">
        <div class="kb__kpi-head"><span>Total Usulan</span><span class="kb__badge kb__badge--blue">Semua</span></div>
        <div class="kb__kpi-val">{totalProposals} <span style="font-size:13px;font-weight:500;color:var(--color-muted,#5a6875)">berkas</span></div>
      </div>
      <div class="kb__kpi-card">
        <div class="kb__kpi-head"><span>Menunggu Tinjauan</span><span class="kb__badge kb__badge--amber">Antrean</span></div>
        <div class="kb__kpi-val">{pendingCount} <span style="font-size:13px;font-weight:500;color:var(--color-muted,#5a6875)">usulan</span></div>
      </div>
      <div class="kb__kpi-card">
        <div class="kb__kpi-head"><span>Telah Disetujui</span><span class="kb__badge kb__badge--green">Resmi</span></div>
        <div class="kb__kpi-val">{approvedCount} <span style="font-size:13px;font-weight:500;color:var(--color-muted,#5a6875)">SK Terbit</span></div>
      </div>
      <div class="kb__kpi-card">
        <div class="kb__kpi-head"><span>Perlu Revisi</span><span class="kb__badge kb__badge--amber">Catatan</span></div>
        <div class="kb__kpi-val">{needsRevisionCount} <span style="font-size:13px;font-weight:500;color:var(--color-muted,#5a6875)">perbaikan</span></div>
      </div>
    </div>

    <!-- Tabel Daftar Usulan -->
    <section class="kb__card">
      <div class="kb__card-head">
        <div>
          <h2 class="kb__card-title">Daftar Usulan Dokumen & Status Verifikasi</h2>
          <p class="kb__card-sub">Diproses sesuai matriks otorisasi pimpinan dan komite SOP</p>
        </div>
      </div>

      <div class="kb__docs">
        {mockProposals.map((item) => (
          <article class="kb__doc-item">
            <div class="kb__doc-head">
              <div style="display:flex;align-items:center;gap:8px;">
                <span class="kb__doc-code">{item.id}</span>
                <span class={`kb__badge ${item.status === 'disetujui' ? 'kb__badge--green' : 'kb__badge--amber'}`}>
                  {item.status.replace('_', ' ').toUpperCase()}
                </span>
              </div>
              <span class="kb__badge kb__badge--blue">{item.submittedAt}</span>
            </div>
            <h3 class="kb__doc-title">{item.title}</h3>
            <p class="kb__doc-desc">{item.notes}</p>
            <div class="kb__doc-meta">
              <span><iconify-icon icon="lucide:user" aria-hidden="true"></iconify-icon> Pengusul: {item.submittedBy}</span>
              <span><iconify-icon icon="lucide:tag" aria-hidden="true"></iconify-icon> Kategori: {item.category}</span>
              <span><iconify-icon icon="lucide:alert-circle" aria-hidden="true"></iconify-icon> Urgensi: {item.urgency}</span>
            </div>
            <div class="kb__doc-actions">
              <button class="kb__btn" type="button" onclick={`alert('Membuka rincian naskah draf usulan ${item.id}')`}>
                <iconify-icon icon="lucide:file-text" aria-hidden="true"></iconify-icon>Lihat Naskah Draf
              </button>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
</HumasLayout>
