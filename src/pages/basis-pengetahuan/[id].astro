---
import HumasLayout from '../../layouts/HumasLayout.astro';
import { mockKnowledgeDocs } from '../../lib/clientDataFetcher';

const { id } = Astro.params;
const doc = mockKnowledgeDocs.find(d => d.id === Number(id) || d.code.toLowerCase() === (id || '').toLowerCase());

if (!doc) {
  return Astro.redirect('/basis-pengetahuan');
}

const steps = doc.steps || [
  {
    stepNumber: 1,
    phase: 'Tahap Persiapan & Pengajuan',
    title: 'Verifikasi Kebutuhan & Surat Tugas',
    actor: 'Staf Pemohon / Pelaksana',
    action: 'Menyiapkan berkas acuan awal dan mengajukan persetujuan ke koordinator bidang.',
    output: 'Formulir tugas terverifikasi',
    slaTime: '1x24 jam sebelum pelaksanaan'
  },
  {
    stepNumber: 2,
    phase: 'Tahap Pelaksanaan Inti',
    title: 'Penerapan Standar Operasional di Lapangan',
    actor: 'Tim Pelaksana Teknis',
    action: 'Melaksanakan tugas sesuai panduan keselamatan, etika kemanusiaan, dan arahan koordinator.',
    output: 'Materi / hasil kegiatan terdokumentasi',
    slaTime: 'Sesuai durasi jadwal penugasan'
  },
  {
    stepNumber: 3,
    phase: 'Tahap Penutupan & Laporan',
    title: 'Pelaporan Hasil & Arsip Data',
    actor: 'Koordinator Bidang & Staf Administrasi',
    action: 'Menyerahkan berita acara penyelesaian dan mengarsipkan seluruh file materi ke repositori internal.',
    output: 'Laporan tuntas & arsip digital',
    slaTime: 'Maksimal 2 hari kerja pasca kegiatan'
  }
];
---

<HumasLayout
  title={`${doc.code} — ${doc.title}`}
  pageTitle={doc.title}
  pageSubtitle={`Dokumen resmi ${doc.category} · Versi ${doc.version} · Disusun oleh ${doc.author}`}
  currentPath="/basis-pengetahuan"
  pageContentId="basis-pengetahuan"
>
  <main class="kb" data-node-id="doc-detail.main">
    <!-- Top Bar -->
    <div class="kb__bar">
      <p class="kb__bar-text">
        <b>Kode Dokumen: {doc.code}</b> ({doc.version}) • Status: Terverifikasi & Aktif.
      </p>
      <div class="kb__bar-actions">
        <a href="/basis-pengetahuan" class="kb__btn">
          <iconify-icon icon="lucide:arrow-left" aria-hidden="true"></iconify-icon>Katalog Basis Pengetahuan
        </a>
        <button class="kb__btn kb__btn--primary" type="button" onclick="window.print()">
          <iconify-icon icon="lucide:printer" aria-hidden="true"></iconify-icon>Cetak / Unduh PDF
        </button>
      </div>
    </div>

    <!-- Ringkasan Dokumen -->
    <div class="kb__card" style="margin-bottom:20px;">
      <div class="kb__card-head">
        <div>
          <span class="kb__badge kb__badge--blue">{doc.category}</span>
          <h2 style="font-size:18px;margin:8px 0 4px;">{doc.title}</h2>
          <p class="kb__card-sub">{doc.description}</p>
        </div>
        <span class="kb__badge kb__badge--green">Akses: {doc.accessRole.toUpperCase()}</span>
      </div>

      <div style="display:flex;gap:16px;flex-wrap:wrap;font-size:12px;color:var(--color-muted,#5a6875);border-top:1px solid var(--color-border,#ebecee);padding-top:12px;margin-top:12px;">
        <span><iconify-icon icon="lucide:user" aria-hidden="true"></iconify-icon> Penyusun: <b>{doc.author}</b></span>
        <span><iconify-icon icon="lucide:clock" aria-hidden="true"></iconify-icon> Estimasi baca: <b>{doc.readTime || '6 menit'}</b></span>
        <span><iconify-icon icon="lucide:calendar" aria-hidden="true"></iconify-icon> Pembaruan: <b>{doc.updatedAt || 'Terbaru'}</b></span>
      </div>
    </div>

    <!-- Alur Langkah SOP -->
    <section class="kb__card">
      <div class="kb__card-head">
        <div>
          <h2 class="kb__card-title">Tahapan Alur Operasional (SOP Steps)</h2>
          <p class="kb__card-sub">Urutan langkah baku yang wajib dipatuhi pelaksana tugas</p>
        </div>
      </div>

      <div class="sop__timeline" style="margin-top:16px;">
        {steps.map((st) => (
          <div class="sop__step">
            <div class="sop__step-icon">{st.stepNumber}</div>
            <div class="sop__step-content">
              <div class="sop__step-title">
                <span>{st.phase}: {st.title}</span>
                <span class="sop__badge sop__badge--blue">{st.slaTime}</span>
              </div>
              <p class="sop__step-desc">{st.action}</p>
              <div class="sop__step-meta">
                <span><iconify-icon icon="lucide:user" aria-hidden="true"></iconify-icon> Pelaksana: {st.actor}</span>
                <span><iconify-icon icon="lucide:check-circle" aria-hidden="true"></iconify-icon> Output: {st.output}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>
</HumasLayout>
