---
import HumasLayout from '../layouts/HumasLayout.astro';

interface DamFolderShare {
  id: string;
  name: string;
  smbPath: string;
  description: string;
  totalAssets: number;
  totalSize: string;
  allowedRoles: string[];
  lastIndexed: string;
}

const damShares: DamFolderShare[] = [
  {
    id: 'share-1',
    name: 'Dokumentasi Foto Resolusi Tinggi',
    smbPath: 'smb://192.168.1.200/dam-humas/foto-hi-res',
    description: 'Arsip berkas foto mentah (RAW/JPG) kegiatan penyaluran bantuan pangan, kesehatan, dan bencana.',
    totalAssets: 9420,
    totalSize: '482.5 GB',
    allowedRoles: ['head', 'admin', 'staff'],
    lastIndexed: 'Hari ini, 20:30 WIB'
  },
  {
    id: 'share-2',
    name: 'Video Mentah B-Roll & Footage 4K',
    smbPath: 'smb://192.168.1.200/dam-humas/video-footage',
    description: 'Koleksi klip video drone, wawancara penyintas, dan cuplikan b-roll untuk kebutuhan reel serta teaser.',
    totalAssets: 1240,
    totalSize: '1.42 TB',
    allowedRoles: ['head', 'admin', 'staff'],
    lastIndexed: 'Kemarin, 18:15 WIB'
  },
  {
    id: 'share-3',
    name: 'Aset Desain & Grafis Master (PSD/AI/SVG)',
    smbPath: 'smb://192.168.1.200/dam-humas/master-grafis',
    description: 'Master template grafis, logo lembaga, elemen infografis, dan aset kit kampanye kemanusiaan.',
    totalAssets: 3450,
    totalSize: '95.8 GB',
    allowedRoles: ['head', 'admin', 'staff'],
    lastIndexed: 'Hari ini, 14:00 WIB'
  },
  {
    id: 'share-4',
    name: 'Arsip Rekaman Konferensi Pers & Siaran Radio',
    smbPath: 'smb://192.168.1.200/dam-humas/audio-arsip',
    description: 'Rekaman audio wawancara radio, audio siaran darurat bencana, dan podcast lembaga.',
    totalAssets: 480,
    totalSize: '24.1 GB',
    allowedRoles: ['head', 'admin'],
    lastIndexed: '3 hari yang lalu'
  }
];
---

<HumasLayout
  title="Koneksi DAM NAS Synology — Humas Internal Peduli Negeri"
  pageTitle="Pengaturan DAM NAS Lokal"
  pageSubtitle="Konfigurasi server SMB/NFS Synology, pemetaan folder arsip foto resolusi tinggi dan master video"
  currentPath="/pengaturan-dam"
  pageContentId="pengaturan"
>
  <main class="cfg" data-node-id="dam.main">
    <!-- Sub Navigasi Pengaturan & Detail -->
    <div style="display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap;">
      <a href="/pengaturan" class="cfg__btn">
        <iconify-icon icon="lucide:plug-zap" aria-hidden="true"></iconify-icon>Pusat Pengaturan
      </a>
      <a href="/pengaturan-dam" class="cfg__btn" style="background:var(--color-primary,#1d5c94);color:#fff;font-weight:600;">
        <iconify-icon icon="lucide:hard-drive" aria-hidden="true"></iconify-icon>Koneksi DAM NAS
      </a>
      <a href="/integrasi-google" class="cfg__btn">
        <iconify-icon icon="logos:google-icon" aria-hidden="true"></iconify-icon>Akun Google (SSO & AI Pro)
      </a>
      <a href="/manajemen-akun" class="cfg__btn">
        <iconify-icon icon="lucide:users" aria-hidden="true"></iconify-icon>Akun & Hak Akses
      </a>
      <a href="/jejak-audit" class="cfg__btn">
        <iconify-icon icon="lucide:shield-check" aria-hidden="true"></iconify-icon>Jejak Audit
      </a>
    </div>

    <!-- Top Bar -->
    <div class="cfg__bar">
      <p class="cfg__bar-text">
        <b>Server NAS Synology (192.168.1.200):</b> Terhubung normal, 4 folder share aktif terindeks, 14.590 total aset media.
      </p>
      <div class="cfg__bar-actions">
        <a href="/pengaturan" class="cfg__btn">
          <iconify-icon icon="lucide:arrow-left" aria-hidden="true"></iconify-icon>Kembali ke Pengaturan
        </a>
        <button class="cfg__btn cfg__btn--primary" type="button" id="btn-rescan-nas">
          <iconify-icon icon="lucide:refresh-cw" aria-hidden="true"></iconify-icon>Pindai Ulang Folder Share
        </button>
      </div>
    </div>

    <!-- Konfigurasi Server NAS -->
    <div class="cfg__card" style="margin-bottom:20px;">
      <div class="cfg__card-head">
        <div>
          <h2 class="cfg__card-title">Parameter Koneksi Server NAS</h2>
          <p class="cfg__card-sub">SMB v3 File Sharing di Jaringan Kantor Pusat</p>
        </div>
        <span class="cfg__badge cfg__badge--green">Online (Latensi: 2ms)</span>
      </div>

      <form class="cfg__form-grid" id="form-nas-config">
        <div class="cfg__field">
          <label style="display:block;margin-bottom:4px;font-size:12px;font-weight:600;">Host / Alamat IP NAS</label>
          <input type="text" class="kb__select" style="width:100%;" value="192.168.1.200" required />
        </div>
        <div class="cfg__field">
          <label style="display:block;margin-bottom:4px;font-size:12px;font-weight:600;">Protokol Jaringan Berkas</label>
          <select class="kb__select" style="width:100%;">
            <option value="smb3" selected>SMB v3 (Windows File Sharing - Disarankan)</option>
            <option value="nfs">NFS v4.1 (Linux High Performance)</option>
            <option value="webdav">WebDAV over HTTPS (Port 5006)</option>
          </select>
        </div>
        <div class="cfg__field">
          <label style="display:block;margin-bottom:4px;font-size:12px;font-weight:600;">Akun Layanan (Service Account)</label>
          <input type="text" class="kb__select" style="width:100%;" value="dam-agent-srv" required />
        </div>
        <div class="cfg__field">
          <label style="display:block;margin-bottom:4px;font-size:12px;font-weight:600;">Kata Sandi Akun Layanan</label>
          <input type="password" class="kb__select" style="width:100%;" value="••••••••••••••••" required />
        </div>
        <div style="grid-column: 1 / -1; display:flex; justify-content:flex-end; gap:8px;">
          <button type="button" class="cfg__btn" id="btn-test-nas">Uji Ping SMB</button>
          <button type="submit" class="cfg__btn cfg__btn--primary">Simpan Parameter NAS</button>
        </div>
      </form>
    </div>

    <!-- Daftar Folder Share Terpetakan -->
    <section class="cfg__card">
      <div class="cfg__card-head">
        <div>
          <h2 class="cfg__card-title">Daftar Folder Share yang Dipantau</h2>
          <p class="cfg__card-sub">Folder arsip penyimpanan yang diindeks otomatis oleh sistem</p>
        </div>
      </div>

      <div class="cfg__grid">
        {damShares.map(share => (
          <article class="cfg__service">
            <div class="cfg__service-head">
              <h3 class="cfg__service-title">
                <iconify-icon icon="lucide:folder" style="color:var(--color-primary,#1d5c94);font-size:18px;" aria-hidden="true"></iconify-icon>
                {share.name}
              </h3>
              <span class="cfg__badge cfg__badge--blue">{share.totalSize}</span>
            </div>
            <div class="cfg__service-meta">
              <span>{share.description}</span>
              <div>Path: <code>{share.smbPath}</code></div>
              <div style="color:var(--color-muted,#7a8794);font-size:11px;">
                {share.totalAssets.toLocaleString('id-ID')} berkas terindeks • {share.lastIndexed}
              </div>
            </div>
            <div class="cfg__service-actions">
              <button class="cfg__btn" type="button" onclick={`alert('Memindai folder ${share.name}...')`}>
                <iconify-icon icon="lucide:refresh-cw" aria-hidden="true"></iconify-icon>Pindai Folder
              </button>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      document.getElementById('btn-test-nas')?.addEventListener('click', () => {
        alert('Uji koneksi ke 192.168.1.200 port SMB 445: Berhasil (Latensi 2ms).');
      });

      document.getElementById('btn-rescan-nas')?.addEventListener('click', () => {
        alert('Memulai pemindaian ulang latar belakang untuk seluruh share NAS Synology.');
      });

      document.getElementById('form-nas-config')?.addEventListener('submit', (e) => {
        e.preventDefault();
        alert('Parameter koneksi NAS Synology berhasil diperbarui.');
      });
    });
  </script>
</HumasLayout>
