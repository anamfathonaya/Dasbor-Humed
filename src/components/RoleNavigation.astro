---
interface Props {
  currentPath?: string;
  activeRole?: 'head' | 'admin' | 'staff';
}

const { currentPath = '', activeRole = 'head' } = Astro.props;

interface MenuItem {
  title: string;
  href: string;
  icon: string;
  badge?: string;
  roles: Array<'head' | 'admin' | 'staff'>;
  description: string;
}

const menuItems: MenuItem[] = [
  {
    title: 'Dasbor Metrik',
    href: '/dasbor-metrik',
    icon: '📊',
    roles: ['head', 'admin', 'staff'],
    description: 'Ringkasan metrik sosmed, web & iklan'
  },
  {
    title: 'Kalender Konten',
    href: '/kalender-konten',
    icon: '📅',
    roles: ['head', 'admin', 'staff'],
    description: 'Jadwal tayang & pengingat berkala'
  },
  {
    title: 'Papan Proyek',
    href: '/papan-proyek',
    icon: '📋',
    roles: ['head', 'admin', 'staff'],
    description: 'Kanban & timeline peliputan'
  },
  {
    title: 'Pantauan Berita',
    href: '/pantauan-berita',
    icon: '📰',
    roles: ['head', 'admin', 'staff'],
    description: 'RSS, Google News & Telegram rujukan'
  },
  {
    title: 'Insight Konten',
    href: '/insight-konten',
    icon: '💡',
    roles: ['head', 'admin', 'staff'],
    description: 'Analisis gap topik & rekomendasi ide'
  },
  {
    title: 'Laporan & Anggaran',
    href: '/laporan-anggaran',
    icon: '💰',
    roles: ['head', 'admin'],
    description: 'RAB, LRA & laporan kinerja'
  },
  {
    title: 'Basis Pengetahuan & SOP',
    href: '/basis-pengetahuan',
    icon: '📚',
    roles: ['head', 'admin', 'staff'],
    description: 'Repositori SOP, panduan krisis & alur'
  },
  {
    title: 'Pengaturan & Integrasi',
    href: '/pengaturan',
    icon: '⚙️',
    roles: ['head', 'admin'],
    description: 'DAM NAS, Workspace & matriks otorisasi'
  }
];
---

<header class="role-nav-header">
  <div class="nav-brand">
    <a href="/dasbor-metrik" class="brand-link">
      <span class="brand-icon">🌐</span>
      <div class="brand-info">
        <h1>Dasbor Humas Media</h1>
        <span class="brand-org">Yayasan Kemanusiaan Peduli Negeri</span>
      </div>
    </a>
  </div>

  <nav class="nav-links" id="role-nav-container">
    {menuItems.map((item) => (
      <a
        href={item.href}
        class={`nav-item ${currentPath.startsWith(item.href) ? 'active' : ''}`}
        data-roles={JSON.stringify(item.roles)}
        title={item.description}
      >
        <span class="nav-icon">{item.icon}</span>
        <span class="nav-title">{item.title}</span>
        {item.badge && <span class="nav-badge">{item.badge}</span>}
      </a>
    ))}
  </nav>

  <div class="nav-user-controls">
    <div class="role-selector-wrap">
      <label for="global-role-switcher" class="role-label">Peran:</label>
      <select id="global-role-switcher" name="user-role" class="role-select">
        <option value="head">Ketua Bidang</option>
        <option value="admin">Admin Teknis</option>
        <option value="staff">Staf Konten</option>
      </select>
    </div>

    <div class="user-profile-menu">
      <a href="/profil-akun" class="avatar-link" id="global-avatar-badge" title="Profil Akun & Sandi">
        <span class="avatar-text">RM</span>
      </a>
    </div>
  </div>
</header>

<style>
  .role-nav-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1.75rem;
    background: #0f172a;
    color: #ffffff;
    flex-wrap: wrap;
    gap: 1rem;
    border-bottom: 1px solid #1e293b;
  }

  .nav-brand .brand-link {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: inherit;
  }
  .brand-icon { font-size: 1.4rem; }
  .brand-info h1 {
    font-size: 1.05rem;
    margin: 0;
    color: #f8fafc;
    font-weight: 700;
  }
  .brand-org {
    display: block;
    font-size: 0.72rem;
    color: #94a3b8;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .nav-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.65rem;
    border-radius: 6px;
    font-size: 0.86rem;
    color: #94a3b8;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .nav-item:hover {
    color: #ffffff;
    background: #1e293b;
  }
  .nav-item.active {
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.1);
    font-weight: 600;
  }
  .nav-icon { font-size: 0.95rem; }

  .nav-badge {
    background: #0284c7;
    color: #ffffff;
    font-size: 0.65rem;
    padding: 0.1rem 0.35rem;
    border-radius: 999px;
    font-weight: 700;
  }

  .nav-user-controls {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .role-selector-wrap {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .role-label {
    font-size: 0.78rem;
    color: #94a3b8;
  }
  .role-select {
    font: inherit;
    font-size: 0.8rem;
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
    border: 1px solid #334155;
    background: #1e293b;
    color: #f8fafc;
    cursor: pointer;
  }
  .role-select:focus {
    outline: none;
    border-color: #38bdf8;
  }

  .avatar-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #0284c7;
    color: #ffffff;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.78rem;
    border: 2px solid #38bdf8;
    transition: transform 0.15s;
  }
  .avatar-link:hover {
    transform: scale(1.05);
  }

  @media (max-width: 1024px) {
    .role-nav-header { padding: 0.75rem 1rem; }
    .nav-links { gap: 0.35rem; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const roleSwitcher = document.getElementById('global-role-switcher') as HTMLSelectElement | null;
    const navItems = document.querySelectorAll<HTMLAnchorElement>('.nav-item');
    const avatarBadge = document.getElementById('global-avatar-badge');

    function applyRoleVisibility(role: string) {
      navItems.forEach((item) => {
        const rolesAttr = item.getAttribute('data-roles');
        if (rolesAttr) {
          try {
            const allowedRoles: string[] = JSON.parse(rolesAttr);
            if (allowedRoles.includes(role)) {
              item.style.display = 'inline-flex';
            } else {
              item.style.display = 'none';
            }
          } catch {}
        }
      });

      // Update avatar text
      if (avatarBadge) {
        const avatarSpan = avatarBadge.querySelector('.avatar-text');
        if (avatarSpan) {
          avatarSpan.textContent = role === 'head' ? 'RM' : role === 'admin' ? 'BS' : 'DL';
        }
      }
    }

    // Ambil peran aktif dari localStorage
    let currentRole = 'head';
    try {
      currentRole = localStorage.getItem('user_role') || 'head';
    } catch {}

    if (roleSwitcher) {
      roleSwitcher.value = currentRole;
    }
    applyRoleVisibility(currentRole);

    function onRoleChanged(newRole: string) {
      try {
        localStorage.setItem('user_role', newRole);
        document.cookie = `user_role=${newRole}; path=/; max-age=2592000`;
      } catch {}
      if (roleSwitcher && roleSwitcher.value !== newRole) {
        roleSwitcher.value = newRole;
      }
      applyRoleVisibility(newRole);
      window.dispatchEvent(new CustomEvent('roleChanged', { detail: { role: newRole } }));
      
      // Sinkronkan ke elemen legacy jika ada
      const legacyRole = document.getElementById('user-role') as HTMLSelectElement | null;
      if (legacyRole && legacyRole !== roleSwitcher && legacyRole.value !== newRole) {
        legacyRole.value = newRole;
        legacyRole.dispatchEvent(new Event('change'));
      }
    }

    roleSwitcher?.addEventListener('change', () => {
      onRoleChanged(roleSwitcher.value);
    });

    const legacySelect = document.getElementById('user-role') as HTMLSelectElement | null;
    if (legacySelect && legacySelect !== roleSwitcher) {
      legacySelect.value = currentRole;
      legacySelect.addEventListener('change', () => {
        onRoleChanged(legacySelect.value);
      });
    }
  });
</script>
